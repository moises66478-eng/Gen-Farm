function Farm.detectRoundActiveNow()
    local team = player.Team
    if not team or team.Name ~= "Survivors" then return false end
    local char = player.Character
    if not char then return false end
    local hum = char:FindFirstChild("Humanoid")
    return hum ~= nil and hum.Health > 0
end

function Farm.syncRoundActive()
    if not roundSetByRemote then
        if Farm.detectRoundActiveNow() then roundActive = true end
    end
end

function Farm.isInLiveRound()
    Farm.syncRoundActive()
    if not roundActive then return false end
    local survivors = Teams:FindFirstChild("Survivors")
    if not survivors then return false end
    local onTeam = false
    for _, p in ipairs(survivors:GetPlayers()) do
        if p == player then onTeam = true break end
    end
    if not onTeam then return false end
    local char = player.Character
    if not char then return false end
    local hum = char:FindFirstChild("Humanoid")
    return hum ~= nil and hum.Health > 0
end

function Farm.getGenerators()
    local Map = workspace:FindFirstChild("Map")
    if not Map then return nil end
    local results, seen = {}, {}
    for _, desc in ipairs(Map:GetDescendants()) do
        if desc:IsA("Model") and desc.Name == "Generator" and not seen[desc] then
            seen[desc] = true
            table.insert(results, desc)
        end
    end
    return #results > 0 and results or nil
end

function Farm.getGenProgress(model)
    if not model or not model.Parent then return nil end
    local ok2, v = pcall(function() return model:GetAttribute("RepairProgress") end)
    if ok2 and type(v) == "number" then return v end
    return nil
end

function Farm.isGenDone(model)
    if not model or not model.Parent then return true end
    local hasPoints = false
    for _, child in ipairs(model:GetChildren()) do
        if child:IsA("BasePart") and child.Name:find("GeneratorPoint") then
            hasPoints = true break
        end
    end
    if not hasPoints then return true end
    local v = Farm.getGenProgress(model)
    if type(v) == "number" then return v >= 100 end
    return false
end

function Farm.isGenPaused(model)
    if not model or not model.Parent then return false end
    local ok2, v = pcall(function() return model:GetAttribute("ProgressPaused") end)
    return ok2 and v == true
end

function Farm.isGenRegressing(model)
    if not model or not model.Parent then return false end
    local ok2, v = pcall(function() return model:GetAttribute("Regressing") end)
    return ok2 and v == true
end

function Farm.isPointRepairing(point)
    local ok2, v = pcall(function() return point:GetAttribute("IsRepairing") end)
    return ok2 and v == true
end

function Farm.getBestPoint(model)
    if not model or not model.Parent then return nil end
    for _, child in ipairs(model:GetChildren()) do
        if child:IsA("BasePart") and child.Name:find("GeneratorPoint") then
            if not Farm.isPointRepairing(child) then return child end
        end
    end
    return nil
end

function Farm.isModelOccupied(model)
    if not model or not model.Parent then return false end
    local hasAny = false
    for _, child in ipairs(model:GetChildren()) do
        if child:IsA("BasePart") and child.Name:find("GeneratorPoint") then
            hasAny = true
            if not Farm.isPointRepairing(child) then return false end
        end
    end
    return hasAny
end

function Farm.countDone(genModels)
    local done = 0
    for _, m in ipairs(genModels) do
        if Farm.isGenDone(m) then done += 1 end
    end
    return done
end

