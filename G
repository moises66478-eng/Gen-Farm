local function stealthWait(model, mapName, forcePermanent)
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum  = char and char:FindFirstChild("Humanoid")

    local ok2, pivot = pcall(function() return model:GetPivot() end)
    local genPos = ok2 and pivot.Position or (root and root.Position) or Vector3.new(0,0,0)

    if stealthHitCount >= 2 or forcePermanent then
        updateStatus("Stealth — permanent caution...")
        local kr = getKillerRoot()
        local killerPos = kr and kr.Position or genPos
        if root then
            local away = (genPos - killerPos)
            away = away.Magnitude > 0.1 and away.Unit or Vector3.new(1, 0, 0)
            root.CFrame = CFrame.new(genPos + away * 18 + Vector3.new(0, 6, 0))
        end
        if hum then hum.WalkSpeed = 0 hum.JumpHeight = 0 end
        while farming and not escaping do
            if not isInLiveRound() then
                if hum then hum.WalkSpeed = 16 hum.JumpHeight = 7.2 end
                return false
            end
            if getPlayerHealth() < 10 then
                if hum then hum.WalkSpeed = 16 hum.JumpHeight = 7.2 end
                doEscape(mapName, "low health")
                return false
            end
            if killerDistance() >= 15 then break end
            task.wait(0.3)
        end
        if hum then hum.WalkSpeed = 16 hum.JumpHeight = 7.2 end
        return true
    else
        updateStatus("Stealth — repositioning...")
        local kr = getKillerRoot()
        local killerPos = kr and kr.Position or genPos
        if root then
            local toGen = (genPos - killerPos)
            local lateral
            if toGen.Magnitude > 0.1 then
                lateral = Vector3.new(-toGen.Z, 0, toGen.X).Unit
            else
                lateral = Vector3.new(1, 0, 0)
            end
            root.CFrame = CFrame.new(genPos + lateral * 12 + Vector3.new(0, 6, 0))
        end
        if hum then hum.WalkSpeed = 0 hum.JumpHeight = 0 end
        while farming and not escaping do
            if not isInLiveRound() then
                if hum then hum.WalkSpeed = 16 hum.JumpHeight = 7.2 end
                return false
            end
            if getPlayerHealth() < 10 then
                if hum then hum.WalkSpeed = 16 hum.JumpHeight = 7.2 end
                doEscape(mapName, "low health")
                return false
            end
            if killerDistance() >= 15 then break end
            task.wait(0.3)
        end
        if hum then hum.WalkSpeed = 16 hum.JumpHeight = 7.2 end
        return true
    end
end

local function waitForRepairComplete(model, genIndex, genModels, timeout, mapName, lockedPoint)
    local point = lockedPoint
    local noProgFor, nilProgFor = 0, 0
    local lastProg = -1
    local elapsed  = 0
    local progressSeenFor = 0
    local everMoved, noMoveFor = false, 0
    local stealthCloseFor = 0
    local lastHealth = getPlayerHealth()

    -- Suggestion: lock joystick during repair so the player can't drift
    -- away from the generator point. Restored on every exit path below.
    local function lockMovement()
        local char = player.Character
        local hum  = char and char:FindFirstChild("Humanoid")
        if hum then hum.WalkSpeed = 0 hum.JumpHeight = 0 end
    end
    local function unlockMovement()
        local char = player.Character
        local hum  = char and char:FindFirstChild("Humanoid")
        if hum then hum.WalkSpeed = 16 hum.JumpHeight = 7.2 end
    end
    lockMovement()

    local function exitWith(result)
        unlockMovement()
        return result
    end

    local function retweenAndRetap()
        -- Repair stalled. Stay at the current point and retap to restart.
        -- Per user preference: restarting in place is better than tweening
        -- away — let the killer's proximity trigger generator switching.
        if not point or not point.Parent then return exitWith(false) end
        unlockMovement()
        task.wait(0.1)
        local iconVis = waitForRepairIcon(3)
        if not iconVis then
            lockMovement()
            return false
        end
        local tapped = tapRepairButton()
        lockMovement()
        return tapped
    end

    while elapsed < timeout do
        if not farming or escaping       then cancelCurrentRepair() return exitWith(false) end
        if not isInLiveRound()           then cancelCurrentRepair() return exitWith(false) end
        if countDone(genModels) >= GENS_REQUIRED then cancelCurrentRepair() return exitWith(false) end
        if isLastSurvivor()              then cancelCurrentRepair() return exitWith(false) end

        if getPlayerHealth() < 10 then
            cancelCurrentRepair()
            doEscape(mapName, "low health")
            return exitWith(false)
        end

        if killerDistanceSetting == 0 then
            local dist = killerDistance()
            local health = getPlayerHealth()
            local healthDrop = lastHealth - health
            lastHealth = health

            local shouldPause = false
            if healthDrop > 0 then shouldPause = true end
            if dist <= 15 and isGenRegressing(model) then shouldPause = true end
            if dist <= 15 then
                stealthCloseFor += 0.2
                if stealthCloseFor >= 6 then shouldPause = true end
            else
                stealthCloseFor = 0
            end

            if shouldPause then
                cancelCurrentRepair()
                if healthDrop > 0 then stealthHitCount += 1 end
                updateStatus("Stealth pause — waiting...")
                updateRepair(0)
                local resume = stealthWait(model, mapName, stealthHitCount >= 2)
                if not resume then return exitWith(false) end
                if escaping then return exitWith(false) end
                stealthCloseFor = 0
                lastHealth = getPlayerHealth()
                -- Retween to the LOCKED point (not getBestPoint which may drift)
                if not point or not point.Parent then return exitWith(false) end
                currentRepairTarget = point
                -- Tap action button to restart repair after stealth pause
                local iconVis = waitForRepairIcon(3)
                if not iconVis or not tapRepairButton() then return exitWith(false) end
                updateStatus("Waiting for gen " .. genIndex .. "...")
                everMoved = false noMoveFor = 0 noProgFor = 0
                progressSeenFor = 0 lastProg = -1
            end
        else
            if isKillerClose() then
                killerNearby = true
                -- Explicitly stop repair server-side before any movement
                cancelCurrentRepair()
                return exitWith(false)
            end
        end

        if not model.Parent then
            currentRepairTarget = nil
            updateRepair(100)
            return exitWith(true)
        end
        if isGenPaused(model) then
            cancelCurrentRepair()
            updateStatus("Gen " .. genIndex .. " paused, skipping")
            updateRepair(0)
            return exitWith(false)
        end

        local progress = getGenProgress(model)
        if type(progress) == "number" then
            nilProgFor = 0
            updateRepair(progress)
            if progress >= 100 then
                currentRepairTarget = nil
                updateRepair(100)
                return exitWith(true)
            end
            if progress > 0 then
                progressSeenFor += 0.2
                everMoved = true
                noMoveFor = 0
            else
                if not everMoved then
                    noMoveFor += 0.2
                    if noMoveFor >= 15 then
                        cancelCurrentRepair()
                        updateStatus("Gen " .. genIndex .. " not starting, retrying")
                        updateRepair(0)
                        return exitWith(false)
                    end
                end
            end
            local stallLimit = progress >= 95 and 30 or 15
            if progressSeenFor >= 5 then
                if math.abs(progress - lastProg) < 0.05 then
                    noProgFor += 0.2
                    if noProgFor >= stallLimit then
                        -- Progress stalled — tween back to point and retap
                        -- (handles joystick drift away from generator)
                        cancelCurrentRepair()
                        updateStatus("Gen " .. genIndex .. " stalled — returning")
                        updateRepair(0)
                        local restarted = retweenAndRetap()
                        if not restarted then return exitWith(false) end
                        if not farming or escaping then return exitWith(false) end
                        currentRepairTarget = point
                        noProgFor = 0 lastProg = -1
                        progressSeenFor = 0 everMoved = false noMoveFor = 0
                    end
                else
                    noProgFor = 0
                end
            end

            -- ★ BUG 1 FIX: detect regression (skill check failure) immediately
            if progressSeenFor >= 2 and progress < (lastProg - 0.1) then
                cancelCurrentRepair()
                updateStatus("Gen " .. genIndex .. " regressing — retapping")
                updateRepair(0)
                local restarted = retweenAndRetap()
                if not restarted then return exitWith(false) end
                if not farming or escaping then return exitWith(false) end
                currentRepairTarget = point
                noProgFor = 0 lastProg = -1 progressSeenFor = 0
                everMoved = false noMoveFor = 0
            end

            lastProg = progress  -- ★ moved to the end so the regression check compares against previous value
        else
            nilProgFor += 0.2
            if nilProgFor >= 15 then
                cancelCurrentRepair()
                updateStatus("Gen " .. genIndex .. " unreadable, retrying")
                updateRepair(0)
                return exitWith(false)
            end
        end
        task.wait(0.2)
        elapsed += 0.2
    end
    cancelCurrentRepair()
    return exitWith(false)
end

local function evadeAndWait(genModels, currentIdx, mapName)
    evading = true
    cancelCurrentRepair()

    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum  = char and char:FindFirstChild("Humanoid")
    if not root then evading = false return nil end

    local killerRoot = getKillerRoot()
    local killerPos  = killerRoot and killerRoot.Position

    local bestModel, bestIdx, bestDist = nil, nil, math.huge
    for idx, model in ipairs(genModels) do
        if idx == currentIdx then continue end
        if isGenDone(model) then continue end
        if not model or not model.Parent then continue end
        if isModelOccupied(model) then continue end
        local ok2, pivot = pcall(function() return model:GetPivot() end)
        if not ok2 then continue end
        local gp = pivot.Position
        local distToKiller = killerPos and (gp - killerPos).Magnitude or math.huge
        local distToMe     = (gp - root.Position).Magnitude
        if distToKiller >= 80 and distToMe < bestDist then
            bestDist = distToMe bestModel = model bestIdx = idx
        end
    end

    if not bestModel then
        updateStatus("All gens near killer, fleeing...")
        if killerPos then
            local away = (root.Position - killerPos)
            away = away.Magnitude > 0.1 and away.Unit or Vector3.new(1, 0, 0)
            local fleeCF = CFrame.new(root.Position + away * 80 + Vector3.new(0, 3, 0))
            if hum then hum.WalkSpeed = 0 hum.JumpHeight = 0 end
            local startCF = root.CFrame
            for step = 1, 60 do
                if not farming or escaping then break end
                root.CFrame = startCF:Lerp(fleeCF, step / 60)
                task.wait()
            end
            if hum then hum.WalkSpeed = 16 hum.JumpHeight = 7.2 end
        end
        while farming and not escaping do
            if not isInLiveRound() then break end
            if isLastSurvivor() and mapName then
                evading = false killerNearby = false
                updateRepair(0)
                doEscape(mapName, "last survivor")
                return nil
            end
            if killerDistance() > 80 then break end
            task.wait(0.3)
        end
        killerNearby = false evading = false updateRepair(0)
        return nil
    end

    updateStatus("Killer! Moving to safer gen " .. bestIdx .. "...")
    -- Use underground tween with proximity check
    local evadePoint = getBestPoint(bestModel)
    local evadeTargetCF = evadePoint and (evadePoint.CFrame + Vector3.new(0, 3, 0))
    if not evadeTargetCF then
        local ok2, pivot = pcall(function() return bestModel:GetPivot() end)
        if not ok2 then evading = false updateRepair(0) return nil end
        evadeTargetCF = CFrame.new(pivot.Position + Vector3.new(0, 3, 0))
    end
    local arrived = tweenToGenWithProximityCheck(evadeTargetCF)
    if not arrived then
        killerNearby = true evading = false updateRepair(0)
        return nil
    end

    if killerDistance() <= 80 then
        killerNearby = true evading = false updateRepair(0)
        return nil
    end
    killerNearby = false

    if escaping or not farming or not isInLiveRound() then evading = false return nil end
    if isLastSurvivor() then
        evading = false
        doEscape(mapName, "last survivor")
        return nil
    end
    if isGenDone(bestModel) or isModelOccupied(bestModel) then
        evading = false updateRepair(0) return nil
    end

    local point = evadePoint
    if not point then evading = false updateRepair(0) return nil end

    updateStatus("Repairing gen " .. bestIdx .. " (post-evade)...")
    currentRepairTarget = point

    -- Same approach as main loop: wait for repair icon, then tap button.
    local iconVisible = waitForRepairIcon(3)
    if not iconVisible or not tapRepairButton() then
        currentRepairTarget = nil evading = false updateRepair(0)
        return nil
    end

    -- Re-arm skill check watcher now that post-evade repair has started.
    if _skillCheckMode == "Perfect Skill Check" then
        startPerfectSkillCheck()
    end

    local finished = waitForRepairComplete(bestModel, bestIdx, genModels, 120, mapName, point)
    if finished then
        updateStatus("Gen " .. bestIdx .. " complete ✔")
        updateProgressDisplay(genModels)
    end
    evading = false
    return bestIdx
end

doEscape = function(mapName, reason)
    if not isInLiveRound() then return end
    if escaping then return end
    local pos = getEscapePos(mapName)
    if not pos then
        local freshMap = getMapName()
        if freshMap then pos = getEscapePos(freshMap) end
    end
    escaping = true
    cancelCurrentRepair()
    updateStatus("Escaping! (" .. reason .. ")")
    updateRepair(100)
    if pos then
        updateStatus("Tweening to gate...")
        goToPos(pos)
        updateStatus("Escaped! ✔")
    else
        updateStatus("No escape coords found")
    end
    farming = false farmRunning = false
end

-- ═══════════════════════════════════════════════════════════════════
-- MAIN FARM LOOP — modified to use underground tween and pre‑check killer
-- ═══════════════════════════════════════════════════════════════════

runFarm = function()
    if farmRunning then return end
    farmRunning = true

    escaping = false killerNearby = false evading = false
    tweening = false currentRepairTarget = nil stealthHitCount = 0

    while true do
        if not autoFarmEnabled then
            farming = false farmRunning = false return
        end
        syncRoundActive()
        if roundActive then
            if detectRoundActiveNow() then break end
            updateStatus("Round ongoing...")
        else
            updateStatus("Waiting for round...")
        end
        task.wait(1)
    end

    local waitNeeded = 15 - (os.clock() - roundStartTime)
    if waitNeeded > 0 then
        updateStatus("Loading map...")
        task.wait(waitNeeded)
    end

    if not autoFarmEnabled then farming = false farmRunning = false return end
    if not detectRoundActiveNow() then
        farmRunning = false
        if autoFarmEnabled then task.spawn(runFarm) end
        return
    end

    farming = true

    local mapName = getMapName()
    if not mapName then
        updateStatus("Couldn't read map!")
        farming = false farmRunning = false return
    end
    LabelMap:SetText("Map: " .. mapName)

    local genModels = getGenerators()
    if not genModels or #genModels == 0 then
        updateStatus("No generators found!")
        farming = false farmRunning = false return
    end

    updateRepair(0)
    updateProgressDisplay(genModels)

    local lastIndex = nil

    while farming and not escaping do
        if not isInLiveRound() then
            cancelCurrentRepair()
            updateStatus("Waiting for round...")
            break
        end

        local currentMap = getMapName()
        if currentMap and currentMap ~= mapName then
            mapName = currentMap
            LabelMap:SetText("Map: " .. mapName)
        end

        if isLastSurvivor() then doEscape(mapName, "last survivor") break end

        local done = countDone(genModels)
        if done >= GENS_REQUIRED then doEscape(mapName, "5 gens done") break end
        updateProgressDisplay(genModels)

        if killerDistanceSetting > 0 and (killerNearby or isKillerClose()) then
            killerNearby = true
            updateStatus("Killer nearby! Evading...")
            cancelCurrentRepair()
            local repairedIdx = evadeAndWait(genModels, lastIndex, mapName)
            if escaping then break end
            killerNearby = false
            if repairedIdx then lastIndex = repairedIdx end
            updateProgressDisplay(genModels)
            continue
        end

        local nextIdx = pickBestGenIndex(genModels, lastIndex,
            getOwnedPerkLevel("Perfectionist Planning") ~= nil)
        if not nextIdx then
            if countDone(genModels) >= GENS_REQUIRED then
                doEscape(mapName, "5 gens done") break
            end
            updateStatus("All gens occupied, waiting...")
            task.wait(2)
            continue
        end

        local i     = nextIdx
        local model = genModels[i]

        if isGenPaused(model) then
            updateStatus("Gen " .. i .. " paused, skipping")
            lastIndex = i task.wait(1) lastIndex = nil
            continue
        end

        updateStatus("Moving to gen " .. i)
        updateRepair(0)

        -- ★ NEW: get the repair point before tweening and use underground tween
        local point = getBestPoint(model)
        if not point then
            updateStatus("No point on gen " .. i .. ", skipping")
            lastIndex = i task.wait(0.3) lastIndex = nil
            continue
        end

        local targetCF = point.CFrame + Vector3.new(0, 3, 0)
        local arrived = tweenToGenWithProximityCheck(targetCF)

        if not arrived then
            -- killer was too close underground; let the top of the loop handle evasion
            killerNearby = killerDistanceSetting > 0 and isKillerClose()
            if killerNearby then
                updateStatus("Killer detected during tween, evading...")
                -- cancel any repair (though none should have started)
                cancelCurrentRepair()
                -- continue will trigger evadeAndWait at top
            else
                updateStatus("Tween aborted, retrying...")
            end
            lastIndex = i
            continue
        end

        if escaping or not farming then break end
        if not isInLiveRound() then cancelCurrentRepair() break end
        if isLastSurvivor() then doEscape(mapName, "last survivor") break end
        if isGenDone(model) then updateProgressDisplay(genModels) continue end
        if isModelOccupied(model) then
            updateStatus("Gen " .. i .. " taken, finding next...")
            task.wait(0.3) continue
        end

        -- ★ BUG 3 FIX: final killer proximity check BEFORE setting currentRepairTarget
        if killerDistanceSetting > 0 and isKillerClose() then
            killerNearby = true
            updateStatus("Killer too close after tween, evading...")
            continue
        end

        updateStatus("Repairing gen " .. i .. "...")
        currentRepairTarget = point
        lastIndex = i

        -- Wait for the repair icon to appear in the action button,
        -- then tap it so the game spawns the skill check prompt naturally.
        -- Direct FireServer would bypass the prompt entirely.
        local iconVisible = waitForRepairIcon(3)
        if not iconVisible then
            -- Icon never appeared — generator may be too far, point is wrong,
            -- or the UI is not loaded. Skip and retry next loop.
            updateStatus("Repair icon not found for gen " .. i .. ", retrying")
            currentRepairTarget = nil lastIndex = nil
            task.wait(0.5) continue
        end

        local tapped = tapRepairButton()
        if not tapped then
            updateStatus("Action button not found for gen " .. i .. ", skipping")
            currentRepairTarget = nil lastIndex = nil
            task.wait(1) continue
        end

        -- Re-arm skill check watcher now that repair has started.
        if _skillCheckMode == "Perfect Skill Check" then
            startPerfectSkillCheck()
        end

        updateStatus("Waiting for gen " .. i .. "...")
        local finished = waitForRepairComplete(model, i, genModels, 120, mapName, point)

        if escaping then break end
        if not isInLiveRound() then cancelCurrentRepair() break end
        if isLastSurvivor() then doEscape(mapName, "last survivor") break end
        if countDone(genModels) >= GENS_REQUIRED then doEscape(mapName, "5 gens done") break end

        updateProgressDisplay(genModels)

        if finished then
            updateStatus("Gen " .. i .. " complete ✔")
            lastIndex = nil task.wait(1)
        elseif killerNearby then
            updateStatus("Killer interrupted! Evading...")
            local repairedIdx = evadeAndWait(genModels, i, mapName)
            killerNearby = false
            if repairedIdx then lastIndex = repairedIdx end
            updateProgressDisplay(genModels)
        else
            lastIndex = nil task.wait(1)
        end
    end

    if not escaping and isInLiveRound() then
        local finalDone = countDone(genModels)
        if finalDone >= GENS_REQUIRED then
            doEscape(mapName, "all gens done")
        elseif isLastSurvivor() then
            doEscape(mapName, "last survivor")
        else
            updateStatus("Retrying...")
            task.wait(2)
            farmRunning = false
            if autoFarmEnabled then runFarm() end
            return
        end
    end

    farming = false farmRunning = false
    if autoFarmEnabled then task.spawn(runFarm) end
end

