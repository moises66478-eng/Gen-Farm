    if btnFontFace then pcall(function() btn.FontFace = btnFontFace end) end
    AddCorner(btn, 6)
    Library:AddToRegistry(btn, { BackgroundColor3 = "Tab", TextColor3 = "SubtextColor" })

    Make("UIPadding", { PaddingLeft = UDim.new(0, 12) }, btn)

    -- Single-column ScrollingFrame (Fluent exact)
    local containerLayout = Make("UIListLayout", {
        Padding   = UDim.new(0, 5),
        SortOrder = Enum.SortOrder.LayoutOrder,
    })

    local containerFrame = Make("ScrollingFrame", {
        Name                       = name .. "ContainerFrame",
        Size                       = UDim2.fromScale(1, 1),
        BackgroundTransparency     = 1,
        Visible                    = false,
        BottomImage                = "rbxassetid://6889812791",
        MidImage                   = "rbxassetid://6889812721",
        TopImage                   = "rbxassetid://6276641225",
        ScrollBarImageColor3       = Color3.fromRGB(255, 255, 255),
        ScrollBarImageTransparency = 0.95,
        ScrollBarThickness         = 3,
        BorderSizePixel            = 0,
        CanvasSize                 = UDim2.fromScale(0, 0),  -- Issue 23: no AutomaticCanvasSize
        ScrollingDirection         = Enum.ScrollingDirection.Y,
    }, containerHolder)
    containerLayout.Parent = containerFrame
    -- Issue 23: manual canvas size with guard and +2 offset (Fluent exact).
    -- Divide by DPIScale: AbsoluteContentSize is in screen pixels; CanvasSize
    -- offset must be in logical pixels or UIScale double-scales at non-100% DPI.
    containerLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        local scale   = math.max(Library.DPIScale or 1, 0.01)
        local logical = containerLayout.AbsoluteContentSize.Y / scale
        local newSize = UDim2.fromOffset(0, logical + 2)
        if containerFrame.CanvasSize ~= newSize then
            containerFrame.CanvasSize = newSize
        end
    end)
    Make("UIPadding", {
        PaddingRight  = UDim.new(0, 10),
        PaddingLeft   = UDim.new(0, 1),
        PaddingTop    = UDim.new(0, 1),
        PaddingBottom = UDim.new(0, 1),
    }, containerFrame)

    local tabObj = {
        Name           = name,
        Button         = btn,
        -- Legacy compat: Container points to containerFrame
        Container      = containerFrame,
        ContainerFrame = containerFrame,
        -- Single column: both Left/Right point to the same frame
        LeftCol        = containerFrame,
        RightCol       = containerFrame,
        _bar           = selectorBar,  -- shared global bar
    }
    table.insert(tabObjects, tabObj)

    -- Issue 10: Use per-theme HoverChange token for tab hover transparency.
    -- Fluent uses ElementTransparency as the selected/hover level (0.89 for Dark).
    btn.MouseEnter:Connect(function()
        if activeTab ~= tabObj then
            Tween(btn, {
                BackgroundTransparency = Library.Scheme.ElementTransparency,
            })
        end
    end)
    btn.MouseLeave:Connect(function()
        if activeTab ~= tabObj then
            Tween(btn, { BackgroundTransparency = 1 })
        end
    end)
    btn.MouseButton1Down:Connect(function()
        Tween(btn, {
            BackgroundTransparency = Library.Scheme.ElementTransparency
                + Library.Scheme.HoverChange,
        })
    end)
    btn.MouseButton1Up:Connect(function()
        if activeTab == tabObj then
            Tween(btn, {
                BackgroundTransparency = Library.Scheme.ElementTransparency,
            })
        end
    end)

    btn.Activated:Connect(function()
        setActiveTab(tabObj)
    end)

    -- AddLeftGroupbox / AddRightGroupbox both go to the single column
    function tabObj:AddLeftGroupbox(name2)
        return Library:_MakeSection(containerFrame, name2)
    end
    function tabObj:AddRightGroupbox(name2)
        return Library:_MakeSection(containerFrame, name2)
    end
    -- Fluent AddSection
    function tabObj:AddSection(name2)
        return Library:_MakeSection(containerFrame, name2)
    end

    if #tabObjects == 1 then setActiveTab(tabObj) end
    return tabObj
end

