        CanvasSize                 = UDim2.fromScale(0, 0),  -- Issue 23: no AutomaticCanvasSize
        ScrollingDirection         = Enum.ScrollingDirection.Y,
    }, containerHolder)
    containerLayout.Parent = containerFrame
    -- Issue 23: manual canvas size with guard and +2 offset (Fluent exact)
    containerLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        local newSize = UDim2.fromOffset(0, containerLayout.AbsoluteContentSize.Y + 2)
        if containerFrame.CanvasSize ~= newSize then
            containerFrame.CanvasSize = newSize
        end
    end)
    Make("UIPadding", {
        PaddingRight  = UDim.new(0, 10),
        PaddingLeft   = UDim.new(0, 1),
        PaddingTop    = UDim.new(0, 1),
        PaddingBottom = UDim.new(0, 1),
    }, containerFrame)

    local tabObj = {
