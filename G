    -- Content container: invisible, starts at y=24 (below heading+gap), UIListLayout pad=5
    local contentLayout = Make("UIListLayout", {
        Padding   = UDim.new(0, 5),
        SortOrder = Enum.SortOrder.LayoutOrder,
    })

    local content = Make("Frame", {
        Name                   = name .. "Content",
