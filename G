-- ── Activation + Heartbeat system ────────────────────────────────
--
-- ACTIVATION
-- When the player has a hosted server (_psServerVersion is set) and they
-- are inside their own private server, the script calls /activate to
-- confirm the real JobId and start player tracking.
--
-- Verification logic — all must pass before /activate is called:
--   1. player:GetAttribute("privateserverowner") == true
--      The game's server sets this attribute only on the private server
--      owner. It is reliable, always available client-side, and correctly
--      distinguishes the owner's session from:
--        • a public server (attribute absent or false)
--        • another player's private server (attribute false/nil)
--        • the owner accidentally running the script while on any other
--          server — activation is correctly suppressed there too.
--   2. game.JobId is non-empty — the engine has populated the current
--      server's JobId, which we need to send to the Worker.
--
-- NOTE: game.PrivateServerId and game.PrivateServerOwnerId are NOT used.
-- Testing confirmed both are unavailable on the client side in this
-- executor/game combination. The "privateserverowner" attribute is the
-- reliable, game-provided signal.
--
-- HEARTBEAT
-- Once the server is active, any player running the script inside the
-- same private server sends heartbeats every 30s. The Worker validates:
--   - serverVersion → must match the current /host record
--   - status        → must be "active"
--   - jobId         → must match the confirmed private-server JobId
-- Public-server data can never pollute the private-server player list.
--
-- Players are reported as { userId, username } pairs so the Worker can
-- deduplicate by UserId even if a username changes between heartbeats.
do
    local _hbEpoch = 0

    -- On startup, attempt to restore a previously saved server token.
    -- This handles the common case where the owner:
    --   1. Executed the script on a public server and clicked Host.
    --   2. Joined their private server (teleport kills the previous script session).
    --   3. Re-executed the script inside the private server.
    -- Without restoration, _psServerVersion would be nil here and tryActivate()
    -- would silently return, leaving the server perpetually in "waiting" status.
    do
        local savedVersion, savedUserId = loadPsToken()
        if savedVersion and savedUserId == tostring(player.UserId) then
            _psServerVersion = savedVersion
            -- tryActivate() is called below in sendHeartbeat() on first tick.
            -- We do not call it here because game.JobId and the attribute may
            -- not be populated yet this early in the script lifecycle.
        end
    end

    -- Build the player list as { userId, username } pairs.
    -- UserId is the stable identity; username is carried for display only.
    local function buildPlayerList()
        local list = {}
        for _, p in ipairs(Players:GetPlayers()) do
            table.insert(list, {
                userId   = p.UserId,
                username = p.Name,
            })
        end
        return list
    end

    -- Returns true if the local player is currently inside their own
    -- private server, as determined by the game's "privateserverowner"
    -- attribute on LocalPlayer.
    --
    -- The game server sets this attribute to true only on the player who
    -- owns the private server. It is absent or false for all other players
    -- and in all non-private-server contexts (public servers, other players'
    -- private servers). GetAttribute returns nil if the attribute has not
    -- been set yet, which pcall + explicit true-comparison handles safely.
    local function isInsideOwnPrivateServer()
        local ok, result = pcall(function()
            return player:GetAttribute("privateserverowner") == true
        end)
        return ok and result == true
    end

    local function tryActivate()
        if not _psServerVersion then return end
        -- Attribute check is the gate — if not owner, do not activate.
        if not isInsideOwnPrivateServer() then return end

        local jobId = tostring(game.JobId or "")
        if jobId == "" then return end  -- JobId not yet populated; retry next tick

        local playerList = buildPlayerList()

        task.spawn(function()
            local ok, body = psRequest("POST", "/activate", {
                ownerUserId   = tostring(player.UserId),
                jobId         = jobId,
                serverVersion = _psServerVersion,
                players       = playerList,
            })
            if ok then
                warn("[GenFarm/Activate] Server activated. JobId=" .. jobId)
                -- Token served its purpose — clear it so a future unrelated
                -- script execution doesn't accidentally re-activate a stale server.
                clearPsToken()
            else
                local s = tostring(body or "")
                if not s:find("Already active") then
                    warn("[GenFarm/Activate] " .. s)
                end
            end
        end)
    end

    local function sendHeartbeat()
        if not _psServerVersion then return end

        local jobId = tostring(game.JobId or "")
        if jobId == "" then
            -- JobId not yet available — try activation (which also checks the
            -- attribute) and skip heartbeat until next tick.
            tryActivate()
            return
        end

        -- Always attempt activation if the attribute says we are the owner.
        -- tryActivate is a no-op if already active (Worker returns "Already active").
        if isInsideOwnPrivateServer() then
            tryActivate()
        end

        local playerList = buildPlayerList()

        task.spawn(function()
            local ok, body = psRequest("POST", "/heartbeat", {
                ownerUserId   = tostring(player.UserId),
                jobId         = jobId,
                serverVersion = _psServerVersion,
                players       = playerList,
                reportedAt    = os.time() * 1000,
            })
            if not ok then
                local s = tostring(body or "")
                local silent = s:find("404") or s:find("not found")
                    or s:find("Server not found") or s:find("409")
                    or s:find("Stale") or s:find("403")
                    or s:find("not yet activated") or s:find("JobId mismatch")
                if not silent then
                    warn("[GenFarm/Heartbeat] " .. s)
                end
            end
        end)
    end

    sendHeartbeat()

    _hbEpoch = _hbEpoch + 1
    local myEpoch = _hbEpoch
    task.spawn(function()
        while myEpoch == _hbEpoch and not Library.Unloaded do
            task.wait(30)
            if myEpoch ~= _hbEpoch or Library.Unloaded then break end
            sendHeartbeat()
        end
    end)
end

-- ── Join section — Server Table ─────────────────────────────────────
-- Replaces the old one-groupbox-per-server layout with a scrollable,
-- sortable, filterable table. Built entirely from the same primitives
-- used everywhere else in the library (Make/AddCorner/AddStroke/Tween/
-- Library:AddToRegistry) so it inherits live theme updates for free.
--
-- BACKEND NOTE: ST.fetchServerList and ST.refreshOneServer call the
-- real Worker via psRequest("GET", "/list") and map its response into
-- ST's row shape (see mapListEntry below). There is no single-server
-- read endpoint, so a single-row refresh also calls /list and picks
-- out the matching entry — only that row's data changes.
--
-- NOTE ON STRUCTURE: everything below lives on a single table `ST`
-- instead of ~50 separate top-level locals. This isn't just style —
-- the script is already right at Luau's 200-local-per-chunk register
-- ceiling (see the earlier register-limit fix), so a feature this size
-- needs to cost close to one register, not fifty.
do
    local ST = {}

    ST.ROW_H        = 34
    ST.HEADER_H     = 30
    ST.VISIBLE_ROWS = 6
    ST.ROWS_H       = ST.ROW_H * ST.VISIBLE_ROWS
    ST.CHEVRON_W    = 28    -- reserved width for the header's expand/collapse chevron
    ST.COL_GAP      = 14    -- horizontal breathing room between header columns
    ST.OWNER_W      = -(136 + ST.COL_GAP * 2)  -- offset subtracted from Size(1,...)
    ST.PLAYERS_W    = 70
    ST.AGE_W         = 66

    -- ── State ────────────────────────────────────────────────────────
    ST.serverRows = {}   -- master data (array)
    ST.idIndex    = {}   -- id -> entry
    ST.rowFrames  = {}   -- id -> row Frame instance
    ST.selectedId = nil
    -- Each sortable column tracks its own selection state independently
    -- so multiple columns can be active at once (nil = not selected,
    -- 1 = ascending, -1 = descending). Priority when multiple columns
    -- are active follows this fixed column order (Players, then Age).
    ST.SORT_COLUMNS = { "Players", "Age" }
    ST.sortState = {
        Players = nil,
        Age     = nil,
    }
    ST.filters = {
        hideFull        = false,
        hideOwnerAbsent = false,
        hideEmpty       = false,
    }
    ST.sortDebounceEpoch = 0

    -- ── Age formatting — compact form (12m / 3h / 2d) ───────────────────
    function ST.formatAgeCompact(seconds)
        seconds = math.floor(math.max(0, seconds or 0))
        if seconds < 60 then
            return seconds .. "s"
        elseif seconds < 3600 then
            return math.floor(seconds / 60) .. "m"
        elseif seconds < 86400 then
            return math.floor(seconds / 3600) .. "h"
        else
            return math.floor(seconds / 86400) .. "d"
        end
    end

    -- ── Data adapter — backed by GET /list ────────────────────────────
    -- Maps the Worker's /list response shape:
    --   { ownerUsername, link, createdAt (unix ms), status, maxPlayers,
    --     playerCount (number|null), players (string[]|null) }
    -- to ST's row shape:
    --   { id, owner, players (number|nil), maxPlayers, createdAt (unix s), ownerPresent, link }
    --
    -- id: the Worker's /list response does not expose ownerUserId (the KV
    -- key), only ownerUsername — which is unique per hosted record since
    -- records are keyed by owner, so it doubles safely as the row id here.
    --
    -- ownerPresent: /list has no such field. "active" status only occurs
    -- once the owner (or another player in that private server) has sent
    -- a JobId-verified /activate or /heartbeat, so status == "active" is
    -- the correct stand-in — "waiting" means the owner has not yet joined.
    --
    -- createdAt: Worker sends unix milliseconds; ST works in unix seconds
    -- (os.time()-based, matching formatAgeCompact's "seconds" input).
    local function mapListEntry(raw)
        return {
            id           = tostring(raw.ownerUsername),
            owner        = tostring(raw.ownerUsername),
            players      = raw.playerCount,  -- nil (waiting) or number (active)
            maxPlayers   = raw.maxPlayers or 6,
            createdAt    = math.floor((tonumber(raw.createdAt) or 0) / 1000),
            ownerPresent = raw.status == "active",
            link         = raw.link or "",
        }
    end

    function ST.fetchServerList(callback)
        task.spawn(function()
            local ok, body = psRequest("GET", "/list", nil)
            if not ok then
                warn("[GenFarm/ServerTable] GET /list failed: " .. tostring(body))
                callback(nil)
                return
            end
            warn("[GenFarm/ServerTable] GET /list raw body: " .. tostring(body))
            local decodeOk, decoded = pcall(function()
                return HttpService:JSONDecode(body)
            end)
            if not decodeOk or type(decoded) ~= "table" then
                warn("[GenFarm/ServerTable] GET /list returned invalid JSON: " .. tostring(decoded))
                callback(nil)
                return
            end
            warn("[GenFarm/ServerTable] decoded " .. #decoded .. " raw entries")
            local list = {}
            for _, raw in ipairs(decoded) do
                local mapped = mapListEntry(raw)
                warn(string.format(
                    "[GenFarm/ServerTable] mapped entry: id=%s owner=%s players=%s maxPlayers=%s createdAt=%s ownerPresent=%s",
                    tostring(mapped.id), tostring(mapped.owner), tostring(mapped.players),
                    tostring(mapped.maxPlayers), tostring(mapped.createdAt), tostring(mapped.ownerPresent)
                ))
                table.insert(list, mapped)
            end
            callback(list)
        end)
    end

    -- There is no single-server endpoint on the Worker — /list is the only
    -- read path. A single-row refresh fetches the full list and picks out
    -- just the row matching `id`, which still satisfies "only that row
    -- updates" from the UI's point of view (only that row's data changes;
    -- the rest of ST.serverRows / ST.idIndex is left untouched).
    function ST.refreshOneServer(id, callback)
        task.spawn(function()
            local ok, body = psRequest("GET", "/list", nil)
            if not ok then
                warn("[GenFarm/ServerTable] GET /list (single refresh) failed: " .. tostring(body))
                callback(nil)
                return
            end
            local decodeOk, decoded = pcall(function()
                return HttpService:JSONDecode(body)
            end)
            if not decodeOk or type(decoded) ~= "table" then
                warn("[GenFarm/ServerTable] GET /list (single refresh) returned invalid JSON")
                callback(nil)
                return
            end
            for _, raw in ipairs(decoded) do
                if tostring(raw.ownerUsername) == id then
                    callback(mapListEntry(raw))
                    return
                end
            end
            -- Not found in the list anymore — server no longer exists.
            callback(false)
        end)
    end

    -- ── Section shell ──────────────────────────────────────────────
    ST.COUNTER_H   = 18
    ST.BOTTOMBAR_H = 34
    ST.GAP         = 4
    ST.BODY_H = ST.HEADER_H + 2 + ST.ROWS_H + ST.GAP + ST.COUNTER_H + ST.GAP + ST.BOTTOMBAR_H

    ST.tableRoot = Make("Frame", {
        Name                    = "ServerTableRoot",
        Size                    = UDim2.new(1, 0, 0, ST.BODY_H),
        BackgroundTransparency = 1,
        BorderSizePixel        = 0,
        ClipsDescendants       = true,
    }, HostTab:AddLeftGroupbox("Join Private Server")._content)

    -- ── Table header (Sort toggle / Owner / Players / Age) ───────────
    do
        local header = Make("Frame", {
            Name = "TableHeader",
            Size = UDim2.new(1, 0, 0, ST.HEADER_H),
            BackgroundColor3 = Library.Scheme.MainColor,
            BackgroundTransparency = Library.Scheme.ElementTransparency,
            BorderSizePixel  = 0,
        }, ST.tableRoot)
        AddCorner(header, 5)
        Library:AddToRegistry(header, { BackgroundColor3 = "MainColor" })
        table.insert(Library.ElementRows, header)
        ST.header = header

        -- Clear Sort button: tapping this deselects every active sort
        -- column, removes all sort arrows, and returns the server list to
        -- the default backend order. Selection, filters, and scroll are
        -- preserved. Icon is accent-colored while any sort is active so
        -- the user can see at a glance that sorting is in effect.
        ST.clearSortBtn = Make("ImageButton", {
            Name             = "ClearSort",
            Size             = UDim2.fromOffset(16, 16),
            Position         = UDim2.new(0, 8, 0.5, -8),
            BackgroundTransparency = 1,
            Image            = "rbxassetid://10723346158",
            ImageColor3      = Library.Scheme.SubtextColor,
            ImageTransparency = 0,
            AutoButtonColor  = false,
        }, header)
        Library:AddToRegistry(ST.clearSortBtn, { ImageColor3 = "SubtextColor" })
        ST.clearSortBtn.MouseEnter:Connect(function()
            Tween(ST.clearSortBtn, { ImageColor3 = Library.Scheme.AccentColor })
        end)
        ST.clearSortBtn.MouseLeave:Connect(function()
            -- Restore to accent if sort is active, subtext if not.
            local anySortActive = false
            for _, col in ipairs(ST.SORT_COLUMNS) do
                if ST.sortState[col] then anySortActive = true; break end
            end
            Tween(ST.clearSortBtn, {
                ImageColor3 = anySortActive
                    and Library.Scheme.AccentColor
                    or  Library.Scheme.SubtextColor
            })
        end)

        local ownerHeadLabel = Make("TextLabel", {
            Size           = UDim2.new(1, ST.OWNER_W, 1, 0),
            Position       = UDim2.fromOffset(10 + ST.CHEVRON_W, 0),
            BackgroundTransparency = 1,
            Text           = "Owner",
            TextColor3     = Library.Scheme.SubtextColor,
            TextSize       = 12,
            Font           = Enum.Font.GothamSemibold,
            TextXAlignment = Enum.TextXAlignment.Left,
        }, header)
        Library:AddToRegistry(ownerHeadLabel, { TextColor3 = "SubtextColor" })
        Library:TrackFont(ownerHeadLabel)

        -- COL_SEP: pixel gap on each side of a column boundary.
        -- The divider line sits exactly at the boundary; the columns are
        -- shrunk and shifted inward by COL_SEP so real empty space exists
        -- on both sides of the rule rather than the line sitting flush
        -- against a column edge.
        local COL_SEP = 6

        -- Vertical divider line placed exactly at each column boundary
        -- (right edge of the left column = left edge of the right column).
        -- The gaps come from the columns being inset, not from offsetting
        -- the divider itself.
        local function makeDivider(xOffsetFromRight)
            local d = Make("Frame", {
                Name                    = "ColumnDivider",
                Size                    = UDim2.new(0, 1, 1, -10),
                Position                = UDim2.new(1, xOffsetFromRight, 0.5, 0),
                AnchorPoint             = Vector2.new(0, 0.5),
                BackgroundColor3        = Library.Scheme.OutlineColor,
                BackgroundTransparency  = 0.35,
                BorderSizePixel         = 0,
            }, header)
            Library:AddToRegistry(d, { BackgroundColor3 = "OutlineColor" })
            return d
        end

        -- Right-anchored boundaries: where each column's right edge sits.
        -- AGE occupies the rightmost COL_GAP+AGE_W px.
        -- PLAYERS sits immediately left of that.
        -- Each boundary is where the divider line goes.
        local BOUNDARY_PLAYERS = -(ST.PLAYERS_W + ST.AGE_W + ST.COL_GAP)  -- Owner | Players
        local BOUNDARY_AGE     = -(ST.AGE_W + ST.COL_GAP)                  -- Players | Age

        makeDivider(BOUNDARY_PLAYERS)   -- divider at exact Owner/Players boundary
        makeDivider(BOUNDARY_AGE)       -- divider at exact Players/Age boundary

        -- Owner label right edge is trimmed by COL_SEP so it doesn't run
        -- into the divider. OWNER_W is already a negative size offset;
        -- subtracting COL_SEP makes it narrower by that amount.
        ownerHeadLabel.Size = UDim2.new(1, ST.OWNER_W - COL_SEP, 1, 0)

        local function makeSortHeader(text, column, width, xStart)
            -- xStart: left edge of this column's full slot (right-anchored).
            -- Shift the button right by COL_SEP (inward from the left boundary)
            -- and shrink it by COL_SEP so its right edge stays at the right
            -- boundary, leaving a gap on the left side of the divider.
            local btn = Make("TextButton", {
                Size             = UDim2.fromOffset(width - COL_SEP, ST.HEADER_H),
                Position         = UDim2.new(1, xStart + COL_SEP, 0, 0),
                BackgroundTransparency = 1,
                Text             = "",
                AutoButtonColor  = false,
            }, header)

            local lbl = Make("TextLabel", {
                Size           = UDim2.new(1, -18, 1, 0),
                BackgroundTransparency = 1,
                Text           = text,
                TextColor3     = Library.Scheme.SubtextColor,
                TextSize       = 12,
                Font           = Enum.Font.GothamSemibold,
                TextXAlignment = Enum.TextXAlignment.Left,
            }, btn)
            Library:AddToRegistry(lbl, { TextColor3 = "SubtextColor" })
            Library:TrackFont(lbl)

            -- Ascending/descending indicator: shown only when this
            -- column is selected AND indicators are enabled overall
            -- (see ST.updateChevrons).
            local sortIcon = Make("ImageLabel", {
                Name           = "SortIcon",
                Size           = UDim2.fromOffset(10, 10),
                Position       = UDim2.new(1, -12, 0.5, -5),
                BackgroundTransparency = 1,
                Image          = "rbxassetid://10709791523",  -- Up chevron
                ImageColor3    = Library.Scheme.AccentColor,
                Visible        = false,
            }, btn)
            Library:AddToRegistry(sortIcon, { ImageColor3 = "AccentColor" })

            -- Each column toggles its own selection independently, so
            -- multiple columns can be active (and sorted by) at once:
            -- unselected -> ascending -> descending -> unselected.
            btn.Activated:Connect(function()
                if guiDragMode then return end
                local cur = ST.sortState[column]
                if cur == nil then
                    ST.sortState[column] = 1
                elseif cur == 1 then
                    ST.sortState[column] = -1
                else
                    ST.sortState[column] = nil
                end
                ST.scheduleSort()
            end)

            return { btn = btn, sortIcon = sortIcon }
        end

        ST.playersHeader = makeSortHeader("Players", "Players", ST.PLAYERS_W, BOUNDARY_PLAYERS)
        ST.ageHeader     = makeSortHeader("Age",     "Age",     ST.AGE_W,     BOUNDARY_AGE)
        ST.sortHeaders   = { Players = ST.playersHeader, Age = ST.ageHeader }

        -- Clear Sort: deselects every active sort column and returns the
        -- server list to the default backend order. Preserves the
        -- selected server, all active filters, and the current scroll
        -- position (reconcile only repositions rows, it doesn't reset
        -- CanvasPosition). No-op when no sort columns are active.
        ST.clearSortBtn.Activated:Connect(function()
            if guiDragMode then return end
            local anySortActive = false
            for _, col in ipairs(ST.SORT_COLUMNS) do
                if ST.sortState[col] then anySortActive = true; break end
            end
            if not anySortActive then return end  -- nothing to clear
            -- Capture scroll position so we can restore it after reconcile.
            local savedScroll = ST.scrollFrame.CanvasPosition.Y
            -- Clear every sort column.
            for _, col in ipairs(ST.SORT_COLUMNS) do
                ST.sortState[col] = nil
            end
            -- updateChevrons resets arrow icons and eraser color immediately.
            ST.updateChevrons()
            -- reconcile re-orders the rows using the now-empty sort state,
            -- which falls through to the default backend insertion order.
            ST.reconcile()
            -- Restore scroll position (reconcile may have animated rows but
            -- does not touch CanvasPosition, so this is a safety measure).
            ST.scrollFrame.CanvasPosition = Vector2.new(0, savedScroll)
        end)

        -- Reflects ST.sortState on the header: shows the up/down arrow
        -- next to every column that is currently active, hides it when
        -- the column is inactive. Also updates the eraser icon color:
        -- accent when any sort is active (making the button "call to
        -- action" visible), subtext when no sort is selected.
        function ST.updateChevrons()
            local anySortActive = false
            for column, h in pairs(ST.sortHeaders) do
                local dir = ST.sortState[column]
                if dir then
                    anySortActive = true
                    h.sortIcon.Visible = true
                    h.sortIcon.Image = dir == 1
                        and "rbxassetid://10709791523"  -- Up chevron: ascending
                        or  "rbxassetid://10709790948"  -- Down chevron: descending
                else
                    h.sortIcon.Visible = false
                end
            end
            -- Eraser is accent-colored while there is something to clear,
            -- subtext when the list is already in default order.
            ST.clearSortBtn.ImageColor3 = anySortActive
                and Library.Scheme.AccentColor
                or  Library.Scheme.SubtextColor
        end
    end

    -- ── Body: everything the chevron collapses/expands (rows onward) ──
    do
        local bodyFrame = Make("Frame", {
            Name     = "TableBody",
            Position = UDim2.new(0, 0, 0, ST.HEADER_H + 2),
            Size     = UDim2.new(1, 0, 0, ST.BODY_H - ST.HEADER_H - 2),
            BackgroundTransparency = 1,
        }, ST.tableRoot)
        ST.bodyFrame = bodyFrame

        -- ── Scrollable row area ─────────────────────────────────────
        ST.scrollFrame = Make("ScrollingFrame", {
            Name                       = "ServerRows",
            Position                   = UDim2.fromOffset(0, 0),
            Size                       = UDim2.new(1, 0, 0, ST.ROWS_H),
            BackgroundColor3           = Library.Scheme.BackgroundColor,
            BackgroundTransparency     = 0.4,
            BorderSizePixel            = 0,
            ClipsDescendants           = true,
            ScrollBarImageColor3       = Color3.fromRGB(255, 255, 255),
            ScrollBarImageTransparency = 0.85,
            ScrollBarThickness         = 3,
            CanvasSize                 = UDim2.fromScale(0, 0),
            ScrollingDirection         = Enum.ScrollingDirection.Y,
        }, bodyFrame)
        AddCorner(ST.scrollFrame, 5)
        Library:AddToRegistry(ST.scrollFrame, { BackgroundColor3 = "BackgroundColor" })

        ST.noServersLabel = Make("TextLabel", {
            Name           = "NoServers",
            Size           = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            Text           = "No servers currently hosted.",
            TextColor3     = Library.Scheme.SubtextColor,
            TextSize       = 12,
            Font           = Enum.Font.Gotham,
            Visible        = false,
        }, ST.scrollFrame)
        Library:AddToRegistry(ST.noServersLabel, { TextColor3 = "SubtextColor" })
        Library:TrackFont(ST.noServersLabel)

        -- ── Server counter (centered in its row) ──────────────────────
        ST.counterLabel = Make("TextLabel", {
            Name           = "Counter",
            Position       = UDim2.new(0, 0, 0, ST.ROWS_H + ST.GAP),
            Size           = UDim2.new(1, 0, 0, ST.COUNTER_H),
            BackgroundTransparency = 1,
            Text           = "0 servers",
            TextColor3     = Library.Scheme.SubtextColor,
            TextSize       = 12,
            Font           = Enum.Font.Gotham,
            TextXAlignment = Enum.TextXAlignment.Center,
        }, bodyFrame)
        Library:AddToRegistry(ST.counterLabel, { TextColor3 = "SubtextColor" })
        Library:TrackFont(ST.counterLabel)

        -- ── Bottom action bar: Join Server, Filters, Refresh, Refresh All ──
        do
            local bottomBar = Make("Frame", {
                Name     = "BottomBar",
                Position = UDim2.new(0, 0, 0, ST.ROWS_H + ST.GAP + ST.COUNTER_H + ST.GAP),
                Size     = UDim2.new(1, 0, 0, ST.BOTTOMBAR_H),
                BackgroundTransparency = 1,
            }, bodyFrame)
            -- No padding between buttons — they should read as one
            -- connected row rather than separate pill buttons.
            Make("UIListLayout", {
                FillDirection       = Enum.FillDirection.Horizontal,
                Padding             = UDim.new(0, 0),
                HorizontalAlignment = Enum.HorizontalAlignment.Center,
                VerticalAlignment   = Enum.VerticalAlignment.Center,
                SortOrder           = Enum.SortOrder.LayoutOrder,
            }, bottomBar)

            local function makeActionButton(text, order)
                -- Sized to its text (AutomaticSize) with only a small
                -- padding margin, rather than a fixed/oversized width.
                local b = Make("TextButton", {
                    Size             = UDim2.fromOffset(0, ST.BOTTOMBAR_H),
                    AutomaticSize    = Enum.AutomaticSize.X,
                    LayoutOrder      = order,
                    BackgroundColor3 = Library.Scheme.AccentColor,
                    Text             = "",  -- real text is a separate label (see below) so we can layer a shadow behind it
                    BorderSizePixel  = 0,
                    AutoButtonColor  = false,
                }, bottomBar)
                -- Rectangular: intentionally no AddCorner call here.
                Library:AddToRegistry(b, { BackgroundColor3 = "AccentColor" })

                -- Subtle top-to-bottom gradient for a light depth/shadow
                -- feel, kept fully inside the button's own bounds.
                -- Transparency values are intentionally high (close to 1)
                -- so the effect is a faint hint rather than a strong band:
                --   top edge:    ~5 % white highlight  (was ~15 %)
                --   center:      fully transparent
                --   bottom edge: ~4 % black shadow     (was ~18 %)
                Make("UIGradient", {
                    Rotation = 90,
                    Color = ColorSequence.new({
                        ColorSequenceKeypoint.new(0, Color3.new(1, 1, 1)),
                        ColorSequenceKeypoint.new(0.5, Color3.new(1, 1, 1)),
                        ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 0, 0)),
                    }),
                    Transparency = NumberSequence.new({
                        NumberSequenceKeypoint.new(0, 0.95),
                        NumberSequenceKeypoint.new(0.5, 1),
                        NumberSequenceKeypoint.new(1, 0.96),
                    }),
                }, b)

                AddPadding(b, 0, 10, 0, 10)

                -- Small drop-shadow duplicate sitting just behind the
                -- real text, offset by 1px — a contained shadow rather
                -- than a glow, and it never grows past the button.
                local shadowLbl = Make("TextLabel", {
                    Size                    = UDim2.new(1, 0, 1, 0),
                    Position                = UDim2.fromOffset(0, 1),
                    BackgroundTransparency  = 1,
                    Text                    = text,
                    TextColor3              = Color3.new(0, 0, 0),
                    TextTransparency        = 0.6,
                    TextSize                = 12,
                    Font                    = Enum.Font.GothamSemibold,
                    ZIndex                  = 1,
                }, b)

                local textLbl = Make("TextLabel", {
                    Size                    = UDim2.new(1, 0, 1, 0),
                    BackgroundTransparency  = 1,
                    Text                    = text,
                    TextColor3              = Color3.new(1, 1, 1),
                    TextSize                = 12,
                    Font                    = Enum.Font.GothamSemibold,
                    ZIndex                  = 2,
                }, b)
                Library:TrackFont(textLbl)
                Library:TrackFont(shadowLbl)

                return b
            end

            -- Order left to right: Join Server, Filters, Refresh, Refresh All.
            ST.joinBtn       = makeActionButton("Join Server", 1)
            ST.filtersBtn    = makeActionButton("Filters", 2)
            ST.refreshBtn    = makeActionButton("Refresh", 3)
            ST.refreshAllBtn = makeActionButton("Refresh All", 4)
        end
    end

    -- Functional restriction only — enabled/disabled no longer changes
    -- appearance. Join Server and Refresh are inert until a server is
    -- selected, but look identical to the always-active buttons.
    function ST.setButtonEnabled(btn, enabled)
        btn.Active = enabled
    end
    ST.setButtonEnabled(ST.joinBtn, false)
    ST.setButtonEnabled(ST.refreshBtn, false)

    -- ── Row selection ──────────────────────────────────────────────
    -- rowTop is the row's target Y offset. Exposed separately from
    -- ST.scrollIntoView(frame) because callers right after ST.reconcile()
    -- can't read frame.Position — reconcile tweens existing frames into
    -- their new slot, so Position is still mid-transition at that point.
    function ST.scrollIntoViewY(rowTop)
        local viewTop    = ST.scrollFrame.CanvasPosition.Y
        local viewBottom = viewTop + ST.scrollFrame.AbsoluteSize.Y
        local rowBottom   = rowTop + ST.ROW_H
        local target = nil
        if rowTop < viewTop then
            target = rowTop
        elseif rowBottom > viewBottom then
            target = rowBottom - ST.scrollFrame.AbsoluteSize.Y
        end
        if target then
            target = math.max(0, target)
            TweenService:Create(ST.scrollFrame, Library.NotifyTweenInfo, { CanvasPosition = Vector2.new(0, target) }):Play()
        end
    end

    function ST.scrollIntoView(frame)
        ST.scrollIntoViewY(frame.Position.Y.Offset)
    end

    function ST.setRowHighlight(id, selected)
        local frame  = ST.rowFrames[id]
        local stroke = ST.rowStrokes[id]
        if not frame then return end
        if selected then
            Tween(frame, { BackgroundTransparency = 0.55 })
            if stroke then stroke.Transparency = 0 end
        else
            Tween(frame, { BackgroundTransparency = 1 })
            if stroke then stroke.Transparency = 1 end
        end
    end

    function ST.deselect()
        if ST.selectedId and ST.rowFrames[ST.selectedId] then
            ST.setRowHighlight(ST.selectedId, false)
        end
        ST.selectedId = nil
        ST.setButtonEnabled(ST.joinBtn, false)
        ST.setButtonEnabled(ST.refreshBtn, false)
    end

    function ST.selectRow(id)
        if ST.selectedId == id then
            -- Tapping the already-selected row again deselects it.
            ST.deselect()
            return
        end
        if ST.selectedId and ST.rowFrames[ST.selectedId] then
            ST.setRowHighlight(ST.selectedId, false)
        end
        ST.selectedId = id
        local frame = ST.rowFrames[id]
        if frame then
            ST.setRowHighlight(id, true)
            ST.scrollIntoView(frame)
        end
        ST.setButtonEnabled(ST.joinBtn, true)
        ST.setButtonEnabled(ST.refreshBtn, true)
    end

    -- Side tables keyed by row id — replaces storing custom fields
    -- directly on the row Instance (row.__stroke / row.__ageLbl /
    -- row.__createdAt), which throws "<field> is not a valid member of
    -- TextButton" on this executor. Frame apparently tolerates arbitrary
    -- keys but TextButton does not, so these are kept external instead.
    ST.rowStrokes    = {}  -- id -> UIStroke
    ST.rowAgeLabels  = {}  -- id -> TextLabel
    ST.rowCreatedAt  = {}  -- id -> unix seconds

    -- ── Row construction ───────────────────────────────────────────
    function ST.buildRow(entry)
        local row = Make("TextButton", {
            Name             = "Row_" .. entry.id,
            Size             = UDim2.new(1, 0, 0, ST.ROW_H - 2),
            BackgroundColor3 = Library.Scheme.AccentColor,
            BackgroundTransparency = 1,
            Text             = "",
            AutoButtonColor  = false,
            BorderSizePixel  = 0,
        }, ST.scrollFrame)
        AddCorner(row, 4)
        ST.rowStrokes[entry.id] = Make("UIStroke", {
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
            Thickness       = 1,
            Color           = Library.Scheme.AccentColor,
            Transparency    = 1,
        }, row)

        local ownerLbl = Make("TextLabel", {
            Size           = UDim2.new(1, ST.OWNER_W, 1, 0),
            Position       = UDim2.fromOffset(10 + ST.CHEVRON_W, 0),
            BackgroundTransparency = 1,
            Text           = entry.owner,
            TextColor3     = Library.Scheme.FontColor,
            TextSize       = 12,
            Font           = Enum.Font.Gotham,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate   = Enum.TextTruncate.AtEnd,
        }, row)
        Library:AddToRegistry(ownerLbl, { TextColor3 = "FontColor" })
        Library:TrackFont(ownerLbl)

        local playersText = entry.players ~= nil
            and (tostring(entry.players) .. "/" .. tostring(entry.maxPlayers))
            or "?"
        local playersLbl = Make("TextLabel", {
            Size           = UDim2.new(0, ST.PLAYERS_W - 6, 1, 0),
            Position       = UDim2.new(1, -(ST.PLAYERS_W + ST.AGE_W + ST.COL_GAP), 0, 0),
            BackgroundTransparency = 1,
            Text           = playersText,
            TextColor3     = Library.Scheme.SubtextColor,
            TextSize       = 12,
            Font           = Enum.Font.Gotham,
            TextXAlignment = Enum.TextXAlignment.Left,
        }, row)
        Library:AddToRegistry(playersLbl, { TextColor3 = "SubtextColor" })
        Library:TrackFont(playersLbl)

        local ageLbl = Make("TextLabel", {
            Size           = UDim2.new(0, ST.AGE_W - 10, 1, 0),
            Position       = UDim2.new(1, -ST.AGE_W, 0, 0),
            BackgroundTransparency = 1,
            Text           = ST.formatAgeCompact(os.time() - entry.createdAt),
            TextColor3     = Library.Scheme.SubtextColor,
            TextSize       = 12,
            Font           = Enum.Font.Gotham,
            TextXAlignment = Enum.TextXAlignment.Left,
        }, row)
        Library:AddToRegistry(ageLbl, { TextColor3 = "SubtextColor" })
        Library:TrackFont(ageLbl)
        ST.rowAgeLabels[entry.id] = ageLbl
        ST.rowCreatedAt[entry.id] = entry.createdAt

        row.MouseEnter:Connect(function()
            if ST.selectedId ~= entry.id then
                Tween(row, { BackgroundTransparency = 0.85 })
            end
        end)
        row.MouseLeave:Connect(function()
            if ST.selectedId ~= entry.id then
                Tween(row, { BackgroundTransparency = 1 })
            end
        end)
        row.Activated:Connect(function()
            if guiDragMode then return end
            ST.selectRow(entry.id)
        end)

        return row
    end

    -- Live-updating age text for visible rows (cheap: only touches rows
    -- that currently exist).
    OnSignal(RunService.Heartbeat, function()
        for id, ageLbl in pairs(ST.rowAgeLabels) do
            local createdAt = ST.rowCreatedAt[id]
            if createdAt then
                ageLbl.Text = ST.formatAgeCompact(os.time() - createdAt)
            end
        end
    end)

    -- ── Filtering + sorting + reconciliation ──────────────────────
    function ST.passesFilters(entry)
        if ST.filters.hideFull and entry.players ~= nil and entry.players >= entry.maxPlayers then
            return false
        end
        if ST.filters.hideOwnerAbsent and not entry.ownerPresent then
            return false
        end
        if ST.filters.hideEmpty and (entry.players or 0) == 0 then
            return false
        end
        return true
    end

    function ST.computeVisibleList()
        local list = {}
        for _, entry in ipairs(ST.serverRows) do
            if ST.passesFilters(entry) then
                table.insert(list, entry)
            end
        end

        -- Per-column comparators: return -1/0/1 for a-before-b, equal,
        -- a-after-b in ASCENDING order. Direction is applied afterward.
        local comparators = {
            Players = function(a, b)
                local av, bv = a.players or -1, b.players or -1
                if av < bv then return -1 elseif av > bv then return 1 else return 0 end
            end,
            Age = function(a, b)
                -- Older createdAt = larger age, so ascending age means
                -- descending createdAt.
                if a.createdAt > b.createdAt then return -1
                elseif a.createdAt < b.createdAt then return 1
                else return 0 end
            end,
        }

        -- Any number of columns can be active at once; apply them in a
        -- fixed priority order (Players, then Age) so ties on the first
        -- active column are broken by the next active one.
        local activeColumns = {}
        for _, column in ipairs(ST.SORT_COLUMNS) do
            if ST.sortState[column] then
                table.insert(activeColumns, column)
            end
        end

        if #activeColumns > 0 then
            table.sort(list, function(a, b)
                for _, column in ipairs(activeColumns) do
                    local cmp = comparators[column](a, b)
                    if cmp ~= 0 then
                        return ST.sortState[column] == 1 and cmp < 0 or cmp > 0
                    end
                end
                return a.id < b.id
            end)
        end

        return list
    end

    -- Reconciles the rendered rows with the current filtered/sorted
    -- list: reuses existing row frames (animating them into their new
    -- slot) and only creates/destroys frames for rows that entered or
    -- left the set.
    function ST.reconcile()
        local visible = ST.computeVisibleList()

        ST.counterLabel.Text = #visible == #ST.serverRows
            and (#ST.serverRows .. (#ST.serverRows == 1 and " server" or " servers"))
            or (#visible .. " of " .. #ST.serverRows .. " servers")

        ST.noServersLabel.Visible = #ST.serverRows == 0

        local seen = {}
        ST.lastSelectedTargetY = nil
        for i, entry in ipairs(visible) do
            seen[entry.id] = true
            local targetY = (i - 1) * ST.ROW_H
            if entry.id == ST.selectedId then
                ST.lastSelectedTargetY = targetY
            end
            local frame = ST.rowFrames[entry.id]
            if frame then
                TweenService:Create(frame, Library.NotifyTweenInfo, {
                    Position = UDim2.new(0, 0, 0, targetY),
                }):Play()
            else
                local buildOk, result = pcall(ST.buildRow, entry)
                if not buildOk then
                    warn("[GenFarm/ServerTable] buildRow FAILED for id=" .. tostring(entry.id) .. ": " .. tostring(result))
                    -- Don't let one bad row abort the rest of the loop —
                    -- skip it and keep reconciling the remaining rows.
                    seen[entry.id] = nil
                    goto continue
                end
                frame = result
                frame.Position = UDim2.new(0, 0, 0, targetY)
                frame.BackgroundTransparency = 1
                ST.rowFrames[entry.id] = frame
                if entry.id == ST.selectedId then
                    ST.setRowHighlight(entry.id, true)
                end
            end
            ::continue::
        end

        -- Remove frames for rows that fell out of the visible set.
        for id, frame in pairs(ST.rowFrames) do
            if not seen[id] then
                local f = frame
                Tween(f, { BackgroundTransparency = 1 })
                task.delay(Library.NotifyTweenInfo.Time, function()
                    if f and f.Parent then f:Destroy() end
                end)
                ST.rowFrames[id]     = nil
                ST.rowStrokes[id]    = nil
                ST.rowAgeLabels[id]  = nil
                ST.rowCreatedAt[id]  = nil
            end
        end

        ST.scrollFrame.CanvasSize = UDim2.fromOffset(0, #visible * ST.ROW_H)
        ST.updateChevrons()

        if ST.selectedId and not ST.idIndex[ST.selectedId] then
            ST.deselect()
        end
    end

    -- Debounced sort (100-200ms): rapid successive header clicks only
    -- trigger one reconcile, after input settles.
    function ST.scheduleSort()
        ST.sortDebounceEpoch = ST.sortDebounceEpoch + 1
        local myEpoch = ST.sortDebounceEpoch
        ST.updateChevrons()  -- reflect the clicked direction immediately
        task.delay(0.15, function()
            if myEpoch ~= ST.sortDebounceEpoch then return end
            ST.reconcile()
            -- If sorting moved the selected row, scroll just enough to
            -- keep it visible. lastSelectedTargetY is nil if nothing is
            -- selected or the selection is filtered out — scrollIntoViewY
            -- is skipped in that case.
            if ST.lastSelectedTargetY then
                ST.scrollIntoViewY(ST.lastSelectedTargetY)
            end
        end)
    end

    -- If the currently-selected server is missing from a freshly-fetched
    -- list, the row no longer exists on the backend (expired / removed).
    -- Clear the selection and tell the user — but only once per
    -- disappearance, not on every failed refresh.
    function ST.handleSelectedMissing()
        if not ST.selectedId then return end
        ST.deselect()
        Library:Notify({
            Title   = "Servers",
            Content = "The selected server is no longer available.",
        }, 4)
    end

    function ST.setData(list)
        if list == nil then return end  -- fetch failed; keep showing stale data
        local hadSelection = ST.selectedId
        ST.serverRows = list
        ST.idIndex = {}
        for _, entry in ipairs(list) do
            ST.idIndex[entry.id] = entry
        end
        ST.reconcile()  -- ST.reconcile already deselects if selectedId is gone
        if hadSelection and not ST.idIndex[hadSelection] then
            ST.handleSelectedMissing()
        end
    end

    -- ── Per-row loading indicator ────────────────────────────────────
    -- Small rotating ring, positioned over the Players/Age columns of a
    -- single row, shown only while that row's own refresh is in flight.
    -- Reuses the same Make/Tween/OnSignal(Heartbeat) patterns already
    -- used elsewhere in ST (e.g. the age-label ticker above).
    ST.spinningRows = {}  -- id -> ImageLabel currently spinning for that row

    function ST.showRowLoading(id)
        local frame = ST.rowFrames[id]
        if not frame or ST.spinningRows[id] then return end
        local spinner = Make("ImageLabel", {
            Name                    = "RowSpinner",
            Size                    = UDim2.fromOffset(14, 14),
            Position                = UDim2.new(1, -(ST.PLAYERS_W + ST.AGE_W + ST.COL_GAP) - 18, 0.5, -7),
            BackgroundTransparency  = 1,
            Image                   = "rbxassetid://4560909609",
            ImageColor3             = Library.Scheme.SubtextColor,
            ZIndex                  = 5,
        }, frame)
        Library:AddToRegistry(spinner, { ImageColor3 = "SubtextColor" })
        ST.spinningRows[id] = spinner
    end

    function ST.hideRowLoading(id)
        local spinner = ST.spinningRows[id]
        if spinner then
            spinner:Destroy()
            ST.spinningRows[id] = nil
        end
    end

    OnSignal(RunService.Heartbeat, function(dt)
        for _, spinner in pairs(ST.spinningRows) do
            spinner.Rotation = (spinner.Rotation + dt * 360) % 360
        end
    end)

    -- ── Refresh All / Refresh (single) / Join wiring ────────────────
    -- Refresh All preserves selection, active sort columns, active
    -- filters, and scroll position: none of those are touched here —
    -- ST.setData -> ST.reconcile only repositions/creates/destroys row
    -- frames for the current filter+sort state, it never resets them.
    ST.refreshAllBtn.Activated:Connect(function()
        if guiDragMode then return end
        local savedScroll = ST.scrollFrame.CanvasPosition
        ST.fetchServerList(function(list)
            ST.setData(list)
            -- reconcile can adjust CanvasSize; restore the exact scroll
            -- offset afterward so the visible viewport doesn't jump.
            ST.scrollFrame.CanvasPosition = savedScroll
        end)
    end)

    -- Refresh updates only the selected server's row: a per-row spinner
    -- shows on that row alone, the rest of the table is left untouched.
    ST.refreshBtn.Activated:Connect(function()
        if guiDragMode then return end
        if not ST.selectedId then return end
        local id = ST.selectedId
        ST.showRowLoading(id)
        ST.refreshOneServer(id, function(result)
            -- Selection may have changed while the request was in flight;
            -- only touch the row we actually started loading for.
            ST.hideRowLoading(id)
            if result == nil then
                return  -- network/decode failure — leave the row as-is
            end
            if result == false then
                -- Server no longer exists on the backend — drop it so the
                -- table matches reality.
                for i, e in ipairs(ST.serverRows) do
                    if e.id == id then
                        table.remove(ST.serverRows, i)
                        break
                    end
                end
                ST.idIndex[id] = nil
                ST.reconcile()
                if ST.selectedId == id then
                    ST.handleSelectedMissing()
                end
                return
            end
            -- result is the freshly-fetched entry for this row.
            ST.idIndex[id] = result
            for i, e in ipairs(ST.serverRows) do
                if e.id == id then
                    ST.serverRows[i] = result
                    break
                end
            end
            ST.reconcile()
        end)
    end)

    ST.joinBtn.Activated:Connect(function()
        if guiDragMode then return end
        if not ST.selectedId then return end
        local entry = ST.idIndex[ST.selectedId]
        if entry then
            joinPrivateServer(entry.link)
        end
    end)

    -- ── Filters popup ──────────────────────────────────────────────
    ST.filtersPopupOpen = false
    function ST.openFiltersPopup()
        if ST.filtersPopupOpen then return end
        ST.filtersPopupOpen = true

        local function makeFilterToggle(parent, text, yPos, initial, onChange)
            local row = Make("Frame", {
                Size     = UDim2.new(1, -16, 0, 30),
                Position = UDim2.new(0, 8, 0, yPos),
                BackgroundTransparency = 1,
            }, parent)

            local lbl = Make("TextLabel", {
                Size           = UDim2.new(1, -46, 1, 0),
                BackgroundTransparency = 1,
                Text           = text,
                TextColor3     = Library.Scheme.FontColor,
                TextSize       = 12,
                Font           = Enum.Font.Gotham,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextWrapped    = true,
            }, row)
            Library:AddToRegistry(lbl, { TextColor3 = "FontColor" })
            Library:TrackFont(lbl)

            local track = Make("TextButton", {
                Size             = UDim2.fromOffset(36, 20),
                Position         = UDim2.new(1, -36, 0.5, -10),
                BackgroundColor3 = initial and Library.Scheme.AccentColor or Library.Scheme.ToggleSlider,
                Text             = "",
                AutoButtonColor  = false,
                BorderSizePixel  = 0,
            }, row)
            AddCorner(track, 10, true)

            local knob = Make("Frame", {
                Size             = UDim2.fromOffset(16, 16),
                Position         = initial and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8),
                BackgroundColor3 = Color3.new(1, 1, 1),
                BorderSizePixel  = 0,
            }, track)
            AddCorner(knob, 8, true)

            local state = initial
            track.Activated:Connect(function()
                if guiDragMode then return end
                state = not state
                Tween(track, { BackgroundColor3 = state and Library.Scheme.AccentColor or Library.Scheme.ToggleSlider })
                Tween(knob, { Position = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8) })
                onChange(state)
            end)

            return {
                SetState = function(v)
                    state = v
                    track.BackgroundColor3 = state and Library.Scheme.AccentColor or Library.Scheme.ToggleSlider
                    knob.Position = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)
                end,
            }
        end

        local blocker = Make("TextButton", {
            Name             = "FiltersBlocker",
            Size             = UDim2.fromScale(1, 1),
            BackgroundTransparency = 1,
            Text             = "",
            AutoButtonColor  = false,
            ZIndex           = 29,
        }, screenGui)

        local popup = Make("Frame", {
            Name             = "FiltersPopup",
            Size             = UDim2.fromOffset(240, 190),
            Position         = UDim2.new(0.5, -120, 0.5, -95),
            BackgroundColor3 = Library.Scheme.BackgroundColor,
            BorderSizePixel  = 0,
            ZIndex           = 30,
        }, screenGui)
        AddCorner(popup, 8)
        AddStroke(popup, Library.Scheme.OutlineColor, 1)
        Library:AddToRegistry(popup, { BackgroundColor3 = "BackgroundColor" })

        local popupShadow = Make("Frame", {
            Size             = UDim2.new(1, 10, 1, 10),
            Position         = UDim2.new(0, -5, 0, 4),
            BackgroundColor3 = Color3.new(0, 0, 0),
            BackgroundTransparency = 0.5,
            BorderSizePixel  = 0,
            ZIndex           = 29,
        }, popup)
        AddCorner(popupShadow, 10)

        local scale = Make("UIScale", { Scale = 0.9 }, popup)

        local titleLbl = Make("TextLabel", {
            Size           = UDim2.new(1, -40, 0, 30),
            Position       = UDim2.fromOffset(12, 4),
            BackgroundTransparency = 1,
            Text           = "Filters",
            TextColor3     = Library.Scheme.FontColor,
            TextSize       = 14,
            Font           = Enum.Font.GothamSemibold,
            TextXAlignment = Enum.TextXAlignment.Left,
            ZIndex         = 31,
        }, popup)
        Library:AddToRegistry(titleLbl, { TextColor3 = "FontColor" })

        local closeBtn = Make("TextButton", {
            Size             = UDim2.fromOffset(24, 24),
            Position         = UDim2.new(1, -30, 0, 6),
            BackgroundTransparency = 1,
            Text             = "X",
            TextColor3       = Library.Scheme.SubtextColor,
            TextSize         = 16,
            Font             = Enum.Font.GothamBold,
            AutoButtonColor  = false,
            ZIndex           = 31,
        }, popup)
        Library:AddToRegistry(closeBtn, { TextColor3 = "SubtextColor" })

        local togFull  = makeFilterToggle(popup, "Hide Full Servers", 38, ST.filters.hideFull, function(v)
            ST.filters.hideFull = v
            ST.reconcile()
        end)
        local togOwner = makeFilterToggle(popup, "Hide Servers Where Owner Is Not Present", 72, ST.filters.hideOwnerAbsent, function(v)
            ST.filters.hideOwnerAbsent = v
            ST.reconcile()
        end)
        local togEmpty = makeFilterToggle(popup, "Hide Empty Servers", 106, ST.filters.hideEmpty, function(v)
            ST.filters.hideEmpty = v
            ST.reconcile()
        end)

        local clearBtn = Make("TextButton", {
            Size             = UDim2.new(1, -16, 0, 30),
            Position         = UDim2.new(0, 8, 1, -38),
            BackgroundColor3 = Library.Scheme.MainColor,
            BackgroundTransparency = Library.Scheme.ElementTransparency,
            Text             = "Clear Filters",
            TextColor3       = Library.Scheme.FontColor,
            TextSize         = 12,
            Font             = Enum.Font.GothamSemibold,
            BorderSizePixel  = 0,
            AutoButtonColor  = false,
            ZIndex           = 31,
        }, popup)
        AddCorner(clearBtn, 6)
        Library:AddToRegistry(clearBtn, { BackgroundColor3 = "MainColor", TextColor3 = "FontColor" })

        clearBtn.Activated:Connect(function()
            if guiDragMode then return end
            ST.filters.hideFull = false
            ST.filters.hideOwnerAbsent = false
            ST.filters.hideEmpty = false
            togFull.SetState(false)
            togOwner.SetState(false)
            togEmpty.SetState(false)
            ST.reconcile()
        end)

        popup.BackgroundTransparency = 1
        popupShadow.BackgroundTransparency = 1
        TweenService:Create(popup, Library.NotifyTweenInfo, { BackgroundTransparency = 0 }):Play()
        TweenService:Create(popupShadow, Library.NotifyTweenInfo, { BackgroundTransparency = 0.5 }):Play()
        TweenService:Create(scale, Library.NotifyTweenInfo, { Scale = 1 }):Play()

        local function closePopup()
            if not ST.filtersPopupOpen then return end
            ST.filtersPopupOpen = false
            TweenService:Create(popup, Library.NotifyTweenInfo, { BackgroundTransparency = 1 }):Play()
            TweenService:Create(popupShadow, Library.NotifyTweenInfo, { BackgroundTransparency = 1 }):Play()
            TweenService:Create(scale, Library.NotifyTweenInfo, { Scale = 0.9 }):Play()
            task.delay(Library.NotifyTweenInfo.Time, function()
                popup:Destroy()
                blocker:Destroy()
            end)
        end

        blocker.Activated:Connect(closePopup)   -- dismiss by tapping outside
        closeBtn.Activated:Connect(closePopup)  -- dismiss by pressing X
    end

    ST.filtersBtn.Activated:Connect(function()
        if guiDragMode then return end
        ST.openFiltersPopup()
    end)

    -- ── Initial load ────────────────────────────────────────────────
    task.defer(function()
        task.wait(1)
        ST.fetchServerList(function(list)
            ST.setData(list)
        end)
    end)
end -- close Server Table do block
