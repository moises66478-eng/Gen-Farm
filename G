    table.clear(self.Owned)

end

function PerkManager:ClearActive()

    table.clear(self.Active)

end

function PerkManager:Disconnect()

    for _,c in ipairs(self.Connections) do

        if c then
            c:Disconnect()
        end

    end

    table.clear(self.Connections)

end

function PerkManager:Destroy()

    self:Disconnect()

    if self.Dropdown then
        self.Dropdown:Destroy()
        self.Dropdown=nil
    end

end

