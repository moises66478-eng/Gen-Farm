        Position               = UDim2.fromOffset(0, 24),
        BackgroundTransparency = 1,
        BorderSizePixel        = 0,
    }, sectionRoot)
    contentLayout.Parent = content

    -- Auto-size root based on content (Fluent exact)
    contentLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        content.Size      = UDim2.new(1, 0, 0, contentLayout.AbsoluteContentSize.Y)
        sectionRoot.Size  = UDim2.new(1, 0, 0, contentLayout.AbsoluteContentSize.Y + 25)
    end)

    local gb = {
        _content    = content,
        _holder     = sectionRoot,  -- compat alias
        _shadow     = nil,
        _stroke     = nil,
        _sectionRoot = sectionRoot,
        _itemIdx    = 0,   -- BUG 10 FIX: layout order counter
    }

    local function nextOrder()
        gb._itemIdx += 1
        return gb._itemIdx
    end

    -- ── AddLabel ────────────────────────────────────────────────────
    function gb:AddLabel(text, opts)
