-- FIX 3.1: DPI Scale wired to the UIScale instance.
-- After changing scale we yield one frame so Roblox re-runs its layout
-- engine, then manually re-fire the selector bar positioning so the "|"
-- accent bar stays aligned with the active tab at every DPI setting.
MenuGroup:AddDropdown("DPIScale", {
    Text    = "DPI Scale",
    Values  = { "50%", "75%", "100%", "125%", "150%", "175%", "200%" },
    Default = "100%",
    Callback = function(value)
        local pct = tonumber(value:match("(%d+)%%")) or 100
        Library.DPIScale  = pct / 100
        uiScale.Scale     = Library.DPIScale
        -- Yield one frame so Roblox's layout engine finishes scaling,
        -- then re-position the selector bar with the updated DPIScale.
        task.defer(function()
            task.wait()
            if activeTab and activeTab.Button and activeTab.Button.Parent then
                local scale = math.max(Library.DPIScale, 0.01)
                local by  = activeTab.Button.AbsolutePosition.Y / scale
                local bh  = activeTab.Button.AbsoluteSize.Y     / scale
                local fy  = tabFrame.AbsolutePosition.Y         / scale
                selectorBar.Size     = UDim2.fromOffset(4, bh)
                selectorBar.Position = UDim2.fromOffset(0, by - fy + math.floor(bh / 2))
            end
        end)
    end,
})

-- FIX 3.2: Corner Radius wired to Library.Corners (live update on every UICorner)
MenuGroup:AddSlider("CornerRadius", {
    Text     = "Corner Radius",
    Min      = 0,
