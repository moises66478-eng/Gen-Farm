-- ── Host section ──────────────────────────────────────────────────

local PSLinkInput = HostGroup:AddInput("PSLinkInput", {
    Text        = "Private Server Link",
    Placeholder = "Paste private server or share link (roblox.com/share?code=...)",
    Default     = "",
})

local _hostCooldown = false

-- _psServerVersion is the token returned by /host.
-- It is included in every /activate and /heartbeat request so the Worker
-- can distinguish the current hosted server from any previous one.
-- Rotating on every /host call means old-server heartbeats are rejected.
--
-- PERSISTENCE: the script does not survive teleportation. When the owner
-- teleports from the public lobby to their private server, _psServerVersion
-- would be nil in the new session. To handle this we write the token to a
-- file immediately after /host succeeds, then read it back on startup.
-- If the attribute "privateserverowner" is true on startup, we know we are
-- inside our own private server and use the saved token to call /activate
-- automatically — no manual re-hosting needed.
local _psServerVersion  = nil
local _psTokenFile      = "GenFarm/pstoken.json"

local function savePsToken(version, userId)
    pcall(function()
        local data = HttpService:JSONEncode({ version = version, userId = tostring(userId) })
        writefile(_psTokenFile, data)
    end)
end

local function loadPsToken()
    local ok, raw = pcall(readfile, _psTokenFile)
    if not ok or not raw or raw == "" then return nil, nil end
    local dok, data = pcall(function() return HttpService:JSONDecode(raw) end)
    if not dok or type(data) ~= "table" then return nil, nil end
    return data.version, data.userId
end

local function clearPsToken()
    pcall(delfile, _psTokenFile)
end

HostGroup:AddButton("Host Server", function()
    if _hostCooldown then
        Library:Notify({ Title = "Host", Content = "Please wait before hosting again." }, 2)
        return
    end

    local link = PSLinkInput.Value or ""
    link = link:match("^%s*(.-)%s*$") -- trim whitespace

    local isClassicLink = link:find("roblox%.com/games/") and link:find("privateServerLinkCode=")
    local isShareLink   = link:find("roblox%.com/share") and link:find("code=")

    if not (isClassicLink or isShareLink) then
        Library:Notify({ Title = "Host", Content = "Paste a private server or share link." }, 3)
        return
    end

    _hostCooldown = true
    task.spawn(function()
        -- IMPORTANT: do NOT send game.JobId here.
        -- At this moment the player is on a public server. That JobId belongs
        -- to the public server and must never be stored as the private server's
        -- JobId. The real private-server JobId is sent via /activate once the
        -- owner actually joins their private server.
        local ok, body = psRequest("POST", "/host", {
            link        = link,
            username    = player.Name,
            ownerUserId = tostring(player.UserId),
        })
        if ok then
            -- Store the serverVersion token so /activate and /heartbeat can
            -- include it. The Worker uses it to reject stale requests from
            -- any previous hosted server belonging to this owner.
            local decodeOk, decoded = pcall(function()
                return HttpService:JSONDecode(body)
            end)
            if decodeOk and type(decoded) == "table" and decoded.serverVersion then
                _psServerVersion = tostring(decoded.serverVersion)
                -- Persist the token so the next script session (after teleporting
                -- to the private server) can call /activate without re-hosting.
                savePsToken(_psServerVersion, player.UserId)
            end
            Library:Notify({ Title = "Host", Content = "Server hosted! Join your private server to activate tracking." }, 4)
        else
            local errMsg = tostring(body or "unknown error")
            Library:Notify({ Title = "Host Failed", Content = errMsg }, 5)
            warn("[GenFarm/Host] POST /host failed: " .. errMsg)
        end
        task.wait(10)
        _hostCooldown = false
    end)
end)

