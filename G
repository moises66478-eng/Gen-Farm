ThemesGroup:AddInput("BackgroundImage", {
    Text        = "Background Image",
    Placeholder = "Asset ID, rbxassetid://, or URL...",
    Callback    = function(value)
        value = tostring(value or ""):match("^%s*(.-)%s*$")  -- trim whitespace

        if value == "" then
            bgImageLabel.Image   = ""
            bgImageLabel.Visible = false
            acrylicRoot.Visible  = true  -- restore acrylic background
            return
        end

        -- Extract the numeric asset ID from whatever format was supplied.
        -- Supported:  10691483517
        --             rbxassetid://10691483517
        --             https://create.roblox.com/store/asset/10691483517/...
        --             https://www.roblox.com/catalog/10691483517/...
        local id = value:match("^%d+$")                  -- raw numeric ID
                or value:match("^rbxassetid://(%d+)$")   -- rbxassetid:// prefix
                or value:match("/asset/(%d+)")            -- create.roblox.com URL
                or value:match("/catalog/(%d+)")          -- www.roblox.com catalog URL
                or value:match("/(%d+)[%?/]?")            -- any Roblox URL with an ID segment

        if not id then
            Library:Notify("Invalid format. Paste an asset ID, rbxassetid://, or a Roblox URL.", 3)
            return
        end

