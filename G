-- Returns perk level (1/2/3) if the player owns `perkName`, else nil
function Farm.getOwnedPerkLevel(perkName)
    local ok2, perksGui = pcall(function()
        return playerGui:WaitForChild("SurvivorPerks", 1)
            :WaitForChild("Perks", 1)
    end)
    if not ok2 or not perksGui then return nil end

    -- Method 2: look up by name directly
    local slot = perksGui:FindFirstChild(perkName)
    if slot then
        -- Determine level from image asset
        local img = slot:FindFirstChildOfClass("ImageLabel")
            or slot:FindFirstChildOfClass("ImageButton")
        if img then
            for lvl, asset in ipairs(PERK_ASSETS[perkName] or {}) do
                if img.Image == asset then return lvl end
            end
        end
        return 1  -- found but can't determine level, assume 1
    end

    -- Method 1: check slots "1","2","3" for matching Name
    for i = 1, 3 do
        local s = perksGui:FindFirstChild(tostring(i))
        if s and s.Name == perkName then
            local img2 = s:FindFirstChildOfClass("ImageLabel")
                or s:FindFirstChildOfClass("ImageButton")
            if img2 then
                for lvl, asset in ipairs(PERK_ASSETS[perkName] or {}) do
                    if img2.Image == asset then return lvl end
                end
            end
            return 1
        end
    end

    return nil
end

-- Returns asset ID for the highest owned level of perkName, or nil
function Farm.getPerkDisplayAsset(perkName)
    local lvl = Farm.getOwnedPerkLevel(perkName)
    if not lvl then return nil end
    local assets = PERK_ASSETS[perkName]
    return assets and assets[lvl]
end

-- Returns list of highlighted generator indices from Perfectionist Planning
function Farm.getPerfectionistHighlights()
    local indices = {}
    local ok2, highlight = pcall(function()
        return playerGui:WaitForChild("Perffectionisthighlight", 0.5)
    end)
    if not ok2 or not highlight then return indices end
    for _, child in ipairs(highlight:GetChildren()) do
        -- Children named "Generator [1]", "Generator [2]", etc.
        local idx = tonumber(child.Name:match("Generator %[(%d+)%]"))
        if idx then table.insert(indices, idx) end
    end
    return indices
end

-- ─── Perk-aware Farm.pickBestGenIndex ──────────────────────────────────
-- highlightedOnly: when true, only pick from highlighted generators
-- (used when Perfectionist Planning is active)
function Farm.pickBestGenIndex(genModels, excludeIdx, highlightedOnly)
    local highlighted = {}
    if highlightedOnly then
        for _, idx in ipairs(Farm.getPerfectionistHighlights()) do
            highlighted[idx] = true
        end
        -- If no highlights exist, fall back to normal behavior
        if next(highlighted) == nil then
            highlightedOnly = false
        end
    end

    local bestIdx, bestProg = nil, -1
    for idx, model in ipairs(genModels) do
        if idx == excludeIdx then continue end
        if Farm.isGenDone(model) then continue end
        if not model or not model.Parent then continue end
        if Farm.isModelOccupied(model) then continue end
        if highlightedOnly and not highlighted[idx] then continue end
        local prog = Farm.getGenProgress(model) or 0
        if prog > bestProg then bestProg = prog bestIdx = idx end
    end
    return bestIdx
end



