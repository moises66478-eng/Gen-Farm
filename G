-- ─── Helpers ──────────────────────────────────────────────────────
local function Make(class, props, parent)
    local inst = Instance.new(class)
    for k, v in pairs(props) do
        -- Wrap each property set so one bad property doesn't kill the script.
        -- This protects against unsupported properties on older executor API versions
        -- (e.g. AutomaticSize, FontFace, or any future Roblox additions).
        local ok, err = pcall(function() inst[k] = v end)
        if not ok then
            warn("[GenFarm] Make: failed to set " .. tostring(class) .. "." .. tostring(k) .. " = " .. tostring(v) .. " | " .. tostring(err))
        end
    end
    if parent then inst.Parent = parent end
    return inst
end

-- FIX 3.2: AddCorner registers into Library.Corners for live radius updates.
-- Bug 7 fix: added a `fixed` parameter. Pill-shaped toggle tracks/knobs,
-- the circular circle button, and slider knobs must NEVER follow the
-- global Corner Radius slider (doing so squares them off when radius is
-- low, e.g. after loading a config with CornerRadius = 0). Pass
-- fixed = true for those and the corner is created but NOT tracked.
local function AddCorner(parent, radius, fixed)
    local r = radius ~= nil and radius or Library.CornerRadius
    local corner = Make("UICorner", { CornerRadius = UDim.new(0, r) }, parent)
    if not fixed then
        table.insert(Library.Corners, corner)
    end
    return corner
end

local function AddStroke(parent, color, thickness)
    return Make("UIStroke", {
        Color     = color or Color3.fromRGB(40, 40, 40),
        Thickness = thickness or 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, parent)
end

local function AddPadding(parent, top, right, bottom, left)
    return Make("UIPadding", {
        PaddingTop    = UDim.new(0, top    or 6),
        PaddingRight  = UDim.new(0, right  or 6),
        PaddingBottom = UDim.new(0, bottom or 6),
        PaddingLeft   = UDim.new(0, left   or 6),
    }, parent)
end

local function AddListLayout(parent, dir, pad, ha, va)
    return Make("UIListLayout", {
        FillDirection       = dir or Enum.FillDirection.Vertical,
        Padding             = UDim.new(0, pad or 6),
        HorizontalAlignment = ha  or Enum.HorizontalAlignment.Left,
        VerticalAlignment   = va  or Enum.VerticalAlignment.Top,
        SortOrder           = Enum.SortOrder.LayoutOrder,
    }, parent)
end

local function SafeCall(fn, ...)
    if type(fn) ~= "function" then return end
    local ok, err = pcall(fn, ...)
    if not ok then warn("[GenFarm UI] Callback error: " .. tostring(err)) end
end

local function Tween(inst, props, info)
    TweenService:Create(inst, info or Library.TweenInfo, props):Play()
end

local function OnSignal(signal, fn)
    local conn = signal:Connect(fn)
    table.insert(Library.Signals, conn)
    return conn
end

