    -- Touch-and-hold fix: while GUI movement is unlocked, every groupbox's
    -- own ScrollingFrame must stop responding to touch-drag so a vertical
    -- drag repositions the window instead of scrolling the box's content.
    for _, t in ipairs(tabObjects) do
        if t.ContainerFrame then
            pcall(function() t.ContainerFrame.ScrollingEnabled = not enabled end)
