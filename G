        -- Single column: both Left/Right point to the same frame
        LeftCol        = containerFrame,
        RightCol       = containerFrame,
        _bar           = selectorBar,  -- shared global bar
    }
    table.insert(tabObjects, tabObj)

    -- Issue 10: Use per-theme HoverChange token for tab hover transparency.
    -- Fluent uses ElementTransparency as the selected/hover level (0.89 for Dark).
    btn.MouseEnter:Connect(function()
        if activeTab ~= tabObj then
            Tween(btn, {
                BackgroundTransparency = Library.Scheme.ElementTransparency,
            })
        end
    end)
    btn.MouseLeave:Connect(function()
        if activeTab ~= tabObj then
            Tween(btn, { BackgroundTransparency = 1 })
        end
    end)
    btn.MouseButton1Down:Connect(function()
        Tween(btn, {
            BackgroundTransparency = Library.Scheme.ElementTransparency
                + Library.Scheme.HoverChange,
        })
    end)
    btn.MouseButton1Up:Connect(function()
        if activeTab == tabObj then
            Tween(btn, {
                BackgroundTransparency = Library.Scheme.ElementTransparency,
            })
        end
    end)

    btn.Activated:Connect(function()
        setActiveTab(tabObj)
    end)

    -- AddLeftGroupbox / AddRightGroupbox both go to the single column
    function tabObj:AddLeftGroupbox(name2)
        return Library:_MakeSection(containerFrame, name2)
    end
    function tabObj:AddRightGroupbox(name2)
        return Library:_MakeSection(containerFrame, name2)
    end
    -- Fluent AddSection
    function tabObj:AddSection(name2)
        return Library:_MakeSection(containerFrame, name2)
    end

    if #tabObjects == 1 then setActiveTab(tabObj) end
    return tabObj
end

