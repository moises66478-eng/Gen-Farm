-- _transLevel is forward-declared above. Both setGuiTransparency and the
-- slider write to that same upvalue so they always stay in sync.

setGuiTransparency = function(enable)
    _transState = enable
    local level = enable and 0.55 or 0
    _transLevel = level
    if Library.Options["GUITransparency"] then
        Library.Options["GUITransparency"]:SetValue(enable and 55 or 0)
    end
    if bgImageLabel and bgImageLabel.Visible then
        acrylicRoot.Visible = false
    else
        acrylicRoot.Visible = true
        -- Use 0 as base when no acrylic, 0.45 when acrylic is active
        local base = _acrylicDOF and 0.45 or 0
        Tween(bgFrame, { BackgroundTransparency = math.min(1, base + level) })
    end
end

