        Padding             = UDim.new(0, 6),
        FillDirection       = Enum.FillDirection.Vertical,
        SortOrder           = Enum.SortOrder.LayoutOrder,
        VerticalAlignment   = Enum.VerticalAlignment.Bottom,  -- stack from bottom up
        HorizontalAlignment = Enum.HorizontalAlignment.Right,
    }, notifyHolder)
end

function Library:Notify(text, duration)
    duration = duration or 3
    ensureNotifyGui()
    _notifyCount += 1

    -- NotificationSide: Fluent keeps it bottom-right (AnchorPoint 1,1).
    -- Side option adjusts horizontal alignment only.
    local side = self.NotificationSide or "Right"
    if side == "Left" then
        notifyHolder.AnchorPoint = Vector2.new(0, 1)
        notifyHolder.Position    = UDim2.new(0, 30, 1, -30)
    else
        notifyHolder.AnchorPoint = Vector2.new(1, 1)
        notifyHolder.Position    = UDim2.new(1, -30, 1, -30)
    end

    -- Fluent-style notification: Title + Content layout
    local title    = type(text) == "table" and (text.Title   or "Interface") or "Interface"
    local content  = type(text) == "table" and (text.Content or tostring(text)) or tostring(text)

    -- Issue 17: notification card — AcrylicMain bg, auto-height, 310px wide, Fluent layout
    local card = Make("Frame", {
        Name             = "Notify" .. _notifyCount,
        Size             = UDim2.new(1, 0, 0, 0),
        AutomaticSize    = Enum.AutomaticSize.Y,
        BackgroundColor3 = self.Scheme.BackgroundColor,  -- AcrylicMain as bg
        BorderSizePixel  = 0,
        BackgroundTransparency = 0.1,  -- slightly transparent (approx acrylic)
    }, notifyHolder)
    AddCorner(card, 8)
    local _notifyStroke = Make("UIStroke", {
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Transparency    = 0.5,
        Color           = self.Scheme.OutlineColor,
    }, card)

    -- Title at y=17, 13px Regular (Fluent exact)
    local titleFontFace = SafeFont(FONT_SSM_PATH, Enum.FontWeight.Regular)
    local titleLabel = Make("TextLabel", {
        Size             = UDim2.new(1, -28, 0, 14),
        Position         = UDim2.new(0, 14, 0, 17),
        BackgroundTransparency = 1,
        Text             = title,
        TextColor3       = self.Scheme.FontColor,
        TextSize         = 13,
        Font             = Enum.Font.Gotham,   -- safe fallback
        TextXAlignment   = Enum.TextXAlignment.Left,
        RichText         = true,
    }, card)
    if titleFontFace then pcall(function() titleLabel.FontFace = titleFontFace end) end

    -- Content label holder at y=40 with UIListLayout pad=3 (Fluent exact)
    local notifyLabelHolder = Make("Frame", {
        Size             = UDim2.new(1, -28, 0, 0),
        Position         = UDim2.fromOffset(14, 40),
        AutomaticSize    = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
    }, card)
    Make("UIListLayout", {
        Padding   = UDim.new(0, 3),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, notifyLabelHolder)
    Make("UIPadding", {
        PaddingBottom = UDim.new(0, 12),
    }, notifyLabelHolder)

    local contentFontFace = SafeFont(FONT_SSM_PATH, Enum.FontWeight.Regular)
    local contentLabel = Make("TextLabel", {
        Size             = UDim2.new(1, 0, 0, 0),
        AutomaticSize    = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        Text             = content,
        TextColor3       = self.Scheme.SubtextColor,
        TextSize         = 14,
        Font             = Enum.Font.Gotham,   -- safe fallback
        TextWrapped      = true,
        TextXAlignment   = Enum.TextXAlignment.Left,
        RichText         = true,
        LayoutOrder      = 1,
    }, notifyLabelHolder)
    if contentFontFace then pcall(function() contentLabel.FontFace = contentFontFace end) end

    -- Issue 17: Fluent slide-in animation — card starts off-screen right, slides left
    -- Using Size offset on X to simulate the GroupMotor scale animation
    card.Position = UDim2.new(0, 60, 0, 0)  -- start offset right
    card.BackgroundTransparency = 1
    Tween(card, {
        Position = UDim2.new(0, 0, 0, 0),
        BackgroundTransparency = 0.1,
    }, self.NotifyTweenInfo)

    task.delay(duration, function()
        if card and card.Parent then
            Tween(card, {
                Position = UDim2.new(0, 60, 0, 0),
                BackgroundTransparency = 1,
            }, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In))
            task.wait(0.35)
            if card and card.Parent then card:Destroy() end
        end
    end)
end

