            LayoutOrder           = nextOrder(),   -- BUG 10 FIX
        }, self._content)
        Library:AddToRegistry(lbl, { TextColor3 = "SubtextColor" })
        Library:TrackFont(lbl)
        local el = { _inst = lbl }
        function el:SetText(t) lbl.Text = t end
        function el:SetVisible(v) lbl.Visible = v end
