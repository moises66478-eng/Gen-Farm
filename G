local activeTab     = nil
local tabObjects    = {}

local function setActiveTab(tabObj)
    if activeTab == tabObj then return end
    if activeTab then
        -- Fade out removed: just hide instantly
        local outFrame = activeTab.ContainerFrame
        outFrame.Visible = false
        Tween(activeTab.Button, {
            BackgroundTransparency = 1,
            TextColor3             = Library.Scheme.SubtextColor,
        })
    end
    activeTab = tabObj
    -- BUG 6 FIX: remove the erroneous BackgroundTransparency = 1 line
    activeTab.ContainerFrame.Visible = true
    -- Reposition global selector bar to y-centre of active tab button.
    -- Use a deferred frame so AbsolutePosition is valid after layout.
    selectorBar.Visible = true
    task.defer(function()
        task.wait()  -- BUG 5 FIX: yield until after layout pass
        if activeTab ~= tabObj then return end
        if not tabObj.Button or not tabObj.Button.Parent then return end
        -- AbsolutePosition/AbsoluteSize are in screen pixels (post-UIScale).
        -- selectorBar.Position/Size offsets are logical pixels (pre-UIScale).
        -- Dividing by DPIScale converts screen→logical so the bar lands
        -- correctly at every DPI setting.
        local scale = math.max(Library.DPIScale or 1, 0.01)
        local by  = tabObj.Button.AbsolutePosition.Y / scale
        local bh  = tabObj.Button.AbsoluteSize.Y     / scale
        local fy  = tabFrame.AbsolutePosition.Y      / scale
        selectorBar.Size     = UDim2.fromOffset(4, bh)
        selectorBar.Position = UDim2.fromOffset(0, by - fy + math.floor(bh / 2))
    end)
    -- Issue 10: Use ElementTransparency token, not hardcoded 0.89
    Tween(activeTab.Button, {
        BackgroundTransparency = Library.Scheme.ElementTransparency,
        TextColor3             = Library.Scheme.FontColor,
    })
    tabDisplay.Text = tabObj.Name
end

local function AddTab(name, icon)
    -- Issue 4: use Tab token (MainColor) not AccentColor for background
    -- Issue 7: FontFace GothamSSm Regular, not Enum.Font.Gotham
    local btnFontFace = SafeFont(FONT_SSM_PATH, Enum.FontWeight.Regular)
    local btn = Make("TextButton", {
