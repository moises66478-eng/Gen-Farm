-- SAFE FONT HELPER (fixes crash when Font is unavailable)
-- ═══════════════════════════════════════════════════════════════════
local FONT_SSM_PATH = "rbxasset://fonts/families/GothamSSm.json"

local function SafeFont(path, weight, style)
    local ok2, f = pcall(function()
        return Font.new(path, weight or Enum.FontWeight.Regular, style or Enum.FontStyle.Normal)
    end)
    return ok2 and f or nil
end

-- FIX 1.2: Track font elements for live font-face updates
function Library:TrackFont(inst)
    table.insert(self.FontElements, inst)
end

function Library:UpdateFontElements()
    local fontName = self.FontFace or "Gotham"
    local font = Enum.Font[fontName] or Enum.Font.Gotham
    for _, inst in ipairs(self.FontElements) do
        if inst and inst.Parent then
            pcall(function() inst.Font = font end)
        end
    end
end

