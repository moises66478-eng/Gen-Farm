-- SKILL CHECK MODE — verified working mobile-touch implementation
-- ═══════════════════════════════════════════════════════════════════

local _skillCheckMode     = "No Skill Check"
local _scPerfectHeartbeat = nil
local _scPerfectVis       = nil
local _scGuiWatcher       = nil  -- watches playerGui for new SkillCheckPromptGui

stopPerfectSkillCheck = function()
    if _scPerfectHeartbeat then _scPerfectHeartbeat:Disconnect() _scPerfectHeartbeat = nil end
    if _scPerfectVis       then _scPerfectVis:Disconnect()       _scPerfectVis       = nil end
    if _scGuiWatcher       then _scGuiWatcher:Disconnect()       _scGuiWatcher       = nil end
end

local _SC_ACTION_PATH = "Survivor-mob.Controls.action.check"

local function getActionTarget()
    local current = playerGui
    for segment in string.gmatch(_SC_ACTION_PATH, "[^%.]+") do
        current = current and current:FindFirstChild(segment)
    end
    return current
end

local _SC_TOUCH_ID = 8822

local function triggerMobileButton()
    local b = getActionTarget()
    if not b or not b:IsA("GuiObject") then return end
    local p, s = b.AbsolutePosition, b.AbsoluteSize
    local inset = game:GetService("GuiService"):GetGuiInset()
    local cx = p.X + (s.X / 2) + inset.X
    local cy = p.Y + (s.Y / 2) + inset.Y
    pcall(function()
        local VIM = game:GetService("VirtualInputManager")
        VIM:SendTouchEvent(_SC_TOUCH_ID, 0, cx, cy)
        task.wait(0.01)
        VIM:SendTouchEvent(_SC_TOUCH_ID, 2, cx, cy)
    end)
end

-- Wire up a single SkillCheckPromptGui instance.
-- Called each time a new prompt appears (each round creates a fresh one).
local function hookSkillCheckGui(prompt)
    -- Clear any previous per-check connections (not the gui watcher)
    if _scPerfectHeartbeat then _scPerfectHeartbeat:Disconnect() _scPerfectHeartbeat = nil end
    if _scPerfectVis       then _scPerfectVis:Disconnect()       _scPerfectVis       = nil end

    local check = prompt:FindFirstChild("Check", true)
    if not check then return end
    local line  = check:FindFirstChild("Line")
    local goal  = check:FindFirstChild("Goal")
    if not line or not goal then return end

    -- Shared helper: starts the per-check heartbeat.
    -- Extracted so it can be called both from the Visible signal AND
    -- immediately below for the already-visible case (Bug 1 fix).
    local function startCheckHeartbeat()
        if _scPerfectHeartbeat then _scPerfectHeartbeat:Disconnect() end
        _scPerfectHeartbeat = RunService.Heartbeat:Connect(function()
            if _skillCheckMode ~= "Perfect Skill Check" then return end
            if not check.Visible then return end
            pcall(function()
                local lr = line.Rotation % 360
                local gr = goal.Rotation % 360
                local ss = (gr + 101) % 360
                local se = (gr + 115) % 360
                local inZone = ss > se and (lr >= ss or lr <= se)
                                       or  (lr >= ss and lr <= se)
                if inZone then
                    if _scPerfectHeartbeat then
                        _scPerfectHeartbeat:Disconnect()
                        _scPerfectHeartbeat = nil
                    end
                    triggerMobileButton()
                end
            end)
        end)
    end

    _scPerfectVis = check:GetPropertyChangedSignal("Visible"):Connect(function()
        if _skillCheckMode ~= "Perfect Skill Check" then return end
        local team = player.Team
        if not team or team.Name ~= "Survivors" then return end

        if check.Visible then
            startCheckHeartbeat()
        else
            if _scPerfectHeartbeat then
                _scPerfectHeartbeat:Disconnect()
                _scPerfectHeartbeat = nil
            end
        end
    end)

    -- Bug 1 fix: if Check.Visible is ALREADY true when hookSkillCheckGui runs
    -- (Autofarm enabled mid-repair, or skill check appeared during the 0.1 s
    -- task.wait in ChildAdded), the Visible signal never fires and the heartbeat
    -- never starts. Kick it off immediately here to cover that case.
    if check.Visible and _skillCheckMode == "Perfect Skill Check" then
        startCheckHeartbeat()
    end
end

local function startPerfectSkillCheck()
    stopPerfectSkillCheck()

    -- Hook any already-existing prompt (handles script re-execute mid-round)
    -- FIX: only watch the actual SkillCheckPromptGui, ignore the -con variant
    local existing = playerGui:FindFirstChild("SkillCheckPromptGui")
    if existing then hookSkillCheckGui(existing) end

    -- Watch for NEW prompts appearing across ALL rounds.
    -- Each round destroys and recreates the GUI, so WaitForChild alone
    -- would only catch the first instance. ChildAdded fires every time.
    -- FIX: ignore -con variants entirely.
    _scGuiWatcher = playerGui.ChildAdded:Connect(function(child)
        if child.Name == "SkillCheckPromptGui" then
            -- Small delay so the Check frame children have time to appear
            task.wait(0.1)
            hookSkillCheckGui(child)
        end
    end)

    -- ★ BUG 2 FIX: re-scan after arming the watcher to catch GUIs that arrived
    -- during the gap between stopPerfectSkillCheck and ChildAdded:Connect.
    -- No task.wait here: existing children are fully constructed already.
    -- The 0.1s delay belongs only in the ChildAdded callback (new children
    -- may not have descendants yet), not here.
    -- FIX: ignore -con variants.
    for _, child in ipairs(playerGui:GetChildren()) do
        if child.Name == "SkillCheckPromptGui" then
            hookSkillCheckGui(child)
            break  -- only one prompt can exist at a time
        end
    end
end

