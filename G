-- REMOTE EVENTS — wrapped in a background thread so they only connect
-- after the remotes have resolved (no nil errors).
-- ═══════════════════════════════════════════════════════════════════
task.spawn(function()
    -- Wait until all remote references are non‑nil before connecting.
    while not (RoundRemote and TimeUpdateEvent and allGenDone) do
        if Library.Unloaded then return end
        task.wait(0.2)
    end

    -- ─── all gens done ────────────────────────────────────────────
    allGenDone.OnClientEvent:Connect(function()
        if autoFarmEnabled and not escaping and isInLiveRound() then
            local mn = getMapName()
            if mn then doEscape(mn, "all gens done") end
        end
    end)

    -- ─── Round remote ─────────────────────────────────────────────
    RoundRemote.OnClientEvent:Connect(function(active)
        roundSetByRemote = true
        roundActive = (active == true)
        if active == true then
            cancelCurrentRepair()
            escaping = false killerNearby = false evading = false
            roundStartTime = os.clock()
            -- Re-hook skill check watcher: SkillCheckPromptGui is destroyed
            -- and recreated each round, so the previous WaitForChild is stale.
            if _skillCheckMode == "Perfect Skill Check" then
                startPerfectSkillCheck()
            end
            if autoFarmEnabled and not farmRunning then task.spawn(runFarm) end
        else
            cancelCurrentRepair()
        end
    end)

    -- ─── Time update remote ───────────────────────────────────────
    TimeUpdateEvent.OnClientEvent:Connect(function(state, time)
        if state == "Round" and type(time) == "number" then
            roundSetByRemote = true roundActive = true escaping = false
            if time >= 880 then roundStartTime = os.clock() - (900 - time) end
            if _skillCheckMode == "Perfect Skill Check" then
                startPerfectSkillCheck()
            end
            if autoFarmEnabled and not farmRunning then task.spawn(runFarm) end
        elseif state == "Intermission" then
            roundSetByRemote = true roundActive = false
        end
    end)
end)

-- ─── Last survivor watcher (runs independently) ──────────────────
task.spawn(function()
    while task.wait(1) do
        if Library.Unloaded then break end
        if autoFarmEnabled and not escaping and not evading and farming and isInLiveRound() then
            if isLastSurvivor() then
                local mn = getMapName()
                if mn then doEscape(mn, "last survivor") end
            end
        end
    end
end)

-- ─── Init ─────────────────────────────────────────────────────────

Library._UIReady = true

-- ════════════════════ FIX: ensure window is visible from start ═══
mainFrame.Visible = true
Library.Toggled   = true
-- ══════════════════════════════════════════════════════════════════

task.spawn(function()
    -- Wait for character so game services are ready
    if not player.Character then
        player.CharacterAdded:Wait()
    end
    task.wait(0.5)

    -- Wait for map UI (up to 5 retries, 1s apart)
    local mn = nil
    for _ = 1, 5 do
        mn = getMapName()
        if mn then break end
        task.wait(1)
    end
    LabelMap:SetText("Map: " .. (mn or "Unknown"))

    -- Wait for UI construction to fully complete.
    -- We use the explicit _UIReady flag set after all controls are added.
    local ready = false
    for _ = 1, 60 do  -- up to 60 × 0.25s = 15s
        if Library._UIReady then
            ready = true
            break
        end
        task.wait(0.25)
    end

    if not ready then
        warn("[GenFarm] Init: UI never finished constructing (_UIReady missing after 15s)")
        -- Show the window anyway so the GUI is not permanently hidden
        mainFrame.Visible = true
        Library.Toggled   = true
    end

    -- One extra frame so any element added after _UIReady also settles
    task.wait(0.1)

    -- Load custom themes so theme names resolve for config restoration
    pcall(function() ThemeManager:ReloadCustomThemes() end)

    -- Autoload config FIRST — before LoadDefault so theme application
    -- cannot overwrite values that the config just restored.
    -- Root cause identified: ThemeManager:LoadDefault() calls ApplyTheme()
    -- which calls picker:SetValue() on all 5 color pickers, firing their
    -- callbacks and overwriting whatever Load() just set for those keys.
    -- By loading config before applying the default theme, the restored
    -- values survive. ThemeList:SetValue() inside Load() then triggers
    -- ApplyTheme for the saved theme — which is correct behavior.
    local autoConfig = SaveManager:GetAutoloadConfig()
    warn("[GenFarm] Init: autoload name = '" .. tostring(autoConfig) .. "'")
    warn("[GenFarm] Init: autoload file raw = " .. tostring(safeReadFile("GenFarm/AutoloadConfig.txt")))

    if autoConfig ~= "none" and autoConfig ~= "" then
        local configPath = "GenFarm/Configs/" .. autoConfig .. ".json"
        local rawConfig  = safeReadFile(configPath)
        warn("[GenFarm] Init: config path = " .. configPath)
        warn("[GenFarm] Init: config file exists = " .. tostring(rawConfig ~= nil))

        if rawConfig then
            local decodeOk, decoded = pcall(function() return HttpService:JSONDecode(rawConfig) end)
            warn("[GenFarm] Init: JSON decode ok = " .. tostring(decodeOk))
            if decodeOk and type(decoded) == "table" then
                warn("[GenFarm] Init: entry count = " .. #decoded)
                -- Print every key in the saved JSON so mismatches are visible
                for i, entry in ipairs(decoded) do
                    if type(entry) == "table" then
                        warn(string.format("[GenFarm] Init: saved[%d] idx='%s' type='%s'",
                            i, tostring(entry.idx), tostring(entry.type)))
                    end
                end
            end
        end

        local loaded, reason = SaveManager:Load(autoConfig)
        warn("[GenFarm] Init: Load result = " .. tostring(loaded) .. " reason = " .. tostring(reason))
        if not loaded then
            task.wait(0.5)
            warn("[GenFarm] Init: retrying Load...")
            loaded, reason = SaveManager:Load(autoConfig)
            warn("[GenFarm] Init: retry result = " .. tostring(loaded) .. " reason = " .. tostring(reason))
        end
        if loaded then
            pcall(function() Library.Options["ConfigList"]:SetValue(autoConfig) end)
            Library.SelectedConfig = autoConfig
        else
            warn("[GenFarm] Autoload failed: " .. tostring(reason))
            -- Config failed — fall back to default theme
            pcall(function() ThemeManager:LoadDefault() end)
        end
    else
        warn("[GenFarm] Init: no autoload config set")
        -- No autoload — apply default theme normally
        pcall(function() ThemeManager:LoadDefault() end)
    end

    -- Restore circle state last so the config-embedded position (if any)
    -- has already been applied by Load() above. The standalone file is a
    -- fallback for when no config is loaded.
    pcall(loadCircleState)
    pcall(function()
        if Library.Options["CircleSize"] then
            Library.Options["CircleSize"]:SetValue(_circleSize)
        end
    end)
end)
