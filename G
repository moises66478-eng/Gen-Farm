        local labelRow = Make("Frame", {
            Size             = UDim2.new(1, 0, 0, 20),
            Position         = UDim2.fromOffset(0, 10),
            BackgroundTransparency = 1,
        }, sliderCard)

        -- Issue 7: FontFace Medium 13px
        local textLblFont = SafeFont(FONT_SSM_PATH, Enum.FontWeight.Medium)
        local textLbl = Make("TextLabel", {
            Size             = UDim2.new(1, -80, 1, 0),
            BackgroundTransparency = 1,
            Text             = opts.Text or idx,
            TextColor3       = Library.Scheme.FontColor,
            TextSize         = 13,
            Font             = Enum.Font.Gotham,   -- safe fallback
            TextXAlignment   = Enum.TextXAlignment.Left,
            RichText         = true,
        }, labelRow)
        if textLblFont then pcall(function() textLbl.FontFace = textLblFont end) end
        Library:AddToRegistry(textLbl, { TextColor3 = "FontColor" })

        -- Fix 1: value display auto-sizes to hug the number tightly.
        local LOCK_W = 24   -- width reserved for the lock icon

        -- Fix 4: when opts.Editable = true the value display is a TextBox
        -- so the user can tap the number and type directly. When false (the
        -- default) it stays a read-only TextLabel as before.
        local editable = opts.Editable == true
        local valLbl   -- may be TextLabel or TextBox depending on editable

        if editable then
            local valFont = SafeFont(FONT_SSM_PATH, Enum.FontWeight.SemiBold)
            valLbl = Make("TextBox", {
                Size                = UDim2.new(0, 48, 1, 0),
                AnchorPoint         = Vector2.new(1, 0),
                Position            = UDim2.new(1, -LOCK_W, 0, 0),
                BackgroundTransparency = 1,
                Text                = tostring(value) .. suffix,
                TextColor3          = Library.Scheme.AccentColor,
                TextSize            = 12,
                Font                = Enum.Font.GothamBold,   -- safe fallback
                TextXAlignment      = Enum.TextXAlignment.Right,
                BorderSizePixel     = 0,
                ClearTextOnFocus    = true,
            }, labelRow)
            if valFont then pcall(function() valLbl.FontFace = valFont end) end
            -- No stroke/corner needed since the box is invisible
            Library:AddToRegistry(valLbl, { TextColor3 = "AccentColor" })
            Library:TrackFont(valLbl)
            -- Commit on focus lost: parse the typed number and apply it
            valLbl.FocusLost:Connect(function()
                local stripped = valLbl.Text:gsub("[^%-%.%d]", "")
                local n = tonumber(stripped)
                if n then
                    applyValue(n)
                else
                    valLbl.Text = tostring(sObj.Value) .. suffix
                end
            end)
        else
            local valFont = SafeFont(FONT_SSM_PATH, Enum.FontWeight.SemiBold)
            valLbl = Make("TextLabel", {
                Size             = UDim2.new(0, 0, 1, 0),
                AutomaticSize    = Enum.AutomaticSize.X,
                AnchorPoint      = Vector2.new(1, 0),
                Position         = UDim2.new(1, -LOCK_W, 0, 0),
                BackgroundTransparency = 1,
                Text             = tostring(value) .. suffix,
                TextColor3       = Library.Scheme.AccentColor,
                TextSize         = 12,
                Font             = Enum.Font.GothamBold,   -- safe fallback
                TextXAlignment   = Enum.TextXAlignment.Right,
                RichText         = true,
            }, labelRow)
            if valFont then pcall(function() valLbl.FontFace = valFont end) end
            Library:AddToRegistry(valLbl, { TextColor3 = "AccentColor" })
            Library:TrackFont(valLbl)
        end

        -- Lock icon: only shown on sliders that opt in with ShowLock = true.
        -- This prevents the icon appearing on KillerDistance, CornerRadius,
        -- DPI Scale, etc. where it makes no sense.
        -- When shown: drawn from Frames — no asset IDs, no emoji.
        --   Body  : small filled rounded rectangle (padlock body)
        --   Arch  : rounded frame above, hollowed out to look like a U-ring
        -- UNLOCKED: full opacity, accent color
        -- LOCKED:   dims to 0.55 transparency
        -- CRITICAL: _updateVisual is stored in a plain Lua table (lockState),
        -- NOT as a property of the Roblox Instance — setting arbitrary
        -- properties on a Roblox Instance throws a runtime error that
        -- silently kills the rest of AddSlider, leaving the groupbox empty.
        local noLock   = opts.NoLock   == true
        local showLock = opts.ShowLock == true
        local lockBtn  = nil
        local lockState = { updateVisual = nil }

        -- ── Track, fill, knob ──────────────────────────────────────
        -- Declared BEFORE the showLock block so updateLockVisual()
        -- can safely reference fill/knob when it runs immediately.
        -- Issue 13: SliderRail token, 6px height, positioned below label row
        local track = Make("Frame", {
            Name             = "Track",
            Size             = UDim2.new(1, 0, 0, 6),
            Position         = UDim2.fromOffset(0, 38),
            BackgroundColor3 = Library.Scheme.SliderRail,
            BorderSizePixel  = 0,
        }, sliderCard)
        AddCorner(track, 3)
        Library:AddToRegistry(track, { BackgroundColor3 = "SliderRail" })

        local fill = Make("Frame", {
            Name             = "Fill",
            Size             = UDim2.new((value - min)/(max - min), 0, 1, 0),
            BackgroundColor3 = Library.Scheme.AccentColor,
            BorderSizePixel  = 0,
        }, track)
        AddCorner(fill, 2)
        Library:AddToRegistry(fill, { BackgroundColor3 = "AccentColor" })

        -- Issue 13: knob is white (not AccentColor)
        local knob = Make("Frame", {
            Name             = "Knob",
            Size             = UDim2.fromOffset(14, 14),
            AnchorPoint      = Vector2.new(0.5, 0.5),
            Position         = UDim2.new((value - min)/(max - min), 0, 0.5, 0),
            BackgroundColor3 = Color3.new(1, 1, 1),  -- white per Fluent
            BorderSizePixel  = 0,
        }, track)
        AddCorner(knob, 7, true)

        local hitArea = Make("TextButton", {
            Size             = UDim2.new(1, 0, 0, 32),
            Position         = UDim2.new(0, 0, 0.5, -16),
            BackgroundTransparency = 1,
            Text             = "",
            ZIndex           = 3,
        }, track)

        -- ── Lock icon (after track so fill/knob are valid) ─────────
        if showLock then
            lockBtn = Make("TextButton", {
                Name                   = "LockBtn",
                Size                   = UDim2.fromOffset(LOCK_W, 20),
                AnchorPoint            = Vector2.new(1, 0),
                Position               = UDim2.new(1, 0, 0, 0),
                BackgroundTransparency = 1,
                Text                   = "",
                BorderSizePixel        = 0,
                AutoButtonColor        = false,
                ZIndex                 = 3,
            }, labelRow)

            -- Pure white PNG on transparent background uploaded by user.
            -- ImageColor3 = AccentColor recolors it to match the theme.
            -- ImageTransparency dims it on lock. No frame drawing needed.
            local lockIcon = Make("ImageLabel", {
                -- 12×12 icon centred inside the 24×20 hitbox
                Size                   = UDim2.fromOffset(16, 16),
                AnchorPoint            = Vector2.new(0.5, 0.5),
                Position               = UDim2.new(0.5, 0, 0.5, 0),
                BackgroundTransparency = 1,
                Image                  = "rbxassetid://10723434711",
                ImageColor3            = Library.Scheme.AccentColor,
                ImageTransparency      = 0,
                ScaleType              = Enum.ScaleType.Fit,
                BorderSizePixel        = 0,
                ZIndex                 = 4,
            }, lockBtn)
            Library:AddToRegistry(lockIcon, { ImageColor3 = "AccentColor" })

            lockState.updateVisual = function()
                local dim = locked and 0.55 or 0
                lockIcon.ImageTransparency      = dim
                fill.BackgroundTransparency     = locked and 0.5 or 0
                knob.BackgroundTransparency     = locked and 0.5 or 0
            end
            lockState.updateVisual()

            if not noLock then
                lockBtn.Activated:Connect(function()
                    locked = not locked
                    lockState.updateVisual()
                end)
            end
        end

        local sObj = { Value = value, _fill = fill, _knob = knob, _valLbl = valLbl, _col = col, _track = track, _hitArea = hitArea, _card = sliderCard }

        applyValue = function(v)
            local rounded = rounding == 0 and math.round(v) or tonumber(string.format("%." .. rounding .. "f", v))
            rounded = math.clamp(rounded, min, max)
            sObj.Value = rounded
            local pct = (rounded - min) / (max - min)
            fill.Size     = UDim2.new(pct, 0, 1, 0)
            knob.Position = UDim2.new(pct, 0, 0.5, 0)
            valLbl.Text   = tostring(rounded) .. suffix
            SafeCall(callback, rounded)
        end

        -- Drag state. Uses global UserInputService.InputChanged
        -- (same pattern as Fluent's slider implementation) which fires
        -- for ALL mouse movement regardless of cursor position.
        -- No captureFrame needed — the global connection is only active
        -- while this slider is being dragged (dragging flag guard).
        local dragging = false

        local function applyFromPos(pos)
            if locked then return end
            local tp = track.AbsolutePosition.X
            local tw = track.AbsoluteSize.X
            if tw <= 0 then return end
            local pct = math.clamp((pos.X - tp) / tw, 0, 1)
            applyValue(min + pct * (max - min))
        end

        local function onDragBegan(input)
            if locked then return end
            -- Touch-and-hold fix: while GUI movement is unlocked, don't let
            -- this hit area start its own drag — defer to the global
            -- window-drag handler instead of moving the slider thumb.
            if guiDragMode then return end
            if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                applyFromPos(input.Position)
            end
        end

        track.InputBegan:Connect(onDragBegan)
        hitArea.InputBegan:Connect(onDragBegan)
        knob.InputBegan:Connect(onDragBegan)

        -- Global move: fires for ALL mouse movement regardless of cursor position.
        OnSignal(UserInputService.InputChanged, function(input)
            if not dragging then return end
            if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
                applyFromPos(input.Position)
            end
        end)

        -- Global release
        OnSignal(UserInputService.InputEnded, function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)

        -- Lock toggle: wired inside showLock block above for normal sliders.
        -- SetLocked is called externally (e.g. MainHeight/MainWidth always-locked).
        function sObj:SetValue(v) applyValue(v) end
        function sObj:SetVisible(v) col.Visible = v end
        -- BUG 4 FIX: remove destroyCapture call
        function sObj:Destroy() col:Destroy() end
        function sObj:IsLocked() return locked end
        function sObj:SetLocked(v)
            locked = v
            if lockState.updateVisual then
                lockState.updateVisual()
            else
                -- No lock icon on this slider; still dim the track
                fill.BackgroundTransparency = locked and 0.5 or 0
                knob.BackgroundTransparency = locked and 0.5 or 0
            end
        end

        Library.Options[idx] = sObj
        return sObj
    end

    -- ── AddButton ─────────────────────────────────────────────────
    function gb:AddButton(textOrOpts, funcArg)
        local opts = type(textOrOpts) == "table" and textOrOpts or { Text = textOrOpts, Func = funcArg }
        -- Bug 3 fix: when textOrOpts IS a table, funcArg (the 2nd positional
        -- argument) was being silently discarded because callback only ever
        -- read opts.Func/opts.Callback from inside the table. Calls like
        -- AddButton({Text="Unload", Color="Red"}, function() ... end) need
        -- funcArg honored as a fallback so the button actually does something.
        local callback = opts.Func or opts.Callback or funcArg
        local isRed    = (opts.Color == "Red")

        local baseBg   = isRed and Library.Scheme.DangerColor or Library.Scheme.MainColor
        local baseTrans = isRed and 0 or Library.Scheme.ElementTransparency
        local hoverTrans = isRed and 0 or 0.82
        local pressTrans = isRed and 0 or 0.96

        -- Issue 7: FontFace SemiBold, Issue 9: UIStroke 0.5
        local btnFontFace = SafeFont(FONT_SSM_PATH, Enum.FontWeight.SemiBold)
        local btn = Make("TextButton", {
            Name             = "Button",
            Size             = UDim2.new(1, 0, 0, 34),
            BackgroundColor3 = baseBg,
            BackgroundTransparency = baseTrans,
            Text             = opts.Text or "Button",
            TextColor3       = Library.Scheme.FontColor,
            TextSize         = 13,
            Font             = Enum.Font.GothamBold,   -- safe fallback
            BorderSizePixel  = 0,
            AutoButtonColor  = false,
            RichText         = true,
        }, self._content)
        if btnFontFace then pcall(function() btn.FontFace = btnFontFace end) end
        AddCorner(btn, 4)
        local _btnStroke = Make("UIStroke", {
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
            Transparency    = 0.5,
            Color           = Library.Scheme.OutlineColor,
        }, btn)
        Library:AddToRegistry(_btnStroke, { Color = "OutlineColor" })
        if not isRed then
            Library:AddToRegistry(btn, { BackgroundColor3 = "MainColor", TextColor3 = "FontColor" })
            table.insert(Library.ElementRows, btn)  -- Issue 21
        end

        -- Issue 12: HoverFrame overlay (Fluent pattern)
        local _btnHover = Make("Frame", {
            Name             = "HoverFrame",
            Size             = UDim2.fromScale(1, 1),
            BackgroundColor3 = Library.Scheme.HoverColor,
            BackgroundTransparency = 1,
            BorderSizePixel  = 0,
            ZIndex           = 2,
        }, btn)
        AddCorner(_btnHover, 4)
        Library:AddToRegistry(_btnHover, { BackgroundColor3 = "HoverColor" })

        btn.MouseEnter:Connect(function()
            -- Issue 10: use HoverChange token (Dark=0.07 → 1-0.07=0.93, Light=0.16 → 0.84)
            Tween(_btnHover, { BackgroundTransparency = 1 - Library.Scheme.HoverChange })
        end)
        btn.MouseLeave:Connect(function()
            Tween(_btnHover, { BackgroundTransparency = 1 })
        end)
        btn.Activated:Connect(function()
            -- Touch-and-hold fix: while GUI movement is unlocked, any touch
            -- that lands on this button is presumed to be a drag-to-reposition
            -- gesture, not a deliberate tap — defer entirely to the global
            -- drag handler instead of firing the button's callback.
            if guiDragMode then return end
            Tween(_btnHover, { BackgroundTransparency = 1 })
            task.delay(0.12, function()
                if btn and btn.Parent then
                    Tween(_btnHover, { BackgroundTransparency = 1 - Library.Scheme.HoverChange })
                end
            end)
            SafeCall(callback)
        end)

        local bObj = { _inst = btn }
        function bObj:SetText(t) btn.Text = t end
        function bObj:SetVisible(v) btn.Visible = v end
        function bObj:Destroy() btn:Destroy() end
        return bObj
    end

    -- ── AddDropdown ───────────────────────────────────────────────
    function gb:AddDropdown(idx, opts)
        opts = opts or {}
        local values   = opts.Values   or {}
        local callback = opts.Callback or opts.Changed
        local current  = opts.Default  or (values[1] or "")

        local wrapper = Make("Frame", {
            Name             = idx .. "Dropdown",
            Size             = UDim2.new(1, 0, 0, 0),
            AutomaticSize    = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1,
            BorderSizePixel  = 0,
            ClipsDescendants = false,
        }, self._content)

        -- Issue 9: UIStroke 0.5, Issue 14: correct color tokens
        local elementRow = Make("Frame", {
            Name             = "DropdownRow",
            Size             = UDim2.new(1, 0, 0, 0),
            AutomaticSize    = Enum.AutomaticSize.Y,
            BackgroundColor3 = Library.Scheme.MainColor,
            BackgroundTransparency = Library.Scheme.ElementTransparency,
            BorderSizePixel  = 0,
        }, wrapper)
        AddCorner(elementRow, 4)
        local _dropRowStroke = Make("UIStroke", {
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
            Transparency    = 0.5,
            Color           = Library.Scheme.OutlineColor,
        }, elementRow)
        Library:AddToRegistry(_dropRowStroke, { Color = "OutlineColor" })
        AddPadding(elementRow, 0, 10, 0, 10)
        Library:AddToRegistry(elementRow, { BackgroundColor3 = "MainColor" })
        table.insert(Library.ElementRows, elementRow)  -- Issue 21

        -- Issue 8: LabelHolder for dropdown row title
        local _dropLabelHolder = Make("Frame", {
            Name             = "LabelHolder",
            AutomaticSize    = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1,
            Position         = UDim2.fromOffset(0, 0),
            Size             = UDim2.new(1, -170, 0, 0),
        }, elementRow)
        Make("UIListLayout", {
            SortOrder         = Enum.SortOrder.LayoutOrder,
            VerticalAlignment = Enum.VerticalAlignment.Center,
        }, _dropLabelHolder)
        Make("UIPadding", {
            PaddingBottom = UDim.new(0, 13),
            PaddingTop    = UDim.new(0, 13),
        }, _dropLabelHolder)

        -- Issue 7: FontFace Medium 13px
        local dropLabelFont = SafeFont(FONT_SSM_PATH, Enum.FontWeight.Medium)
        local dropLabel = Make("TextLabel", {
            Name             = "TitleLabel",
            Size             = UDim2.new(1, 0, 0, 14),
            BackgroundTransparency = 1,
            Text             = opts.Text or idx,
            TextColor3       = Library.Scheme.FontColor,
            TextSize         = 13,
            Font             = Enum.Font.Gotham,   -- safe fallback
            TextXAlignment   = Enum.TextXAlignment.Left,
            RichText         = true,
            LayoutOrder      = 1,
        }, _dropLabelHolder)
        if dropLabelFont then pcall(function() dropLabel.FontFace = dropLabelFont end) end
        Library:AddToRegistry(dropLabel, { TextColor3 = "FontColor" })

        -- Issue 14: DropdownFrame token for bar background
        local bar = Make("TextButton", {
            Name             = "Bar",
            Size             = UDim2.fromOffset(160, 28),
            AnchorPoint      = Vector2.new(1, 0.5),
            Position         = UDim2.new(1, 0, 0.5, 0),
            BackgroundColor3 = Library.Scheme.DropdownFrame,
            BackgroundTransparency = 0.85,
            Text             = "",
            BorderSizePixel  = 0,
            AutoButtonColor  = false,
        }, elementRow)
        AddCorner(bar, 5)
        local _barStroke = Make("UIStroke", {
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
            Transparency    = 0.5,
            Color           = Library.Scheme.OutlineColor,
        }, bar)
        Library:AddToRegistry(_barStroke,  { Color = "OutlineColor" })
        Library:AddToRegistry(bar, { BackgroundColor3 = "DropdownFrame" })

        local barLabelFont = SafeFont(FONT_SSM_PATH, Enum.FontWeight.Regular)
        local barLabel = Make("TextLabel", {
            Size             = UDim2.new(1, -28, 1, 0),
            Position         = UDim2.new(0, 6, 0, 0),
            BackgroundTransparency = 1,
            Text             = tostring(current),
            TextColor3       = Library.Scheme.FontColor,
            TextSize         = 13,
            Font             = Enum.Font.Gotham,   -- safe fallback
            TextXAlignment   = Enum.TextXAlignment.Left,
            RichText         = true,
        }, bar)
        if barLabelFont then pcall(function() barLabel.FontFace = barLabelFont end) end
        Library:AddToRegistry(barLabel, { TextColor3 = "FontColor" })

        Make("TextLabel", {
            Size             = UDim2.fromOffset(22, 34),
            Position         = UDim2.new(1, -24, 0, 0),
            BackgroundTransparency = 1,
            Text             = "▼",
            TextColor3       = Library.Scheme.SubtextColor,
            TextSize         = 11,
            Font             = Enum.Font.SourceSans,
        }, bar)

        -- Dropdown popup list: styled to match the surrounding groupbox exactly.
        -- Uses MainColor + ElementTransparency (same as every element row) so the
        -- popup blends naturally with the section it appears inside instead of
        -- showing a solid black/dark rectangle that looks detached from the theme.
        local ITEM_H = 32
        local list = Make("ScrollingFrame", {
            Name                 = "List",
            Size                 = UDim2.new(1, 0, 0, 0),
            Position             = UDim2.new(0, 0, 0, 40),
            BackgroundColor3     = Library.Scheme.MainColor,
            BackgroundTransparency = Library.Scheme.ElementTransparency,
            BorderSizePixel      = 0,
            Visible              = false,
            ZIndex               = 10,
            ClipsDescendants     = true,
            ScrollBarThickness   = 3,
            ScrollBarImageColor3 = Library.Scheme.AccentColor,
            CanvasSize           = UDim2.new(0, 0, 0, 0),
            ScrollingDirection   = Enum.ScrollingDirection.Y,
        }, wrapper)
        -- Same corner radius as element rows (4px) so the popup looks like
        -- a natural extension of the row that opened it.
        AddCorner(list, 4)
        local _listStroke = Make("UIStroke", {
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
            Transparency    = 0.5,
            Color           = Library.Scheme.OutlineColor,
        }, list)
        Library:AddToRegistry(_listStroke, { Color = "OutlineColor" })
        AddListLayout(list, Enum.FillDirection.Vertical, 0)
        -- Register both BackgroundColor3 and track in ElementRows so the
        -- popup stays in sync when the theme or ElementTransparency changes.
        Library:AddToRegistry(list, { BackgroundColor3 = "MainColor" })
        table.insert(Library.ElementRows, list)

        local open = false
        local dObj = { Value = current }
        local parentScroll = nil -- cached parent ScrollingFrame while open

        local function closeList()
            list.Visible = false
            open = false
            -- FIX 3.4: re-enable parent column scrolling
            if parentScroll then
                pcall(function() parentScroll.ScrollingEnabled = true end)
                parentScroll = nil
            end
        end

        local function setValue(v)
            dObj.Value  = v
            current     = v
            barLabel.Text = tostring(v)
            closeList()
            SafeCall(callback, v)
        end

        local function rebuildList()
            for _, ch in ipairs(list:GetChildren()) do
                if ch:IsA("TextButton") then ch:Destroy() end
            end
            for _, v in ipairs(values) do
                local itemFont = SafeFont(FONT_SSM_PATH, Enum.FontWeight.Regular)
                -- Item rows: transparent background so the list's own MainColor
                -- background shows through. On hover we tint via HoverFrame.
                -- Text uses FontColor (same as every other label) not DropdownOption,
                -- which keeps items readable on every theme.
                local item = Make("TextButton", {
                    Size             = UDim2.new(1, 0, 0, ITEM_H),
                    BackgroundColor3 = Library.Scheme.MainColor,
                    BackgroundTransparency = 1,  -- fully transparent; list bg shows through
                    Text             = tostring(v),
                    TextColor3       = Library.Scheme.FontColor,
                    TextSize         = 12,
                    Font             = Enum.Font.Gotham,   -- safe fallback
                    BorderSizePixel  = 0,
                    AutoButtonColor  = false,
                    ZIndex           = 11,
                }, list)
                if itemFont then pcall(function() item.FontFace = itemFont end) end
                Library:AddToRegistry(item, { BackgroundColor3 = "MainColor", TextColor3 = "FontColor" })
                -- Subtle hover tint using HoverColor (matches toggle/button hover behaviour)
                item.MouseEnter:Connect(function()
                    Tween(item, { BackgroundTransparency = 1 - (1 - Library.Scheme.ElementTransparency) * 0.6 })
                end)
                item.MouseLeave:Connect(function()
                    Tween(item, { BackgroundTransparency = 1 })
                end)
                -- FIX 3.6: .Activated on dropdown item buttons
                item.Activated:Connect(function()
                    setValue(v)
                end)
            end
            local totalH = #values * ITEM_H
            local clampH = math.min(totalH, 130)
            list.CanvasSize = UDim2.new(0, 0, 0, totalH)
            list.Size       = UDim2.new(1, 0, 0, clampH)
        end
        rebuildList()

        -- FIX 3.6: .Activated on the dropdown bar itself
        bar.Activated:Connect(function()
            -- Touch-and-hold fix: while GUI movement is unlocked, any touch
            -- on the bar is presumed to be a drag-to-reposition gesture —
            -- defer to the global drag handler instead of opening the list.
            if guiDragMode then return end
            open = not open
            list.Visible = open
            if open then
                -- FIX 3.4: disable parent column scroll so dropdown scroll doesn't fight it
                parentScroll = getParentScroll(wrapper)
                if parentScroll then
                    pcall(function() parentScroll.ScrollingEnabled = false end)
                end
            else
                closeList()
            end
        end)

        function dObj:SetValue(v) setValue(v) end
        function dObj:SetValues(vs)
            values = vs or {}
            if current ~= "" and not table.find(values, current) then current = values[1] or "" end
            rebuildList()
            barLabel.Text = tostring(current)
            dObj.Value = current
        end
        function dObj:SetVisible(v) wrapper.Visible = v end
        function dObj:Destroy() wrapper:Destroy() end

        Library.Options[idx] = dObj
        return dObj
    end

    -- ── AddInput ──────────────────────────────────────────────────
    function gb:AddInput(idx, opts)
        opts = opts or {}
        local callback = opts.Callback or opts.Changed
        local wrapper = Make("Frame", {
