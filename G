-- CIRCLE PERSISTENCE  (Feature 1 + 2)
-- Saves/loads circle size AND position so the button stays put across
-- sessions when "Lock circle position" is enabled with an autoload config.
-- ═══════════════════════════════════════════════════════════════════

local _circlePersistFile = "GenFarm/CircleState.json"
local _circleSize = 56  -- legacy alias; actual size in _iconStackSize above

saveCircleState = function()
    safeMkdir("GenFarm")
    local pos = iconStack.Position
    local data = {
        sizeX  = iconStack.Size.X.Offset,
        sizeY  = iconStack.Size.X.Offset,  -- store the per-icon size (width = per-icon sz)
        xScale = pos.X.Scale,
        xOff   = pos.X.Offset,
        yScale = pos.Y.Scale,
        yOff   = pos.Y.Offset,
        locked = lockCirclePos,
    }
    local ok2, json = pcall(function() return HttpService:JSONEncode(data) end)
    if ok2 then safeWriteFile(_circlePersistFile, json) end
end

loadCircleState = function()
    local raw = safeReadFile(_circlePersistFile)
    if not raw then return end
    local ok2, data = pcall(function() return HttpService:JSONDecode(raw) end)
    if not ok2 or type(data) ~= "table" then return end
    -- restore size
    local sz = data.sizeX or 56
    applyIconStackSize(sz)
    -- restore position
    if data.xScale ~= nil then
        iconStack.Position = UDim2.new(
            data.xScale or 0, data.xOff or 0,
            data.yScale or 0, data.yOff or 0
        )
    end
    -- restore lock state
    if data.locked == true then
        lockCirclePos = true
        if Library.Toggles["LockCirclePos"] then
            Library.Toggles["LockCirclePos"]:SetValue(true)
        end
    end
end

-- Bug 10 fix: real implementations of the forward-declared accessors used
-- by SaveManager:Save/:Load. These read/apply the SAME data shape as
-- saveCircleState/loadCircleState so a named config's __CirclePosition
-- entry and the fallback CircleState.json file always agree.
_getCirclePositionData = function()
    local pos = iconStack.Position
    return {
        sizeX  = _iconStackSize,
        sizeY  = _iconStackSize,
        xScale = pos.X.Scale,
        xOff   = pos.X.Offset,
        yScale = pos.Y.Scale,
        yOff   = pos.Y.Offset,
        locked = lockCirclePos,
    }
end

_applyCirclePositionData = function(data)
    if type(data) ~= "table" then return end
    -- restore size
    local sz = data.sizeX or _iconStackSize
    applyIconStackSize(sz)
    if Library.Options["CircleSize"] then
        Library.Options["CircleSize"]:SetValue(sz)
    end
    -- restore position
    if data.xScale ~= nil then
        iconStack.Position = UDim2.new(
            data.xScale or 0, data.xOff or 0,
            data.yScale or 0, data.yOff or 0
        )
    end
    -- restore lock state
    if data.locked == true then
        lockCirclePos = true
        if Library.Toggles["LockCirclePos"] then
            Library.Toggles["LockCirclePos"]:SetValue(true)
        end
    else
        lockCirclePos = false
        if Library.Toggles["LockCirclePos"] then
            Library.Toggles["LockCirclePos"]:SetValue(false)
        end
    end
    -- Also write through to the fallback CircleState.json file so a plain
    -- re-launch (without explicitly loading this config again) still has
    -- the latest position available via loadCircleState().
    saveCircleState()
end

