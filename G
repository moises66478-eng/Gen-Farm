-- UNLOAD (relocated — see explanation left at the old location)
--
-- This is now declared AFTER circleGui (and circleBtn), AFTER screenGui
-- and notifyGui, and AFTER every farm-state local (autoFarmEnabled,
-- farming, farmRunning, escaping, evading, killerNearby, tweening,
-- currentRepairTarget). All of those are real upvalues here, so
-- setting them actually stops the running farm loop, and destroying
-- circleGui actually removes the moveable circle button.
-- ═══════════════════════════════════════════════════════════════════

-- Forward declarations for functions defined later in the skill check block.
-- Library:Unload (below) calls these; their bodies are assigned further down.
local stopPerfectSkillCheck

function Library:Unload()
    -- Mark unloaded FIRST: every background task.spawn loop in this
    -- script (the last-survivor watcher, runFarm's self-respawn via
    -- task.spawn(runFarm), etc.) checks Library.Unloaded and breaks/
    -- returns immediately when it's true. Setting it before anything
    -- else guarantees no new loop iteration starts after this point.
    Library.Unloaded = true

    -- Stop all farm state — these are real upvalues now, not globals,
    -- so the running runFarm() loop actually sees farming = false /
    -- escaping = true on its next check and exits instead of looping
    -- forever in the background.
    autoFarmEnabled      = false
    farming               = false
    farmRunning           = false
    escaping              = true
    evading               = false
    killerNearby          = false
    tweening              = false

    -- Cancel any in-flight generator repair so the server-side repair
    -- state doesn't keep ticking after the script is gone. Capture the
    -- target BEFORE nilling currentRepairTarget, otherwise this check
    -- would always be false and the cancel would never actually fire.
    local _pendingRepairTarget = currentRepairTarget
    currentRepairTarget = nil
    pcall(function()
        if _pendingRepairTarget then
            RepairEvent:FireServer(_pendingRepairTarget, false)
        end
    end)

    -- Disconnect ALL tracked signals (Heartbeat/RenderStepped/Stepped/
    -- Input connections registered via OnSignal throughout the script).
    -- Stop skill check heartbeat
    stopPerfectSkillCheck()

    for _, conn in ipairs(Library.Signals) do
        pcall(function() conn:Disconnect() end)
    end
    Library.Signals = {}

    -- Destroy every GUI this script created: main window, the
    -- moveable circle toggle button, and the notification stack.
    -- circleGui is a real upvalue here (declared above), so this
    -- actually removes the circle — fixing the core Bug 1 complaint.
    pcall(function() if screenGui then screenGui:Destroy() end end)
    pcall(function() if circleGui then circleGui:Destroy() end end)
    pcall(function() if notifyGui then notifyGui:Destroy() end end)

    -- Restore cursor in case Custom Cursor was enabled.
    pcall(function() UserInputService.MouseIconEnabled = true end)

    -- Clear all state tables so nothing in the script can still
    -- reference stale UI elements after teardown.
    Library.Options      = {}
    Library.Toggles      = {}
    Library.Registry     = {}
    Library.Corners      = {}
    Library.FontElements = {}
end

