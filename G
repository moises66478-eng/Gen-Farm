-- ─── Acrylic / blur effect ────────────────────────────────────────
local _acrylicDOF = nil

local function setAcrylic(enable)
    if enable then
        if _acrylicDOF then return end  -- already active
        local dof = Instance.new("DepthOfFieldEffect")
        dof.FarIntensity  = 0
        dof.InFocusRadius = 0.1
        dof.NearIntensity = 1
        dof.Parent = game:GetService("Lighting")
        _acrylicDOF = dof
        -- With blur active: let theme color show at 0.45 transparency
        Tween(bgFrame, { BackgroundTransparency = 0.45 })
        -- gradFrame stays at 0.4 always – do NOT touch it here
    else
        if _acrylicDOF then
            _acrylicDOF:Destroy()
            _acrylicDOF = nil
        end
        -- Without blur: bgFrame fully opaque so theme color is solid and clear
        Tween(bgFrame, { BackgroundTransparency = 0 })
        -- gradFrame stays at 0.4 always – do NOT touch it here
    end
end

