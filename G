-- ─── _MakeSection: Fluent-exact section (no card, no border, no shadow) ──────
-- A Section is just an 18px SemiBold heading + an invisible content container.
-- NO background, NO border, NO stroke, NO shadow, NO title line.
function Library:_MakeSection(parent, name)
    -- Section root: fully invisible, auto-sizes to heading + content
    local sectionRoot = Make("Frame", {
        Name                   = name .. "SectionRoot",
        Size                   = UDim2.new(1, 0, 0, 26),
        BackgroundTransparency = 1,
        BorderSizePixel        = 0,
    }, parent)

    -- Section heading: Issue 6 — rbxassetid://12187365364 SemiBold 18px (Fluent exact)
    local headingFontFace = SafeFont(FONT_SSM_PATH, Enum.FontWeight.SemiBold)
    local heading = Make("TextLabel", {
        Name                   = "SectionTitle",
        Size                   = UDim2.new(1, -16, 0, 18),
        Position               = UDim2.fromOffset(0, 2),
        BackgroundTransparency = 1,
        Text                   = name,
        TextColor3             = Library.Scheme.FontColor,
        TextSize               = 18,
        Font                   = Enum.Font.GothamBold,   -- safe fallback
        TextXAlignment         = Enum.TextXAlignment.Left,
        TextYAlignment         = Enum.TextYAlignment.Center,
        RichText               = true,
    }, sectionRoot)
    if headingFontFace then pcall(function() heading.FontFace = headingFontFace end) end
    Library:AddToRegistry(heading, { TextColor3 = "FontColor" })

    -- Content container: invisible, starts at y=24 (below heading+gap), UIListLayout pad=5
    local contentLayout = Make("UIListLayout", {
        Padding   = UDim.new(0, 5),
        SortOrder = Enum.SortOrder.LayoutOrder,
    })

    local content = Make("Frame", {
        Name                   = name .. "Content",
        Size                   = UDim2.new(1, 0, 0, 0),
        Position               = UDim2.fromOffset(0, 24),
        BackgroundTransparency = 1,
        BorderSizePixel        = 0,
    }, sectionRoot)
    contentLayout.Parent = content

    -- Auto-size root based on content.
    -- IMPORTANT: AbsoluteContentSize is in screen pixels (post-UIScale).
    -- UDim2 offsets are in logical pixels (pre-UIScale). Dividing by
    -- DPIScale converts back to logical pixels so UIScale doesn't
    -- double-shrink the layout at non-100% DPI settings.
    local function refreshSectionSize()
        local scale   = math.max(Library.DPIScale or 1, 0.01)
        local logical = contentLayout.AbsoluteContentSize.Y / scale
        content.Size     = UDim2.new(1, 0, 0, logical)
        sectionRoot.Size = UDim2.new(1, 0, 0, logical + 25)
    end
    contentLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(refreshSectionSize)
    -- Deferred initial measurement: fire after one frame so Roblox has
    -- completed its first layout pass and AbsoluteContentSize is non-zero.
    task.defer(function() task.wait() refreshSectionSize() end)

    local gb = {
        _content    = content,
        _holder     = sectionRoot,  -- compat alias
        _shadow     = nil,
        _stroke     = nil,
        _sectionRoot = sectionRoot,
        _itemIdx    = 0,   -- BUG 10 FIX: layout order counter
    }

    local function nextOrder()
        gb._itemIdx += 1
        return gb._itemIdx
    end

