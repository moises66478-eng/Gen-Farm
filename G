local function hexToColor3(hex)
    hex = hex:gsub("#", "")
    local r = tonumber(hex:sub(1,2), 16) or 255
    local g = tonumber(hex:sub(3,4), 16) or 255
    local b = tonumber(hex:sub(5,6), 16) or 255
    return Color3.fromRGB(r, g, b)
end

local function color3ToHex(c)
    return string.format("%02x%02x%02x",
        math.floor(c.R * 255 + 0.5),
        math.floor(c.G * 255 + 0.5),
        math.floor(c.B * 255 + 0.5))
end

-- FIX 1.3 / 2.2 / 2.3: ALL file I/O wrapped in pcall
-- Bug 1 fix (this pass): safeMkdir/safeWriteFile used to discard the
-- pcall's success boolean entirely — `pcall(function() writefile(...) end)`
-- with no return meant a caller had ZERO way to know whether the write
-- actually happened. If writefile ever threw (missing parent folder on a
-- fresh executor profile, a path-validation quirk, anything), the error
-- was silently eaten and every caller (SaveAutoloadConfig, SaveManager:Save,
-- ThemeManager:SaveCustomTheme, etc.) still showed a "success" notification
-- because none of them were checking a return value that didn't actually
-- exist. That exactly matches the reported symptom: "Set as autoload
-- confirms success, but nothing auto-loads after rejoining" — the
-- notification firing was never actually proof the file was written.
-- Both helpers now return true/false so every caller can verify and
-- report real failures instead of false positives.
local function safeMkdir(path)
    local ok2 = pcall(function() makefolder(path) end)
    return ok2
end

local function safeReadFile(path)
    local ok2, data = pcall(function() return readfile(path) end)
    return ok2 and data or nil
end

local function safeWriteFile(path, data)
    local ok2 = pcall(function() writefile(path, tostring(data)) end)
    return ok2
end

local function safeDeleteFile(path)
    local ok2 = pcall(function() delfile(path) end)
    return ok2
end

local function safeListFiles(path)
    local ok2, files = pcall(function() return listfiles(path) end)
    if not ok2 or type(files) ~= "table" then return {} end
    return files
end

function ThemeManager:ApplyTheme(themeData)
    local data
    if type(themeData) == "string" then
        data = self.BuiltinThemes[themeData] or self.CustomThemes[themeData]
        if not data then
            Library:Notify("Theme not found: " .. tostring(themeData), 3)
            return
        end
    else
        data = themeData
    end
    if data.FontColor       then Library.Scheme.FontColor       = hexToColor3(data.FontColor) end
    if data.SubtextColor    then Library.Scheme.SubtextColor    = hexToColor3(data.SubtextColor) end
    if data.MainColor       then Library.Scheme.MainColor       = hexToColor3(data.MainColor) end
    if data.AccentColor     then Library.Scheme.AccentColor     = hexToColor3(data.AccentColor) end
    if data.BackgroundColor then Library.Scheme.BackgroundColor = hexToColor3(data.BackgroundColor) end
    if data.OutlineColor    then Library.Scheme.OutlineColor    = hexToColor3(data.OutlineColor) end

    -- Derived Fluent tokens: recompute from base colors whenever theme changes.
    -- These are not per-theme in VDV's theme tables so we recalculate them here.
    -- MainColor is the "Element"/"Tab" token in Fluent — reuse directly.
    Library.Scheme.Tab           = Library.Scheme.MainColor
    Library.Scheme.ToggleSlider  = Library.Scheme.MainColor
    Library.Scheme.SliderRail    = Library.Scheme.MainColor
    Library.Scheme.DropdownFrame = Library.Scheme.SubtextColor
    Library.Scheme.DropdownHolder= Library.Scheme.BackgroundColor
    Library.Scheme.DropdownBorder= Library.Scheme.OutlineColor
    Library.Scheme.DropdownOption= Library.Scheme.MainColor
    Library.Scheme.KeybindColor  = Library.Scheme.MainColor
    Library.Scheme.HoverColor    = Library.Scheme.MainColor
    Library.Scheme.AcrylicMain   = Library.Scheme.BackgroundColor
    Library.Scheme.AcrylicBorder = Library.Scheme.OutlineColor
    Library.Scheme.Input         = Library.Scheme.BackgroundColor
    Library.Scheme.InputFocused  = Color3.fromRGB(
        math.max(0, math.round(Library.Scheme.BackgroundColor.R * 255) - 20),
        math.max(0, math.round(Library.Scheme.BackgroundColor.G * 255) - 20),
        math.max(0, math.round(Library.Scheme.BackgroundColor.B * 255) - 20))
    Library.Scheme.InputIndicator= Library.Scheme.SubtextColor
    Library.Scheme.TitleBarLine  = Library.Scheme.OutlineColor
    if data.HoverChange  then Library.Scheme.HoverChange  = data.HoverChange end
    -- Issue 20: AcrylicNoise — use theme value if present, otherwise derive
    -- from brightness: dark themes get 0.90 (10% noise), light themes get 0.96
    if data.AcrylicNoise then
        Library.Scheme.AcrylicNoise = data.AcrylicNoise
    else
        local bg = Library.Scheme.BackgroundColor
        local brightness = (bg.R + bg.G + bg.B) / 3
        Library.Scheme.AcrylicNoise = brightness < 0.5 and 0.90 or 0.96
    end
    -- Update AcrylicGradient on the gradient frame
    if fluentGradient and data.AcrylicGradient then
        if typeof(data.AcrylicGradient) == "ColorSequence" then
            fluentGradient.Color = data.AcrylicGradient
        end
    end
    -- Update AcrylicGradient color on the gradient frame to match theme BG
    -- (gradFrame UIGradient Color should reflect AcrylicGradient)
    pcall(function()
        if gradFrame and fluentGradient then
            local bgColor = Library.Scheme.BackgroundColor
            -- Fluent AcrylicGradient: slightly lighter version of AcrylicMain
            local lighter = Color3.fromRGB(
                math.min(255, math.round(bgColor.R * 255) + 15),
                math.min(255, math.round(bgColor.G * 255) + 15),
                math.min(255, math.round(bgColor.B * 255) + 15))
            -- note: this is now superseded by the direct assignment above
        end
    end)

    Library:UpdateColorsUsingRegistry()

    -- Issue 21: Apply ElementTransparency to all tracked element rows.
    -- Uses a dedicated ElementRows registry table populated when each row
    -- is created, instead of fragile name-pattern matching.
    if data.ElementTransparency then
        Library.Scheme.ElementTransparency = data.ElementTransparency
        for _, inst in ipairs(Library.ElementRows or {}) do
            if inst and inst.Parent then
                pcall(function()
                    inst.BackgroundTransparency = data.ElementTransparency
                end)
            end
        end
    end

    -- Bug 5 fix: sync the 5 color picker objects so their swatches AND
    -- internal `value` closures reflect the newly applied theme. Without
    -- this, the swatch keeps showing the last manually-picked color, and
    -- opening that swatch again would read its own stale `value` and
    -- could revert the just-applied theme color on the next edit.
    local pickerMap = {
        ThemeBgColor      = Library.Scheme.BackgroundColor,
        ThemeMainColor    = Library.Scheme.MainColor,
        ThemeAccentColor  = Library.Scheme.AccentColor,
        ThemeOutlineColor = Library.Scheme.OutlineColor,
        ThemeFontColor    = Library.Scheme.FontColor,
    }
    for idx, color in pairs(pickerMap) do
        local picker = Library.Options[idx]
        if picker and picker.SetValue then
            -- Use the internal setter directly (bypassing the public
            -- :SetValue's callback re-fire) would be ideal, but since the
            -- callback here just re-assigns Library.Scheme to the same
            -- value and calls UpdateColorsUsingRegistry again, calling
            -- SetValue is safe and keeps the swatch + closure in sync.
            picker:SetValue(color)
        end
    end

    Library:Notify("Theme applied!", 2)
end

-- FIX 1.3: SaveCustomTheme — pcall I/O, makefolder before write, notify
function ThemeManager:SaveCustomTheme(name)
    if not name or name == "" then
        Library:Notify("Enter a theme name first.", 3)
        return false
    end
    safeMkdir("GenFarm")
    safeMkdir(_customThemesFolder)
    local data = {
        FontColor       = color3ToHex(Library.Scheme.FontColor),
        MainColor       = color3ToHex(Library.Scheme.MainColor),
        AccentColor     = color3ToHex(Library.Scheme.AccentColor),
        BackgroundColor = color3ToHex(Library.Scheme.BackgroundColor),
        OutlineColor    = color3ToHex(Library.Scheme.OutlineColor),
    }
    local lines = {}
    for k, v in pairs(data) do table.insert(lines, k .. "=" .. v) end
    local writeOk = safeWriteFile(_customThemesFolder .. "/" .. name .. ".theme", table.concat(lines, "\n"))
    if not writeOk then
        Library:Notify("Failed to save theme — check executor file permissions.", 4)
        return false
    end
    self.CustomThemes[name] = data
    Library:Notify("Theme saved: " .. name, 2)
    return true
end

function ThemeManager:DeleteCustomTheme(name)
    if not name or name == "" then return end
    safeDeleteFile(_customThemesFolder .. "/" .. name .. ".theme")
    self.CustomThemes[name] = nil
    Library:Notify("Theme deleted: " .. name, 2)
end

-- FIX 1.3: ReloadCustomThemes handles nil/empty listfiles gracefully
function ThemeManager:ReloadCustomThemes()
    self.CustomThemes = {}
    safeMkdir("GenFarm")
    safeMkdir(_customThemesFolder)
    local files = safeListFiles(_customThemesFolder)
    local names = {}
    for _, path in ipairs(files) do
        local fname = tostring(path)
        local tname = fname:match("([^/\\]+)%.theme$")
        if tname then
            local raw = safeReadFile(fname) or safeReadFile(_customThemesFolder .. "/" .. tname .. ".theme")
            if raw then
                local themeData = {}
                for line in raw:gmatch("[^\n]+") do
                    local k, v = line:match("^(.-)=(.+)$")
                    if k and v then themeData[k] = v:match("^%s*(.-)%s*$") end
                end
                self.CustomThemes[tname] = themeData
                table.insert(names, tname)
            end
        end
    end
    return names
end

function ThemeManager:SaveDefault(name)
    safeMkdir("GenFarm")
    local writeOk = safeWriteFile(_defaultThemeFile, tostring(name or "Default"))
    if writeOk then
        Library:Notify("Default theme set: " .. tostring(name), 2)
    else
        Library:Notify("Failed to save default theme — check executor file permissions.", 4)
    end
    return writeOk
end

-- FIX 1.4: LoadDefault falls back to built-in "Default" if file missing/invalid
function ThemeManager:LoadDefault()
    local name = safeReadFile(_defaultThemeFile)
    if name then name = name:match("^%s*(.-)%s*$") end
    if not name or name == "" then name = "Dark" end

    if self.BuiltinThemes[name] then
        self:ApplyTheme(name)
        if Library.Options["ThemeList"] then
            Library.Options["ThemeList"]:SetValue(name)
        end
    elseif self.CustomThemes[name] then
        self:ApplyTheme(name)
    else
        -- Fall back to Dark and update dropdown
        self:ApplyTheme("Dark")
        if Library.Options["ThemeList"] then
            Library.Options["ThemeList"]:SetValue("Dark")
        end
    end
end

