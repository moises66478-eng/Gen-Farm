-- ═══════════════════════════════════════════════════════════════════

local SaveManager = {}
local _configFolder = "GenFarm/Configs"
local _autoloadFile = "GenFarm/AutoloadConfig.txt"

SaveManager.Parser = {
    Toggle = {
        Save = function(idx, obj) return { type="Toggle", idx=idx, value=obj.Value } end,
        Load = function(obj, data)
            if obj and data.value ~= nil then
                pcall(function() obj:SetValue(data.value == true or data.value == "true") end)
            end
        end,
    },
    Slider = {
        Save = function(idx, obj) return { type="Slider", idx=idx, value=tostring(obj.Value) } end,
        Load = function(obj, data)
            if obj and data.value then pcall(function() obj:SetValue(tonumber(data.value) or 0) end) end
        end,
    },
    Dropdown = {
        Save = function(idx, obj) return { type="Dropdown", idx=idx, value=obj.Value or "" } end,
        Load = function(obj, data)
            if obj and data.value then pcall(function() obj:SetValue(data.value) end) end
        end,
    },
    ColorPicker = {
        Save = function(idx, obj)
            local hex = color3ToHex(obj.Value or Color3.new(1,1,1))
            return { type="ColorPicker", idx=idx, value=hex, transparency=obj.Transparency or 0 }
        end,
        Load = function(obj, data)
            if obj and data.value then
                local hex = data.value
                local r2 = tonumber(hex:sub(1,2),16) or 255
                local g2 = tonumber(hex:sub(3,4),16) or 255
                local b2 = tonumber(hex:sub(5,6),16) or 255
                pcall(function() obj:SetValue(Color3.fromRGB(r2, g2, b2)) end)
            end
        end,
    },
    Input = {
        Save = function(idx, obj) return { type="Input", idx=idx, text=obj.Value or "" } end,
        Load = function(obj, data)
            if obj and data.text then pcall(function() obj:SetValue(data.text) end) end
        end,
    },
    KeyPicker = {
        Save = function(idx, obj)
            return { type="KeyPicker", idx=idx, key=tostring(obj.Value and obj.Value.Name or "Unknown") }
        end,
        Load = function(obj, data)
            if obj and data.key then
                pcall(function()
                    local kc = Enum.KeyCode[data.key]
                    if kc then obj:SetValue(kc) end
                end)
            end
        end,
    },

}

-- Bug 10 fix: forward declarations so SaveManager:Save/:Load (defined
-- below, before circleBtn exists) can read/apply the circle's position
-- as part of a named config's JSON. Real bodies are assigned right after
-- circleBtn is created, same pattern as saveCircleState/loadCircleState.
local _getCirclePositionData
local _applyCirclePositionData

-- FIX 2.1: Save using HttpService:JSONEncode, pcall-wrapped
function SaveManager:Save(name)
    if not name or name == "" then
        Library:Notify("Enter a config name first.", 3)
        return false, "No config name"
    end
    safeMkdir("GenFarm")
    safeMkdir(_configFolder)
    local entries = {}
    for idx, obj in pairs(Library.Toggles) do
        pcall(function() table.insert(entries, SaveManager.Parser.Toggle.Save(idx, obj)) end)
    end
    -- GUITransparency is intentionally excluded: transparency is session-only
    -- and must always start at 0% (opaque) on every launch.
    local _doNotSave = { GUITransparency = true }

    for idx, obj in pairs(Library.Options) do
        if obj.Value ~= nil and not _doNotSave[idx] then
            local t = type(obj.Value)
            pcall(function()
                if t == "boolean" then
                    table.insert(entries, SaveManager.Parser.Toggle.Save(idx, obj))
                elseif t == "number" then
                    table.insert(entries, SaveManager.Parser.Slider.Save(idx, obj))
                elseif t == "string" then
                    if obj._inst and obj._inst:IsA("TextBox") then
                        table.insert(entries, SaveManager.Parser.Input.Save(idx, obj))
                    else
                        table.insert(entries, SaveManager.Parser.Dropdown.Save(idx, obj))
                    end
                elseif t == "userdata" then
                    if typeof(obj.Value) == "Color3" then
                        table.insert(entries, SaveManager.Parser.ColorPicker.Save(idx, obj))
                    else
                        table.insert(entries, SaveManager.Parser.KeyPicker.Save(idx, obj))
                    end
                end
            end)
        end
    end
    -- Bug 10 fix: embed circle position (and size/lock state) directly
    -- into THIS named config's JSON, not just the separate always-on
    -- CircleState.json fallback file. This way "config" really does mean
    -- everything, and loading a different config can restore a different
    -- circle position. We never save `locked = true` without also saving
    -- the actual coordinates alongside it.
    if _getCirclePositionData then
        local circleData = _getCirclePositionData()
        if circleData then
            table.insert(entries, {
                type   = "__CirclePosition",
                idx    = "__CirclePosition",
                xScale = circleData.xScale,
                xOff   = circleData.xOff,
                yScale = circleData.yScale,
                yOff   = circleData.yOff,
                sizeX  = circleData.sizeX,
                sizeY  = circleData.sizeY,
                locked = circleData.locked,
            })
        end
    end

    local ok2, json = pcall(function() return HttpService:JSONEncode(entries) end)
    if not ok2 then
        Library:Notify("Config encode failed.", 3)
        return false, "Encode error"
    end
    -- Bug 1 fix (same root cause as autoload): verify the write actually
    -- succeeded instead of unconditionally notifying success and
    -- returning true regardless of what writefile actually did.
    local writeOk = safeWriteFile(_configFolder .. "/" .. name .. ".json", json)
    if not writeOk then
        Library:Notify("Failed to save config — check executor file permissions.", 4)
        return false, "Write failed"
    end
    Library:Notify("Config saved: " .. name, 2)
    return true
end-- FIX 2.3: Load using HttpService:JSONDecode, checks file existence
function SaveManager:Load(name)
    if not name or name == "" then
        Library:Notify("No config selected.", 3)
        return false, "No config name"
    end
    local path = _configFolder .. "/" .. name .. ".json"
    local raw = safeReadFile(path)
    if not raw then
        Library:Notify("Config not found: " .. name, 3)
        warn("[GenFarm] Load: file not found at path: " .. path)
        return false, "Not found"
    end
    local ok2, entries = pcall(function() return HttpService:JSONDecode(raw) end)
    if not ok2 or type(entries) ~= "table" then
        Library:Notify("Config parse error.", 3)
        warn("[GenFarm] Load: JSON decode failed for: " .. name)
        return false, "Parse error"
    end

    -- ── Diagnostics ────────────────────────────────────────────────
    -- Count registered options and toggles BEFORE loading so we can
    -- detect whether the UI was fully built when Load ran.
    local optCount  = 0
    local togCount  = 0
    for _ in pairs(Library.Options)  do optCount += 1 end
    for _ in pairs(Library.Toggles)  do togCount += 1 end
    warn(string.format(
        "[GenFarm] Load '%s': %d entries in JSON | %d Options | %d Toggles",
        name, #entries, optCount, togCount
    ))

    -- Log every registered key so we can spot mismatches at a glance
    local optKeys = {}
    for k in pairs(Library.Options)  do table.insert(optKeys,  k) end
    local togKeys = {}
    for k in pairs(Library.Toggles)  do table.insert(togKeys,  k) end
    table.sort(optKeys) table.sort(togKeys)
    warn("[GenFarm] Options keys: " .. table.concat(optKeys,  ", "))
    warn("[GenFarm] Toggles keys: " .. table.concat(togKeys,  ", "))

    local applied = 0
    for i, data in ipairs(entries) do
        if type(data) == "table" and data.idx then
            if data.idx == "__CirclePosition" then
                if _applyCirclePositionData then
                    local ok3, err3 = pcall(_applyCirclePositionData, data)
                    if ok3 then
                        applied += 1
                        warn("[GenFarm]   [" .. i .. "] __CirclePosition ✓")
                    else
                        warn("[GenFarm]   [" .. i .. "] __CirclePosition ✗ " .. tostring(err3))
                    end
                else
                    warn("[GenFarm]   [" .. i .. "] __CirclePosition ✗ (_applyCirclePositionData nil)")
                end

            else
                local inOptions = Library.Options[data.idx] ~= nil
                local inToggles = Library.Toggles[data.idx] ~= nil
                local obj       = Library.Toggles[data.idx] or Library.Options[data.idx]
                local parser    = obj and SaveManager.Parser[data.type]
                local status
                if not obj then
                    status = "✗ NOT IN Options/Toggles"
                elseif not parser then
                    status = "✗ NO PARSER for type='" .. tostring(data.type) .. "'"
                else
                    local ok3, err3 = pcall(parser.Load, obj, data)
                    if ok3 then
                        applied += 1
                        status = "✓ Applied"
                    else
                        status = "✗ Parser.Load error: " .. tostring(err3)
                    end
                end
                warn(string.format(
                    "[GenFarm]   [%d] %-20s type=%-12s Opt=%s Tog=%s %s",
                    i, data.idx, tostring(data.type),
                    inOptions and "✓" or "✗",
                    inToggles and "✓" or "✗",
                    status
                ))
            end
        else
            warn("[GenFarm]   [" .. i .. "] Invalid entry: " .. tostring(data))
        end
    end
    -- ── End diagnostics ────────────────────────────────────────────

    if applied == 0 then
        -- File was valid JSON but nothing matched Library.Options/Toggles.
        -- This almost always means the UI hasn't finished constructing yet
        -- (race condition) — the caller should wait and retry.
        warn("[GenFarm] Load: applied=0 — all entries missed. Check keys above.")
        return false, "No settings applied"
    end

    Library:Notify("Config loaded: " .. name .. " (" .. applied .. " settings)", 2)
    return true
end

function SaveManager:Delete(name)
    if not name or name == "" then return end
    safeDeleteFile(_configFolder .. "/" .. name .. ".json")
    Library:Notify("Config deleted: " .. name, 2)
end

-- FIX 2.2: RefreshConfigList — pcall around listfiles, empty fallback
function SaveManager:RefreshConfigList()
    safeMkdir("GenFarm")
    safeMkdir(_configFolder)
    local files = safeListFiles(_configFolder)
    local names = {}
    for _, path in ipairs(files) do
        local fname = tostring(path)
        local n = fname:match("([^/\\]+)%.json$")
        if n then table.insert(names, n) end
    end
    return names
end

function SaveManager:GetAutoloadConfig()
    local raw = safeReadFile(_autoloadFile)
    if not raw then return "none" end
    -- Strip all leading/trailing whitespace including \r and \n.
    -- Using gsub rather than match so we never return nil on a
    -- whitespace-only string.
    local name = raw:gsub("^[%s\r\n]+", ""):gsub("[%s\r\n]+$", "")
    if name == "" then return "none" end
    return name
end

function SaveManager:SaveAutoloadConfig(name)
    safeMkdir("GenFarm")
    -- Write twice with a yield between: some executors buffer writefile
    -- calls and the first write may not flush to disk before the next
    -- read. Writing twice means at least one lands durably.
    -- We do NOT read back to verify — an immediate readfile after
    -- writefile can return stale content on buffering executors, making
    -- the verify always fail even when the write succeeded.
    local ok1 = safeWriteFile(_autoloadFile, tostring(name))
    task.wait(0.05)
    local ok2 = safeWriteFile(_autoloadFile, tostring(name))
    return ok1 or ok2  -- true if either write didn't throw
end

function SaveManager:DeleteAutoLoadConfig()
    safeDeleteFile(_autoloadFile)
end

