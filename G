-- ─── Mobile repair-start helpers ──────────────────────────────────
-- Instead of calling RepairEvent:FireServer(point, true) directly
-- (which bypasses the skill check prompt entirely), we tap the action
-- button in the same way the player would on mobile. This makes the
-- game spawn the skill check prompt naturally, which the existing
-- Perfect Skill Check heartbeat can then handle.

local _REPAIR_ACTION_PATH = "Survivor-mob.Controls.action"
local _REPAIR_ICON_PATH   = "Survivor-mob.Controls.action.repair"
local _REPAIR_TOUCH_ID    = 8821  -- different from _SC_TOUCH_ID (8822)

-- Walk PlayerGui by dot-path and return the instance, or nil
function Farm.getGuiByPath(path)
    local cur = playerGui
    for seg in string.gmatch(path, "[^%.]+") do
        cur = cur and cur:FindFirstChild(seg)
    end
    return cur
end

-- Tap a GuiObject at its centre using a touch-down + touch-up event
function Farm.tapGuiObject(obj, touchId)
    if not obj or not obj:IsA("GuiObject") then return false end
    local p, s   = obj.AbsolutePosition, obj.AbsoluteSize
    local inset  = game:GetService("GuiService"):GetGuiInset()
    local cx = p.X + (s.X / 2) + inset.X
    local cy = p.Y + (s.Y / 2) + inset.Y
    pcall(function()
        local VIM = game:GetService("VirtualInputManager")
        VIM:SendTouchEvent(touchId, 0, cx, cy)
        task.wait(0.01)
        VIM:SendTouchEvent(touchId, 2, cx, cy)
    end)
    return true
end

-- Wait up to `timeout` seconds for the repair icon to appear inside
-- the action button. Returns true when visible, false if timed out.
function Farm.waitForRepairIcon(timeout)
    local deadline = tick() + (timeout or 3)
    while tick() < deadline do
        if not farming or escaping then return false end
        local icon = Farm.getGuiByPath(_REPAIR_ICON_PATH)
        -- The repair icon is present when it exists and has an image
        if icon and icon.Visible ~= false then
            local img = icon:IsA("ImageLabel") and icon.Image or ""
            if img ~= "" then return true end
        end
        task.wait(0.05)
    end
    return false
end

-- Tap the action button to start repair (instead of direct FireServer).
-- Returns true if the button was found and tapped.
function Farm.tapRepairButton()
    local actionBtn = Farm.getGuiByPath(_REPAIR_ACTION_PATH)
    return Farm.tapGuiObject(actionBtn, _REPAIR_TOUCH_ID)
end

function Farm.cancelCurrentRepair()
    if currentRepairTarget then
        -- Bug 2 fix: repair was started via Farm.tapRepairButton (VirtualInputManager
        -- touch events). Firing RepairEvent false alone may not fully end the
        -- interaction on the server if it was opened through the ProximityPrompt
        -- path. Send a touch-end on the same ID used to start repair so the
        -- prompt's HoldEnded / TriggerEnded fires too, then yield one frame so
        -- both signals reach the server before any tween moves the character.
        pcall(function()
            local actionBtn = Farm.getGuiByPath(_REPAIR_ACTION_PATH)
            if actionBtn and actionBtn:IsA("GuiObject") then
                local p, s  = actionBtn.AbsolutePosition, actionBtn.AbsoluteSize
                local inset = game:GetService("GuiService"):GetGuiInset()
                local cx = p.X + (s.X / 2) + inset.X
                local cy = p.Y + (s.Y / 2) + inset.Y
                local VIM = game:GetService("VirtualInputManager")
                -- Touch-end (phase 2) on the repair touch ID releases the hold
                VIM:SendTouchEvent(_REPAIR_TOUCH_ID, 2, cx, cy)
            end
        end)
        pcall(function() RepairEvent:FireServer(currentRepairTarget, false) end)
        currentRepairTarget = nil
        -- One-frame yield so both the touch-end and FireServer reach the server
        -- before the caller tweens the character away.
        task.wait()
    end
end

function Farm.tweenToCFrame(targetCF)
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum  = char and char:FindFirstChild("Humanoid")
    if not root then return end
    if hum then hum.WalkSpeed = 0 hum.JumpHeight = 0 end
    tweening = true

    -- Three-phase movement: down → horizontal → up.
    -- Each phase executes in 20 steps (near-instant).
    -- Camera type is set to Custom so the player retains camera
    -- control and the view doesn't snap on root.CFrame writes.
    local cam = workspace.CurrentCamera
    -- Always force Custom so camera stays user-controllable during and
    -- after the tween. Restoring prevCamType was the bug: if the camera
    -- was previously Scriptable (from another system), restoring it
    -- would re-lock the camera.
    cam.CameraType = Enum.CameraType.Custom

    local startCF = root.CFrame
    local startY  = startCF.Position.Y
    local targetY = targetCF.Position.Y
    local midY    = math.min(startY, targetY) - 2  -- dip below both endpoints

    -- Phase 1: dip down to midY
    local downCF = CFrame.new(startCF.Position.X, midY, startCF.Position.Z)
        * (startCF - startCF.Position)
    for step = 1, 20 do
        if not farming or escaping then break end
        root.CFrame = startCF:Lerp(downCF, step / 20)
        task.wait()
    end

    -- Phase 2: slide horizontally at midY to target XZ
    local midCF = CFrame.new(targetCF.Position.X, midY, targetCF.Position.Z)
        * (targetCF - targetCF.Position)
    for step = 1, 20 do
        if not farming or escaping then break end
        root.CFrame = downCF:Lerp(midCF, step / 20)
        task.wait()
    end

    -- Phase 3: rise up to target Y
    for step = 1, 20 do
        if not farming or escaping then break end
        root.CFrame = midCF:Lerp(targetCF, step / 20)
        task.wait()
    end

    root.CFrame = targetCF
    tweening = false
    if hum then hum.WalkSpeed = 16 hum.JumpHeight = 7.2 end
    task.wait(0.1)
end

-- ─── NEW: underground tween with proximity check (replaces Farm.goToModel for gen approach) ──
function Farm.tweenToGenWithProximityCheck(targetCF)
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum  = char and char:FindFirstChild("Humanoid")
    if not root then return false end
    if hum then hum.WalkSpeed = 0 hum.JumpHeight = 0 end

    local cam = workspace.CurrentCamera
    cam.CameraType = Enum.CameraType.Custom

    local startCF  = root.CFrame
    -- FIX: compute underground Y as 10 studs below the lower of the two endpoints
    local startY  = startCF.Position.Y
    local targetY = targetCF.Position.Y
    local UNDERGROUND_Y = math.min(startY, targetY) - 10

    -- Phase 1: dip to underground
    local underCF = CFrame.new(startCF.Position.X, UNDERGROUND_Y, startCF.Position.Z)
        * (startCF - startCF.Position)
    for step = 1, 20 do
        if not farming or escaping then
            if hum then hum.WalkSpeed = 16 hum.JumpHeight = 7.2 end
            return false
        end
        root.CFrame = startCF:Lerp(underCF, step / 20)
        task.wait()
    end

    -- Phase 2: slide underground to target XZ
    local midCF = CFrame.new(targetCF.Position.X, UNDERGROUND_Y, targetCF.Position.Z)
        * (targetCF - targetCF.Position)
    for step = 1, 20 do
        if not farming or escaping then
            if hum then hum.WalkSpeed = 16 hum.JumpHeight = 7.2 end
            return false
        end
        root.CFrame = underCF:Lerp(midCF, step / 20)
        task.wait()
    end

    -- Proximity check while underground (before surfacing)
    if killerDistanceSetting > 0 and Farm.isKillerClose() then
        -- Stay underground, restore movement, signal caller to evade
        root.CFrame = midCF
        if hum then hum.WalkSpeed = 16 hum.JumpHeight = 7.2 end
        return false
    end

    -- Phase 3: rise to generator point
    for step = 1, 20 do
        if not farming or escaping then
            if hum then hum.WalkSpeed = 16 hum.JumpHeight = 7.2 end
            return false
        end
        root.CFrame = midCF:Lerp(targetCF, step / 20)
        task.wait()
    end

    root.CFrame = targetCF
    if hum then hum.WalkSpeed = 16 hum.JumpHeight = 7.2 end
    task.wait(0.1)
    return true
end

function Farm.goToModel(model)
    if not model or not model.Parent then return end
    local point = Farm.getBestPoint(model)
    if point then
        Farm.tweenToCFrame(point.CFrame + Vector3.new(0, 3, 0))
    else
        local ok2, pivot = pcall(function() return model:GetPivot() end)
        if ok2 then Farm.tweenToCFrame(pivot + Vector3.new(0, 3, 0)) end
    end
end

function Farm.goToPos(pos)
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum  = char and char:FindFirstChild("Humanoid")
    if not root then return end
    if hum then hum.WalkSpeed = 0 hum.JumpHeight = 0 end
    local startCF = root.CFrame
    local targetCF = CFrame.new(pos) + Vector3.new(0, 3, 0)
    for step = 1, 60 do
        if not farming or escaping then break end
        root.CFrame = startCF:Lerp(targetCF, step / 60)
        task.wait()
    end
    root.CFrame = targetCF
    if hum then hum.WalkSpeed = 16 hum.JumpHeight = 7.2 end
    task.wait(0.3)
end

