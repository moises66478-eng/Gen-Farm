function Farm.stealthWait(model, mapName, forcePermanent)
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum  = char and char:FindFirstChild("Humanoid")

    local ok2, pivot = pcall(function() return model:GetPivot() end)
    local genPos = ok2 and pivot.Position or (root and root.Position) or Vector3.new(0,0,0)

    if stealthHitCount >= 2 or forcePermanent then
        Farm.updateStatus("Stealth — permanent caution...")
        local kr = Farm.getKillerRoot()
        local killerPos = kr and kr.Position or genPos
        if root then
            local away = (genPos - killerPos)
            away = away.Magnitude > 0.1 and away.Unit or Vector3.new(1, 0, 0)
            root.CFrame = CFrame.new(genPos + away * 18 + Vector3.new(0, 6, 0))
        end
        if hum then hum.WalkSpeed = 0 hum.JumpHeight = 0 end
        while farming and not escaping do
            if not Farm.isInLiveRound() then
                if hum then hum.WalkSpeed = 16 hum.JumpHeight = 7.2 end
                return false
            end
            if Farm.getPlayerHealth() < 10 then
                if hum then hum.WalkSpeed = 16 hum.JumpHeight = 7.2 end
                Farm.doEscape(mapName, "low health")
                return false
            end
            if Farm.killerDistance() >= 15 then break end
            task.wait(0.3)
        end
        if hum then hum.WalkSpeed = 16 hum.JumpHeight = 7.2 end
        return true
    else
        Farm.updateStatus("Stealth — repositioning...")
        local kr = Farm.getKillerRoot()
        local killerPos = kr and kr.Position or genPos
        if root then
            local toGen = (genPos - killerPos)
            local lateral
            if toGen.Magnitude > 0.1 then
                lateral = Vector3.new(-toGen.Z, 0, toGen.X).Unit
            else
                lateral = Vector3.new(1, 0, 0)
            end
            root.CFrame = CFrame.new(genPos + lateral * 12 + Vector3.new(0, 6, 0))
        end
        if hum then hum.WalkSpeed = 0 hum.JumpHeight = 0 end
        while farming and not escaping do
            if not Farm.isInLiveRound() then
                if hum then hum.WalkSpeed = 16 hum.JumpHeight = 7.2 end
                return false
            end
            if Farm.getPlayerHealth() < 10 then
                if hum then hum.WalkSpeed = 16 hum.JumpHeight = 7.2 end
                Farm.doEscape(mapName, "low health")
                return false
            end
            if Farm.killerDistance() >= 15 then break end
            task.wait(0.3)
        end
        if hum then hum.WalkSpeed = 16 hum.JumpHeight = 7.2 end
        return true
    end
end

function Farm.waitForRepairComplete(model, genIndex, genModels, timeout, mapName, lockedPoint)
    local point = lockedPoint
    local noProgFor, nilProgFor = 0, 0
    local lastProg = -1
    local elapsed  = 0
    local progressSeenFor = 0
    local everMoved, noMoveFor = false, 0
    local stealthCloseFor = 0
    local lastHealth = Farm.getPlayerHealth()

    -- Suggestion: lock joystick during repair so the player can't drift
    -- away from the generator point. Restored on every exit path below.
    local function lockMovement()
        local char = player.Character
        local hum  = char and char:FindFirstChild("Humanoid")
        if hum then hum.WalkSpeed = 0 hum.JumpHeight = 0 end
    end
    local function unlockMovement()
        local char = player.Character
        local hum  = char and char:FindFirstChild("Humanoid")
        if hum then hum.WalkSpeed = 16 hum.JumpHeight = 7.2 end
    end
    lockMovement()

    local function exitWith(result)
        unlockMovement()
        return result
    end

    local function retweenAndRetap()
        -- Repair stalled. Stay at the current point and retap to restart.
        -- Per user preference: restarting in place is better than tweening
        -- away — let the killer's proximity trigger generator switching.
        if not point or not point.Parent then return exitWith(false) end
        unlockMovement()
        task.wait(0.1)
        local iconVis = Farm.waitForRepairIcon(3)
        if not iconVis then
            lockMovement()
            return false
        end
        local tapped = Farm.tapRepairButton()
        lockMovement()
        return tapped
    end

    while elapsed < timeout do
        if not farming or escaping       then Farm.cancelCurrentRepair() return exitWith(false) end
        if not Farm.isInLiveRound()           then Farm.cancelCurrentRepair() return exitWith(false) end
        if Farm.countDone(genModels) >= GENS_REQUIRED then Farm.cancelCurrentRepair() return exitWith(false) end
        if Farm.isLastSurvivor()              then Farm.cancelCurrentRepair() return exitWith(false) end

        if Farm.getPlayerHealth() < 10 then
            Farm.cancelCurrentRepair()
            Farm.doEscape(mapName, "low health")
            return exitWith(false)
        end

        if killerDistanceSetting == 0 then
            local dist = Farm.killerDistance()
            local health = Farm.getPlayerHealth()
            local healthDrop = lastHealth - health
            lastHealth = health

            local shouldPause = false
            if healthDrop > 0 then shouldPause = true end
            if dist <= 15 and Farm.isGenRegressing(model) then shouldPause = true end
            if dist <= 15 then
                stealthCloseFor += 0.2
                if stealthCloseFor >= 6 then shouldPause = true end
            else
                stealthCloseFor = 0
            end

            if shouldPause then
                Farm.cancelCurrentRepair()
                if healthDrop > 0 then stealthHitCount += 1 end
                Farm.updateStatus("Stealth pause — waiting...")
                Farm.updateRepair(0)
                local resume = Farm.stealthWait(model, mapName, stealthHitCount >= 2)
                if not resume then return exitWith(false) end
                if escaping then return exitWith(false) end
                stealthCloseFor = 0
                lastHealth = Farm.getPlayerHealth()
                -- Retween to the LOCKED point (not Farm.getBestPoint which may drift)
                if not point or not point.Parent then return exitWith(false) end
                currentRepairTarget = point
                -- Tap action button to restart repair after stealth pause
                local iconVis = Farm.waitForRepairIcon(3)
                if not iconVis or not Farm.tapRepairButton() then return exitWith(false) end
                Farm.updateStatus("Waiting for gen " .. genIndex .. "...")
                everMoved = false noMoveFor = 0 noProgFor = 0
                progressSeenFor = 0 lastProg = -1
            end
        else
            if Farm.isKillerClose() then
                killerNearby = true
                -- Explicitly stop repair server-side before any movement
                Farm.cancelCurrentRepair()
                return exitWith(false)
            end
        end

        if not model.Parent then
            currentRepairTarget = nil
            Farm.updateRepair(100)
            return exitWith(true)
        end
        if Farm.isGenPaused(model) then
            Farm.cancelCurrentRepair()
            Farm.updateStatus("Gen " .. genIndex .. " paused, skipping")
            Farm.updateRepair(0)
            return exitWith(false)
        end

        local progress = Farm.getGenProgress(model)
        if type(progress) == "number" then
            nilProgFor = 0
            Farm.updateRepair(progress)
            if progress >= 100 then
                currentRepairTarget = nil
                Farm.updateRepair(100)
                return exitWith(true)
            end
            if progress > 0 then
                progressSeenFor += 0.2
                everMoved = true
                noMoveFor = 0
            else
                if not everMoved then
                    noMoveFor += 0.2
                    if noMoveFor >= 15 then
                        Farm.cancelCurrentRepair()
                        Farm.updateStatus("Gen " .. genIndex .. " not starting, retrying")
                        Farm.updateRepair(0)
                        return exitWith(false)
                    end
                end
            end
            local stallLimit = progress >= 95 and 30 or 15
            if progressSeenFor >= 5 then
                if math.abs(progress - lastProg) < 0.05 then
                    noProgFor += 0.2
                    if noProgFor >= stallLimit then
                        -- Progress stalled — tween back to point and retap
                        -- (handles joystick drift away from generator)
                        Farm.cancelCurrentRepair()
                        Farm.updateStatus("Gen " .. genIndex .. " stalled — returning")
                        Farm.updateRepair(0)
                        local restarted = retweenAndRetap()
                        if not restarted then return exitWith(false) end
                        if not farming or escaping then return exitWith(false) end
                        currentRepairTarget = point
                        noProgFor = 0 lastProg = -1
                        progressSeenFor = 0 everMoved = false noMoveFor = 0
                    end
                else
                    noProgFor = 0
                end
            end

            -- ★ BUG 1 FIX: detect regression (skill check failure) immediately
            if progressSeenFor >= 2 and progress < (lastProg - 0.1) then
                Farm.cancelCurrentRepair()
                Farm.updateStatus("Gen " .. genIndex .. " regressing — retapping")
                Farm.updateRepair(0)
                local restarted = retweenAndRetap()
                if not restarted then return exitWith(false) end
                if not farming or escaping then return exitWith(false) end
                currentRepairTarget = point
                noProgFor = 0 lastProg = -1 progressSeenFor = 0
                everMoved = false noMoveFor = 0
            end

            lastProg = progress  -- ★ moved to the end so the regression check compares against previous value
        else
            nilProgFor += 0.2
            if nilProgFor >= 15 then
                Farm.cancelCurrentRepair()
                Farm.updateStatus("Gen " .. genIndex .. " unreadable, retrying")
                Farm.updateRepair(0)
                return exitWith(false)
            end
        end
        task.wait(0.2)
        elapsed += 0.2
    end
    Farm.cancelCurrentRepair()
    return exitWith(false)
end

function Farm.evadeAndWait(genModels, currentIdx, mapName)
    evading = true
    Farm.cancelCurrentRepair()

    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum  = char and char:FindFirstChild("Humanoid")
    if not root then evading = false return nil end

    local killerRoot = Farm.getKillerRoot()
    local killerPos  = killerRoot and killerRoot.Position

    local bestModel, bestIdx, bestDist = nil, nil, math.huge
    for idx, model in ipairs(genModels) do
        if idx == currentIdx then continue end
        if Farm.isGenDone(model) then continue end
        if not model or not model.Parent then continue end
        if Farm.isModelOccupied(model) then continue end
        local ok2, pivot = pcall(function() return model:GetPivot() end)
        if not ok2 then continue end
        local gp = pivot.Position
        local distToKiller = killerPos and (gp - killerPos).Magnitude or math.huge
        local distToMe     = (gp - root.Position).Magnitude
        if distToKiller >= 80 and distToMe < bestDist then
            bestDist = distToMe bestModel = model bestIdx = idx
        end
    end

    if not bestModel then
        Farm.updateStatus("All gens near killer, fleeing...")
        if killerPos then
            local away = (root.Position - killerPos)
            away = away.Magnitude > 0.1 and away.Unit or Vector3.new(1, 0, 0)
            local fleeCF = CFrame.new(root.Position + away * 80 + Vector3.new(0, 3, 0))
            if hum then hum.WalkSpeed = 0 hum.JumpHeight = 0 end
            local startCF = root.CFrame
            for step = 1, 60 do
                if not farming or escaping then break end
                root.CFrame = startCF:Lerp(fleeCF, step / 60)
                task.wait()
            end
            if hum then hum.WalkSpeed = 16 hum.JumpHeight = 7.2 end
        end
        while farming and not escaping do
            if not Farm.isInLiveRound() then break end
            if Farm.isLastSurvivor() and mapName then
                evading = false killerNearby = false
                Farm.updateRepair(0)
                Farm.doEscape(mapName, "last survivor")
                return nil
            end
            if Farm.killerDistance() > 80 then break end
            task.wait(0.3)
        end
        killerNearby = false evading = false Farm.updateRepair(0)
        return nil
    end

    Farm.updateStatus("Killer! Moving to safer gen " .. bestIdx .. "...")
    -- Use underground tween with proximity check
    local evadePoint = Farm.getBestPoint(bestModel)
    local evadeTargetCF = evadePoint and (evadePoint.CFrame + Vector3.new(0, 3, 0))
    if not evadeTargetCF then
        local ok2, pivot = pcall(function() return bestModel:GetPivot() end)
        if not ok2 then evading = false Farm.updateRepair(0) return nil end
        evadeTargetCF = CFrame.new(pivot.Position + Vector3.new(0, 3, 0))
    end
    local arrived = Farm.tweenToGenWithProximityCheck(evadeTargetCF)
    if not arrived then
        killerNearby = true evading = false Farm.updateRepair(0)
        return nil
    end

    if Farm.killerDistance() <= 80 then
        killerNearby = true evading = false Farm.updateRepair(0)
        return nil
    end
    killerNearby = false

    if escaping or not farming or not Farm.isInLiveRound() then evading = false return nil end
    if Farm.isLastSurvivor() then
        evading = false
        Farm.doEscape(mapName, "last survivor")
        return nil
    end
    if Farm.isGenDone(bestModel) or Farm.isModelOccupied(bestModel) then
        evading = false Farm.updateRepair(0) return nil
    end

    local point = evadePoint
    if not point then evading = false Farm.updateRepair(0) return nil end

    Farm.updateStatus("Repairing gen " .. bestIdx .. " (post-evade)...")
    currentRepairTarget = point

    -- Same approach as main loop: wait for repair icon, then tap button.
    local iconVisible = Farm.waitForRepairIcon(3)
    if not iconVisible or not Farm.tapRepairButton() then
        currentRepairTarget = nil evading = false Farm.updateRepair(0)
        return nil
    end

    -- Re-arm skill check watcher now that post-evade repair has started.
    if _skillCheckMode == "Perfect Skill Check" then
        Farm.startPerfectSkillCheck()
    end

    local finished = Farm.waitForRepairComplete(bestModel, bestIdx, genModels, 120, mapName, point)
    if finished then
        Farm.updateStatus("Gen " .. bestIdx .. " complete ✔")
        Farm.updateProgressDisplay(genModels)
    end
    evading = false
    return bestIdx
end

Farm.doEscape = function(mapName, reason)
    if not Farm.isInLiveRound() then return end
    if escaping then return end
    local pos = Farm.getEscapePos(mapName)
    if not pos then
        local freshMap = Farm.getMapName()
        if freshMap then pos = Farm.getEscapePos(freshMap) end
    end
    escaping = true
    Farm.cancelCurrentRepair()
    Farm.updateStatus("Escaping! (" .. reason .. ")")
    Farm.updateRepair(100)
    if pos then
        Farm.updateStatus("Tweening to gate...")
        Farm.goToPos(pos)
        Farm.updateStatus("Escaped! ✔")
    else
        Farm.updateStatus("No escape coords found")
    end
    farming = false farmRunning = false
end

-- ═══════════════════════════════════════════════════════════════════
-- MAIN FARM LOOP — modified to use underground tween and pre‑check killer
-- ═══════════════════════════════════════════════════════════════════

Farm.runFarm = function()
    if farmRunning then return end
    farmRunning = true

    escaping = false killerNearby = false evading = false
    tweening = false currentRepairTarget = nil stealthHitCount = 0

    while true do
        if not autoFarmEnabled then
            farming = false farmRunning = false return
        end
        Farm.syncRoundActive()
        if roundActive then
            if Farm.detectRoundActiveNow() then break end
            Farm.updateStatus("Round ongoing...")
        else
            Farm.updateStatus("Waiting for round...")
        end
        task.wait(1)
    end

    local waitNeeded = 15 - (os.clock() - roundStartTime)
    if waitNeeded > 0 then
        Farm.updateStatus("Loading map...")
        task.wait(waitNeeded)
    end

    if not autoFarmEnabled then farming = false farmRunning = false return end
    if not Farm.detectRoundActiveNow() then
        farmRunning = false
        if autoFarmEnabled then task.spawn(Farm.runFarm) end
        return
    end

    farming = true

    local mapName = Farm.getMapName()
    if not mapName then
        Farm.updateStatus("Couldn't read map!")
        farming = false farmRunning = false return
    end
    LabelMap:SetText("Map: " .. mapName)

    local genModels = Farm.getGenerators()
    if not genModels or #genModels == 0 then
        Farm.updateStatus("No generators found!")
        farming = false farmRunning = false return
    end

    Farm.updateRepair(0)
    Farm.updateProgressDisplay(genModels)

    local lastIndex = nil

    while farming and not escaping do
        if not Farm.isInLiveRound() then
            Farm.cancelCurrentRepair()
            Farm.updateStatus("Waiting for round...")
            break
        end

        local currentMap = Farm.getMapName()
        if currentMap and currentMap ~= mapName then
            mapName = currentMap
            LabelMap:SetText("Map: " .. mapName)
        end

        if Farm.isLastSurvivor() then Farm.doEscape(mapName, "last survivor") break end

        local done = Farm.countDone(genModels)
        if done >= GENS_REQUIRED then Farm.doEscape(mapName, "5 gens done") break end
        Farm.updateProgressDisplay(genModels)

        if killerDistanceSetting > 0 and (killerNearby or Farm.isKillerClose()) then
            killerNearby = true
            Farm.updateStatus("Killer nearby! Evading...")
            Farm.cancelCurrentRepair()
            local repairedIdx = Farm.evadeAndWait(genModels, lastIndex, mapName)
            if escaping then break end
            killerNearby = false
            if repairedIdx then lastIndex = repairedIdx end
            Farm.updateProgressDisplay(genModels)
            continue
        end

        local nextIdx = Farm.pickBestGenIndex(genModels, lastIndex,
            Farm.getOwnedPerkLevel("Perfectionist Planning") ~= nil)
        if not nextIdx then
            if Farm.countDone(genModels) >= GENS_REQUIRED then
                Farm.doEscape(mapName, "5 gens done") break
            end
            Farm.updateStatus("All gens occupied, waiting...")
            task.wait(2)
            continue
        end

        local i     = nextIdx
        local model = genModels[i]

        if Farm.isGenPaused(model) then
            Farm.updateStatus("Gen " .. i .. " paused, skipping")
            lastIndex = i task.wait(1) lastIndex = nil
            continue
        end

        Farm.updateStatus("Moving to gen " .. i)
        Farm.updateRepair(0)

        -- ★ NEW: get the repair point before tweening and use underground tween
        local point = Farm.getBestPoint(model)
        if not point then
            Farm.updateStatus("No point on gen " .. i .. ", skipping")
            lastIndex = i task.wait(0.3) lastIndex = nil
            continue
        end

        local targetCF = point.CFrame + Vector3.new(0, 3, 0)
        local arrived = Farm.tweenToGenWithProximityCheck(targetCF)

        if not arrived then
            -- killer was too close underground; let the top of the loop handle evasion
            killerNearby = killerDistanceSetting > 0 and Farm.isKillerClose()
            if killerNearby then
                Farm.updateStatus("Killer detected during tween, evading...")
                -- cancel any repair (though none should have started)
                Farm.cancelCurrentRepair()
                -- continue will trigger Farm.evadeAndWait at top
            else
                Farm.updateStatus("Tween aborted, retrying...")
            end
            lastIndex = i
            continue
        end

        if escaping or not farming then break end
        if not Farm.isInLiveRound() then Farm.cancelCurrentRepair() break end
        if Farm.isLastSurvivor() then Farm.doEscape(mapName, "last survivor") break end
        if Farm.isGenDone(model) then Farm.updateProgressDisplay(genModels) continue end
        if Farm.isModelOccupied(model) then
            Farm.updateStatus("Gen " .. i .. " taken, finding next...")
            task.wait(0.3) continue
        end

        -- ★ BUG 3 FIX: final killer proximity check BEFORE setting currentRepairTarget
        if killerDistanceSetting > 0 and Farm.isKillerClose() then
            killerNearby = true
            Farm.updateStatus("Killer too close after tween, evading...")
            continue
        end

        Farm.updateStatus("Repairing gen " .. i .. "...")
        currentRepairTarget = point
        lastIndex = i

        -- Wait for the repair icon to appear in the action button,
        -- then tap it so the game spawns the skill check prompt naturally.
        -- Direct FireServer would bypass the prompt entirely.
        local iconVisible = Farm.waitForRepairIcon(3)
        if not iconVisible then
            -- Icon never appeared — generator may be too far, point is wrong,
            -- or the UI is not loaded. Skip and retry next loop.
            Farm.updateStatus("Repair icon not found for gen " .. i .. ", retrying")
            currentRepairTarget = nil lastIndex = nil
            task.wait(0.5) continue
        end

        local tapped = Farm.tapRepairButton()
        if not tapped then
            Farm.updateStatus("Action button not found for gen " .. i .. ", skipping")
            currentRepairTarget = nil lastIndex = nil
            task.wait(1) continue
        end

        -- Re-arm skill check watcher now that repair has started.
        if _skillCheckMode == "Perfect Skill Check" then
            Farm.startPerfectSkillCheck()
        end

        Farm.updateStatus("Waiting for gen " .. i .. "...")
        local finished = Farm.waitForRepairComplete(model, i, genModels, 120, mapName, point)

        if escaping then break end
        if not Farm.isInLiveRound() then Farm.cancelCurrentRepair() break end
        if Farm.isLastSurvivor() then Farm.doEscape(mapName, "last survivor") break end
        if Farm.countDone(genModels) >= GENS_REQUIRED then Farm.doEscape(mapName, "5 gens done") break end

        Farm.updateProgressDisplay(genModels)

        if finished then
            Farm.updateStatus("Gen " .. i .. " complete ✔")
            lastIndex = nil task.wait(1)
        elseif killerNearby then
            Farm.updateStatus("Killer interrupted! Evading...")
            local repairedIdx = Farm.evadeAndWait(genModels, i, mapName)
            killerNearby = false
            if repairedIdx then lastIndex = repairedIdx end
            Farm.updateProgressDisplay(genModels)
        else
            lastIndex = nil task.wait(1)
        end
    end

    if not escaping and Farm.isInLiveRound() then
        local finalDone = Farm.countDone(genModels)
        if finalDone >= GENS_REQUIRED then
            Farm.doEscape(mapName, "all gens done")
        elseif Farm.isLastSurvivor() then
            Farm.doEscape(mapName, "last survivor")
        else
            Farm.updateStatus("Retrying...")
            task.wait(2)
            farmRunning = false
            if autoFarmEnabled then Farm.runFarm() end
            return
        end
    end

    farming = false farmRunning = false
    if autoFarmEnabled then task.spawn(Farm.runFarm) end
end

