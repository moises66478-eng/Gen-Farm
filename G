        local box = Make("TextBox", {
            Name          = "InputBox",
            Size          = UDim2.new(1, 0, 0, 34),
            BackgroundColor3 = Library.Scheme.Input,   -- Issue 15: Input token not MainColor
            BackgroundTransparency = 0.9,
            Text          = opts.Default or "",
            PlaceholderText = opts.Placeholder or "",
            TextColor3    = Library.Scheme.FontColor,
            PlaceholderColor3 = Library.Scheme.SubtextColor,
            TextSize      = 12,
            Font          = Enum.Font.Gotham,   -- safe fallback
            TextXAlignment = Enum.TextXAlignment.Left,
            BorderSizePixel = 0,
            ClearTextOnFocus = false,
        }, wrapper)
        if boxFont then pcall(function() box.FontFace = boxFont end) end
        AddCorner(box, 4)
        local _boxStroke = Make("UIStroke", {
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
            Transparency    = 0.5,
            Color           = Library.Scheme.OutlineColor,
        }, box)
        Library:AddToRegistry(_boxStroke, { Color = "OutlineColor" })
        AddPadding(box, 0, 6, 0, 8)
        Library:AddToRegistry(box, {
            BackgroundColor3  = "Input",
            TextColor3        = "FontColor",
            PlaceholderColor3 = "SubtextColor",
        })

        -- Issue 15: Indicator bar — 1px line at bottom of input box
        local indicator = Make("Frame", {
            Name             = "Indicator",
            Size             = UDim2.new(1, -4, 0, 1),
            Position         = UDim2.new(0, 2, 1, 0),
            AnchorPoint      = Vector2.new(0, 1),
            BackgroundTransparency = 0.5,
            BackgroundColor3 = Library.Scheme.InputIndicator,
            BorderSizePixel  = 0,
        }, box)
        Library:AddToRegistry(indicator, { BackgroundColor3 = "InputIndicator" })

        box.Focused:Connect(function()
            -- Touch-and-hold fix: while GUI movement is unlocked, don't let
            -- a touch on the input box focus it (which would open the
            -- keyboard) — immediately release focus so the touch is free
            -- to be treated as a drag-to-reposition gesture instead.
            if guiDragMode then
                box:ReleaseFocus()
                return
            end
            -- Indicator grows to 2px, accent color, fully opaque
            indicator.Size               = UDim2.new(1, -2, 0, 2)
            indicator.Position           = UDim2.new(0, 1, 1, 0)
            indicator.BackgroundTransparency = 0
            indicator.BackgroundColor3   = Library.Scheme.AccentColor
            box.BackgroundColor3         = Library.Scheme.InputFocused
        end)

        box.FocusLost:Connect(function()
            -- Indicator shrinks back, returns to InputIndicator token
            indicator.Size               = UDim2.new(1, -4, 0, 1)
            indicator.Position           = UDim2.new(0, 2, 1, 0)
            indicator.BackgroundTransparency = 0.5
            indicator.BackgroundColor3   = Library.Scheme.InputIndicator
            box.BackgroundColor3         = Library.Scheme.Input
            SafeCall(callback, box.Text)
        end)

        local iObj = { Value = box.Text, _inst = box }

        -- Keep Value in sync on every Text change (not just FocusLost) so
        -- button callbacks always read the current text. On mobile the
        -- keyboard dismissal fires FocusLost AFTER the button's Activated,
        -- which would leave .Value stale without this connection.
        box:GetPropertyChangedSignal("Text"):Connect(function()
            iObj.Value = box.Text
        end)

        function iObj:SetValue(v) box.Text = v iObj.Value = v end
        function iObj:SetVisible(v) wrapper.Visible = v end
        Library.Options[idx] = iObj
        return iObj
    end

    -- ── AddColorPicker ────────────────────────────────────────────
    -- FIX 1.1: Full color picker popup with RGB sliders, touch-friendly
    function gb:AddColorPicker(idx, opts)
        opts = opts or {}
        local value    = opts.Default or Color3.fromRGB(255, 255, 255)
        local callback = opts.Callback or opts.Changed

        -- Color picker row — fixed 36px height so it never collapses.
        -- AutomaticSize.Y is kept as a bonus but the explicit Size ensures
        -- the row is always visible even on executors that don't fire it.
        local row = Make("Frame", {
            Name             = idx .. "ColorRow",
            Size             = UDim2.new(1, 0, 0, 36),
            BackgroundColor3 = Library.Scheme.MainColor,
            BackgroundTransparency = Library.Scheme.ElementTransparency,
            BorderSizePixel  = 0,
        }, self._content)
        AddCorner(row, 4)
        local _cpStroke = Make("UIStroke", {
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
            Transparency    = 0.5,
            Color           = Library.Scheme.OutlineColor,
        }, row)
        Library:AddToRegistry(_cpStroke, { Color = "OutlineColor" })
        Library:AddToRegistry(row, { BackgroundColor3 = "MainColor" })
        table.insert(Library.ElementRows, row)
        AddPadding(row, 0, 10, 0, 10)

        local colorLabel = Make("TextLabel", {
            Size          = UDim2.new(1, -44, 1, 0),
            BackgroundTransparency = 1,
            Text          = opts.Text or idx,
            TextColor3    = Library.Scheme.FontColor,
            TextSize      = 12,
            Font          = Enum.Font.Gotham,
            TextXAlignment = Enum.TextXAlignment.Left,
            RichText      = true,
        }, row)
        Library:AddToRegistry(colorLabel, { TextColor3 = "FontColor" })
        Library:TrackFont(colorLabel)

        local swatch = Make("TextButton", {
            Size          = UDim2.fromOffset(38, 26),
            Position      = UDim2.new(1, -42, 0.5, -13),
            BackgroundColor3 = value,
            Text          = "",
            BorderSizePixel = 0,
            AutoButtonColor = false,
        }, row)
        AddCorner(swatch, 4)
        -- BUG 7 FIX: use explicit UIStroke with Transparency=0.5
        local _swatchStroke = Make("UIStroke", {
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
            Transparency    = 0.5,
            Color           = Library.Scheme.OutlineColor,
        }, swatch)
        Library:AddToRegistry(_swatchStroke, { Color = "OutlineColor" })

        local cpObj = { Value = value, _swatch = swatch }

        local function openPicker()
            -- Bug 6 fix: no backdrop overlay at all — just the popup itself.
            -- Popup frame (ZIndex 30, centered)
            local popup = Make("Frame", {
                Name             = "CPPopup",
                Size             = UDim2.fromOffset(272, 236),
                Position         = UDim2.new(0.5, -136, 0.5, -118),
                BackgroundColor3 = Library.Scheme.BackgroundColor,
                BorderSizePixel  = 0,
                ZIndex           = 30,
            }, screenGui)
            AddCorner(popup, 8)
            AddStroke(popup, Library.Scheme.OutlineColor, 1)
            -- Drop shadow behind the popup
            local popupShadow = Make("Frame", {
                Name             = "Shadow",
                Size             = UDim2.new(1, 10, 1, 10),
                Position         = UDim2.new(0, -5, 0, 4),
                BackgroundColor3 = Color3.new(0, 0, 0),
                BackgroundTransparency = 0.5,
                BorderSizePixel  = 0,
                ZIndex           = 29,
            }, popup)
            AddCorner(popupShadow, 10)

            -- Persistent input blocker: covers the entire popup area for its
            -- full lifetime. Prevents ALL InputBegan events from reaching the
            -- main UI beneath the picker regardless of whether a slider is
            -- being dragged. ZIndex must be below the popup content (31+)
            -- but above everything else in screenGui.
            local inputBlocker = Make("TextButton", {
                Name             = "CPInputBlocker",
                Size             = UDim2.new(1, 20, 1, 20),
                Position         = UDim2.new(0, -10, 0, -10),
                BackgroundTransparency = 1,
                Text             = "",
                ZIndex           = 30,
                AutoButtonColor  = false,
            }, popup)
            -- Swallow all mouse/touch input — do nothing on click
            inputBlocker.Activated:Connect(function() end)

            local r = math.round(value.R * 255)
            local g = math.round(value.G * 255)
            local b = math.round(value.B * 255)

            local previewFrame = Make("Frame", {
                Size             = UDim2.new(1, -16, 0, 32),
                Position         = UDim2.new(0, 8, 0, 10),
                BackgroundColor3 = Color3.fromRGB(r, g, b),
                BorderSizePixel  = 0,
                ZIndex           = 31,
            }, popup)
            AddCorner(previewFrame, 6)
            AddStroke(previewFrame, Library.Scheme.OutlineColor, 1)

            local function makeRGBSlider(label, initial, yPos)
                Make("TextLabel", {
                    Size          = UDim2.new(0, 18, 0, 20),
                    Position      = UDim2.new(0, 8, 0, yPos),
                    BackgroundTransparency = 1,
                    Text          = label,
                    TextColor3    = Library.Scheme.FontColor,
                    TextSize      = 11,
                    Font          = Enum.Font.GothamSemibold,
                    ZIndex        = 31,
                }, popup)

                local sliderTrack = Make("Frame", {
                    Size          = UDim2.new(1, -70, 0, 10),
                    Position      = UDim2.new(0, 28, 0, yPos + 5),
                    BackgroundColor3 = Color3.fromRGB(35, 35, 35),
                    BorderSizePixel = 0,
                    ZIndex        = 31,
                }, popup)
                AddCorner(sliderTrack, 5, true)

                local sliderFill = Make("Frame", {
                    Size          = UDim2.new(initial/255, 0, 1, 0),
                    BackgroundColor3 = Library.Scheme.AccentColor,
                    BorderSizePixel = 0,
                    ZIndex        = 32,
                }, sliderTrack)
                AddCorner(sliderFill, 5, true)

                local sliderKnob = Make("Frame", {
                    Size          = UDim2.fromOffset(14, 14),
                    AnchorPoint   = Vector2.new(0.5, 0.5),
                    Position      = UDim2.new(initial/255, 0, 0.5, 0),
                    BackgroundColor3 = Color3.new(1,1,1),
                    BorderSizePixel = 0,
                    ZIndex        = 33,
                }, sliderTrack)
                AddCorner(sliderKnob, 7, true)

                local valBox = Make("TextBox", {
                    Size          = UDim2.fromOffset(36, 20),
                    Position      = UDim2.new(1, -44, 0, yPos + 2),
                    BackgroundColor3 = Color3.fromRGB(35, 35, 35),
                    Text          = tostring(initial),
                    TextColor3    = Library.Scheme.FontColor,
                    TextSize      = 11,
                    Font          = Enum.Font.Gotham,
                    TextXAlignment = Enum.TextXAlignment.Center,
                    BorderSizePixel = 0,
                    ClearTextOnFocus = false,
                    ZIndex        = 31,
                }, popup)
                AddCorner(valBox, 4)
                AddStroke(valBox, Library.Scheme.OutlineColor, 1)

                local currentVal = initial
                local draggingSlider = false

                local function applySliderPos(pos)
                    local tp = sliderTrack.AbsolutePosition.X
                    local tw = sliderTrack.AbsoluteSize.X
                    if tw <= 0 then return end
                    local pct = math.clamp((pos.X - tp) / tw, 0, 1)
                    currentVal = math.round(pct * 255)
                    sliderFill.Size = UDim2.new(pct, 0, 1, 0)
                    sliderKnob.Position = UDim2.new(pct, 0, 0.5, 0)
                    valBox.Text = tostring(currentVal)
                end

                -- Touch + mouse drag handling for the slider
                local rgbCapture = nil
                local function destroyRGBCapture()
                    if rgbCapture then rgbCapture:Destroy() rgbCapture = nil end
                end

                sliderTrack.InputBegan:Connect(function(inp)
                    if inp.UserInputType == Enum.UserInputType.MouseButton1
                    or inp.UserInputType == Enum.UserInputType.Touch then
                        draggingSlider = true
                        applySliderPos(inp.Position)
                        rgbCapture = Make("TextButton", {
                            Size = UDim2.fromScale(1, 1),
                            BackgroundTransparency = 1,
                            Text = "",
                            ZIndex = 1000,
                        }, screenGui)
                        rgbCapture.InputChanged:Connect(function(i2)
                            if not draggingSlider then return end
                            if i2.UserInputType == Enum.UserInputType.MouseMovement
                            or i2.UserInputType == Enum.UserInputType.Touch then
                                applySliderPos(i2.Position)
                            end
                        end)
                        rgbCapture.InputEnded:Connect(function(i2)
                            if i2.UserInputType == Enum.UserInputType.MouseButton1
                            or i2.UserInputType == Enum.UserInputType.Touch then
                                draggingSlider = false
                                destroyRGBCapture()
                            end
                        end)
                    end
                end)
                sliderKnob.InputBegan:Connect(function(inp)
                    if inp.UserInputType == Enum.UserInputType.MouseButton1
                    or inp.UserInputType == Enum.UserInputType.Touch then
                        draggingSlider = true
                    end
                end)

                valBox.FocusLost:Connect(function()
                    local n = tonumber(valBox.Text)
                    if n then
                        currentVal = math.clamp(math.round(n), 0, 255)
                        valBox.Text = tostring(currentVal)
                        local pct = currentVal / 255
                        sliderFill.Size = UDim2.new(pct, 0, 1, 0)
                        sliderKnob.Position = UDim2.new(pct, 0, 0.5, 0)
                    end
                end)

                return function() return currentVal end,
                       function(v)
                           currentVal = math.clamp(math.round(v), 0, 255)
                           local pct = currentVal/255
                           sliderFill.Size = UDim2.new(pct, 0, 1, 0)
                           sliderKnob.Position = UDim2.new(pct, 0, 0.5, 0)
                           valBox.Text = tostring(currentVal)
                       end
            end

            local getR, _setR = makeRGBSlider("R", r, 56)
            local getG, _setG = makeRGBSlider("G", g, 88)
            local getB, _setB = makeRGBSlider("B", b, 120)

            -- Live preview while popup is open
            local popupOpen = true
            local previewConn
            previewConn = RunService.Heartbeat:Connect(function()
                if not popupOpen then
                    if previewConn then previewConn:Disconnect() end
                    return
                end
                previewFrame.BackgroundColor3 = Color3.fromRGB(getR(), getG(), getB())
            end)

            local doneBtn = Make("TextButton", {
                Size             = UDim2.new(1, -16, 0, 32),
                Position         = UDim2.new(0, 8, 0, 192),
                BackgroundColor3 = Library.Scheme.AccentColor,
                Text             = "Done",
                TextColor3       = Color3.new(1, 1, 1),
                TextSize         = 12,
                Font             = Enum.Font.GothamSemibold,
                BorderSizePixel  = 0,
                AutoButtonColor  = false,
                ZIndex           = 31,
            }, popup)
            AddCorner(doneBtn, 6)

            local function closePicker()
                popupOpen = false
                local newColor = Color3.fromRGB(getR(), getG(), getB())
                value = newColor
                cpObj.Value = newColor
                swatch.BackgroundColor3 = newColor
                SafeCall(callback, newColor)
                popup:Destroy()
            end

            -- FIX BUG 4 (prior turn) + BUG 6 (this turn): Only the Done
            -- button closes the picker — there is no backdrop to tap
            -- anymore, so this is the sole close path.
            doneBtn.Activated:Connect(closePicker)
        end

        -- FIX 3.6 + FIX 1.1: .Activated opens the popup
        swatch.Activated:Connect(openPicker)

        function cpObj:SetValue(v)
            value = v
            cpObj.Value = v
            swatch.BackgroundColor3 = v
            SafeCall(callback, v)
        end
        function cpObj:SetVisible(v) row.Visible = v end
        Library.Options[idx] = cpObj
        return cpObj
    end

    -- ── AddKeybind ────────────────────────────────────────────────
    function gb:AddKeybind(idx, opts)
        opts = opts or {}
        local current  = opts.Default or Enum.KeyCode.Unknown
        local callback = opts.Callback or opts.Changed
        local listening = false

        -- Issue 9: UIStroke 0.5; Issue 8: AutomaticSize Y row; Issue 16: correct tokens
        local row = Make("Frame", {
            Name             = idx .. "KeybindRow",
            Size             = UDim2.new(1, 0, 0, 0),
            AutomaticSize    = Enum.AutomaticSize.Y,
            BackgroundColor3 = Library.Scheme.MainColor,
            BackgroundTransparency = Library.Scheme.ElementTransparency,
            BorderSizePixel  = 0,
        }, self._content)
        AddCorner(row, 4)
        local _kbStroke = Make("UIStroke", {
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
            Transparency    = 0.5,
            Color           = Library.Scheme.OutlineColor,
        }, row)
        Library:AddToRegistry(_kbStroke, { Color = "OutlineColor" })
        Library:AddToRegistry(row, { BackgroundColor3 = "MainColor" })
        table.insert(Library.ElementRows, row)  -- Issue 21

        -- Issue 12: HoverFrame overlay
        local _kbHover = Make("Frame", {
            Name             = "HoverFrame",
            Size             = UDim2.fromScale(1, 1),
            BackgroundColor3 = Library.Scheme.HoverColor,
            BackgroundTransparency = 1,
            BorderSizePixel  = 0,
        }, row)
        AddCorner(_kbHover, 4)
        Library:AddToRegistry(_kbHover, { BackgroundColor3 = "HoverColor" })
        row.MouseEnter:Connect(function()
            Tween(_kbHover, { BackgroundTransparency = 1 - Library.Scheme.HoverChange })
        end)
        row.MouseLeave:Connect(function()
            Tween(_kbHover, { BackgroundTransparency = 1 })
        end)

        -- Issue 8: LabelHolder structure
        local kbLabelHolder = Make("Frame", {
            Name             = "LabelHolder",
            AutomaticSize    = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1,
            Position         = UDim2.fromOffset(10, 0),
            Size             = UDim2.new(1, -120, 0, 0),
        }, row)
        Make("UIListLayout", {
            SortOrder         = Enum.SortOrder.LayoutOrder,
            VerticalAlignment = Enum.VerticalAlignment.Center,
        }, kbLabelHolder)
        Make("UIPadding", {
            PaddingBottom = UDim.new(0, 13),
            PaddingTop    = UDim.new(0, 13),
        }, kbLabelHolder)

        -- Issue 7: FontFace Medium 13px
        local kbLabelFont = SafeFont(FONT_SSM_PATH, Enum.FontWeight.Medium)
        local kbLabel = Make("TextLabel", {
            Size             = UDim2.new(1, 0, 0, 14),
            BackgroundTransparency = 1,
            Text             = opts.Text or idx,
            TextColor3       = Library.Scheme.FontColor,
            TextSize         = 13,
            Font             = Enum.Font.Gotham,   -- safe fallback
            TextXAlignment   = Enum.TextXAlignment.Left,
            RichText         = true,
            LayoutOrder      = 1,
        }, kbLabelHolder)
        if kbLabelFont then pcall(function() kbLabel.FontFace = kbLabelFont end) end
        Library:AddToRegistry(kbLabel, { TextColor3 = "FontColor" })

        -- Description (if provided)
        if opts.Description and opts.Description ~= "" then
            local kbDescFont = SafeFont(FONT_SSM_PATH, Enum.FontWeight.Regular)
            local kbDesc = Make("TextLabel", {
                Size             = UDim2.new(1, 0, 0, 14),
                AutomaticSize    = Enum.AutomaticSize.Y,
                BackgroundTransparency = 1,
                Text             = opts.Description,
                TextColor3       = Library.Scheme.SubtextColor,
                TextSize         = 12,
                Font             = Enum.Font.Gotham,   -- safe fallback
                TextWrapped      = true,
                TextXAlignment   = Enum.TextXAlignment.Left,
                LayoutOrder      = 2,
            }, kbLabelHolder)
            if kbDescFont then pcall(function() kbDesc.FontFace = kbDescFont end) end
            Library:AddToRegistry(kbDesc, { TextColor3 = "SubtextColor" })
        end

        -- Issue 16: KeybindColor token, not hardcoded RGB(45,45,45)
        local keyBtnFont = SafeFont(FONT_SSM_PATH, Enum.FontWeight.SemiBold)
        local keyBtn = Make("TextButton", {
            Size             = UDim2.fromOffset(90, 28),
            Position         = UDim2.new(1, -100, 0.5, -14),
            BackgroundColor3 = Library.Scheme.KeybindColor,  -- Issue 16
            BackgroundTransparency = 0.9,
            Text             = tostring(current.Name),
            TextColor3       = Library.Scheme.AccentColor,
            TextSize         = 11,
            Font             = Enum.Font.GothamBold,   -- safe fallback
            BorderSizePixel  = 0,
            AutoButtonColor  = false,
        }, row)
        if keyBtnFont then pcall(function() keyBtn.FontFace = keyBtnFont end) end
        AddCorner(keyBtn, 5)
        local _kbBtnStroke = Make("UIStroke", {
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
            Transparency    = 0.5,
            Color           = Library.Scheme.OutlineColor,
        }, keyBtn)
        Library:AddToRegistry(_kbBtnStroke, { Color = "OutlineColor" })
        Library:AddToRegistry(keyBtn, {
            BackgroundColor3 = "KeybindColor",  -- Issue 16: live-binds to token
            TextColor3       = "AccentColor",
        })

        -- FIX 3.6: .Activated to start listening for a key
        keyBtn.Activated:Connect(function()
            listening = true
            keyBtn.Text = "..."
            keyBtn.TextColor3 = Library.Scheme.SubtextColor
        end)

        OnSignal(UserInputService.InputBegan, function(input, gpe)
            if not listening then return end
            if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
            listening = false
            current   = input.KeyCode
            keyBtn.Text = tostring(current.Name)
            keyBtn.TextColor3 = Library.Scheme.AccentColor
            SafeCall(callback, current)
        end)

        local kObj = { Value = current }
        function kObj:SetValue(v) current = v keyBtn.Text = tostring(v.Name) end
        function kObj:SetVisible(v) row.Visible = v end
        Library.Options[idx] = kObj
        return kObj
    end

    return gb
end

