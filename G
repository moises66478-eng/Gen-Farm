-- SAFE FONT HELPER (fixes crash when Font is unavailable)
-- ═══════════════════════════════════════════════════════════════════
local FONT_SSM_PATH = "rbxasset://fonts/families/GothamSSm.json"

local function SafeFont(path, weight, style)
    local ok2, f = pcall(function()
        return Font.new(path, weight or Enum.FontWeight.Regular, style or Enum.FontStyle.Normal)
    end)
    return ok2 and f or nil
end

-- FIX 1.2: Track font elements for live font-face updates
function Library:TrackFont(inst)
    table.insert(self.FontElements, inst)
end

function Library:UpdateFontElements()
    local fontName = self.FontFace or "Gotham"
    local font = Enum.Font[fontName] or Enum.Font.Gotham
    for _, inst in ipairs(self.FontElements) do
        if inst and inst.Parent then
            pcall(function() inst.Font = font end)
        end
    end
end

-- ═══════════════════════════════════════════════════════════════════
-- REGISTRY SYSTEM (Theme color binding)
-- ═══════════════════════════════════════════════════════════════════

-- Forward-declare so UpdateColorsUsingRegistry can reference them
-- even though the implementations come later (after mainFrame exists)
local _transState = false
local _transLevel = 0   -- forward-declared here so UpdateColorsUsingRegistry closes over it
local setGuiTransparency  -- assigned below after mainFrame is built

function Library:AddToRegistry(inst, props)
    table.insert(self.Registry, { Instance = inst, Props = props })
end

function Library:UpdateColorsUsingRegistry()
    for _, entry in ipairs(self.Registry) do
        local inst = entry.Instance
        if not inst or not inst.Parent then continue end
        for prop, schemeKey in pairs(entry.Props) do
            local color = self.Scheme[schemeKey]
            if color then
                pcall(function() inst[prop] = color end)
            end
        end
    end
    -- Re-apply active tab selection state so its TextColor3 stays as FontColor
    -- after a theme change (the registry sets all tabs back to SubtextColor)
    if activeTab then
        pcall(function()
            activeTab.Button.TextColor3 = Library.Scheme.FontColor
            activeTab._bar.BackgroundColor3 = Library.Scheme.AccentColor
        end)
    end
    -- Re-apply acrylic transparency after theme change so it isn't lost.
    if bgImageLabel and bgImageLabel.Visible then
        if acrylicRoot then acrylicRoot.Visible = false end
    elseif bgFrame then
        if acrylicRoot then acrylicRoot.Visible = true end
        local base = _acrylicDOF and 0.45 or 0
        bgFrame.BackgroundTransparency = base + (_transLevel or 0)
    end
end

