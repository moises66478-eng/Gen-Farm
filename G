            ResetOnSpawn   = false,
            ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
            DisplayOrder   = 1000,
            Parent         = playerGui,
        })
    end
    -- Issue 17: width 310px (Fluent exact), positioned bottom-right
    notifyHolder = Make("Frame", {
        Name                  = "NotifyHolder",
        Size                  = UDim2.new(0, 310, 1, -30),  -- Fluent: 310 wide, 30px margin
        BackgroundTransparency = 1,
        BorderSizePixel       = 0,
        AnchorPoint           = Vector2.new(1, 1),
