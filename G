-- PRIVATE SERVER SHARING — backend URL and HTTP helpers
-- Uses executor request() (not HttpService:RequestAsync).
-- ═══════════════════════════════════════════════════════════════════

local PS_BACKEND_URL = "https://dbd-private-server-api.isabelagomez878.workers.dev"

-- Resolve the executor's HTTP function once (supports request / syn.request / http.request)
local _execRequest = (type(request) == "function" and request)
                  or (type(syn) == "table" and type(syn.request) == "function" and syn.request)
                  or (type(http) == "table" and type(http.request) == "function" and http.request)
                  or nil

-- Thin wrapper: returns ok, responseBody (string) or ok=false, errorMessage
local function psRequest(method, endpoint, body)
    if not _execRequest then
        return false, "No HTTP function available (request/syn.request not found)"
    end
    -- Only attach a Body for methods that carry one.
    -- GET requests must never have a body — some executors reject them outright.
    local reqTable = {
        Url     = PS_BACKEND_URL .. endpoint,
        Method  = method,
        Headers = { ["Content-Type"] = "application/json" },
    }
    if body ~= nil then
        local encOk, enc = pcall(function() return HttpService:JSONEncode(body) end)
        if not encOk then return false, "JSON encode failed: " .. tostring(enc) end
        reqTable.Body = enc
    end
    local ok, result = pcall(function()
        return _execRequest(reqTable)
    end)
    if not ok then return false, tostring(result) end
    if type(result) ~= "table" then
        return false, "Executor returned nil or non-table response"
    end
    local statusCode = tonumber(result.StatusCode) or tonumber(result.status) or 200
    if statusCode < 200 or statusCode >= 300 then
        return false, "HTTP " .. tostring(statusCode) .. ": " .. tostring(result.Body or "")
    end
    return true, result.Body or ""
end

-- ═══════════════════════════════════════════════════════════════════
-- JOIN HELPER
--
-- This is the single join path for ALL private server links.
-- It never calls TeleportToPrivateServer — that API requires a
-- reservedServerAccessCode that is only available inside the Roblox
-- engine and cannot be derived from a public share URL or extracted
-- from the HTML of a share page.
--
-- The correct join flow for share links is the roblox:// deep link:
--   roblox://navigation/share_links?code=XXXXX&type=Server
-- Opening this URI hands control to the Roblox client, which handles
-- the full authentication and teleport internally.
--
-- For classic privateServerLinkCode links the same strategy applies:
-- open the link in the browser / Roblox client directly.
--
-- Priority:
--   1. GuiService:OpenBrowserWindow  (most executors support this)
--   2. setclipboard + notify         (universal fallback)
-- ═══════════════════════════════════════════════════════════════════
local GuiService = game:GetService("GuiService")

local function joinPrivateServer(link)
    -- Determine the best URI to open.
    -- Share links → roblox:// deep link (handled natively by Roblox client).
    -- Classic links → open the original URL (browser handles token exchange).
    local uriToOpen = link

    local shareCode = link:match("[?&]code=([A-Za-z0-9_%-]+)")
    if shareCode then
        -- Build the deep link URI. The Roblox client opens this directly
        -- and joins the private server without any server-side resolution.
        uriToOpen = "roblox://navigation/share_links?code=" .. shareCode .. "&type=Server"
    end

    -- Attempt 1: GuiService:OpenBrowserWindow
    -- Works in most executors and opens directly in the Roblox client.
    local opened = false
    pcall(function()
        GuiService:OpenBrowserWindow(uriToOpen)
        opened = true
    end)

    if opened then
        Library:Notify({
            Title   = "Servers",
            Content = "Opening server in Roblox client...",
        }, 3)
        return
    end

    -- Attempt 2: Clipboard fallback — always works, requires one manual step.
    -- Copy the original share URL (not the deep link) so the user can
    -- paste it into any browser and Roblox will handle the rest.
    local copied = false
    pcall(function()
        if type(setclipboard) == "function" then
            setclipboard(link)
            copied = true
        elseif type(toclipboard) == "function" then
            toclipboard(link)
            copied = true
        end
    end)

    if copied then
        Library:Notify({
            Title   = "Servers",
            Content = "Link copied — paste into your browser to join.",
        }, 5)
    else
        Library:Notify({
            Title   = "Servers",
            Content = "Could not open or copy link. Try manually: " .. link,
        }, 6)
        warn("[GenFarm/Join] Link could not be opened or copied: " .. tostring(link))
    end
end

